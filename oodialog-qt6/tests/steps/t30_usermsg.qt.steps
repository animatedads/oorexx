# Qt dialect of oodialog-wasm tests/t30_usermsg.steps (v0.25.0).
wait .ood-dlg >> text=Close
expect stbAll ==> made later
click .ood-dlg >> text=Command
wait .ood-dlg >> text=command 40 0 1
click .ood-dlg >> text=Send
wait .ood-dlg >> text=send done
click .ood-dlg >> text=Click me
wait .ood-dlg >> text=static click 42 1
click .ood-dlg >> text=Two
wait .ood-dlg >> text=stem button 51
click .ood-ud button:first-child
sleep 400
expect value .ood-dlg input >> nth=1 ==> 10
click .ood-ud button:last-child
sleep 400
expect value .ood-dlg input >> nth=1 ==> 10
click .ood-ud button:first-child
sleep 400
expect value .ood-dlg input >> nth=1 ==> 11
click .ood-dlg input >> nth=0
sleep 300
click .ood-dlg input >> nth=1
wait .ood-dlg >> text=lost focus 43
click .ood-dlg >> text=Close
