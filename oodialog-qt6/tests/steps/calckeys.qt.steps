# Qt dialect of oodialog-wasm tests/demo/calckeys.steps (v0.19.1): the same keys; focus and value read from Qt.
wait .ood-dlg >> text=Sqrt
expect hasFocus .ood-dlg input ==> True
type 44
sleep 400
expect value .ood-dlg input ==> 44
press Shift+Equal
type 6
press Enter
sleep 400
expect value .ood-dlg input ==> 50
press Slash
type 4
press Equal
sleep 400
expect value .ood-dlg input ==> 12.5
press Shift+8
type 2
press Enter
sleep 400
expect value .ood-dlg input ==> 25.0
press Backspace
press Backspace
sleep 400
expect value .ood-dlg input ==> 25
press Minus
type 5
press NumpadAdd
type 1
press Period
type 5
press Enter
sleep 400
expect value .ood-dlg input ==> 21.5
press Delete
sleep 400
expect value .ood-dlg input ==> 0
click .ood-dlg >> text=Sqrt
type 9
click .ood-dlg >> text=Exit
