+# rx2cpp threading v0.1: GUARDED/UNGUARDED on compiled methods + per-scope memory-safety lock
+set -euo pipefail
+ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
+OO_ROOT=${OO_ROOT:?}; REXX_BIN=${REXX_BIN:-$OO_ROOT/bin/rexx}; CXX=${CXX:-g++}
