/* Generate an ooRexx-loadable native package (.so) from a parsed ooRexx
   ::CLASS. The native extension publishes a real ooRexx class on load.
   No foreign runtime, registry, proxy token, or interpreter-host process.
   This first backend only accepts the already-qualified scalar class subset. */
::class RxNativePackageEmitter public
::method emit
  use arg unit, libraryName
  className = unit~className
  if verify(className, 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_') \= 0 then
    raise syntax 40.1 array('rx2cpp: unsafe class identifier for native package')
  if verify(libraryName, 'abcdefghijklmnopqrstuvwxyz0123456789_') \= 0 then
    raise syntax 40.1 array('rx2cpp: unsafe native library identifier')
  lines = .array~new
  lines~append('// rx2cpp native ooRexx library, generated by ooRexx compiler.')
  lines~append('#include <oorexxapi.h>')
  lines~append('#include <oorexxerrors.h>')
  lines~append('#include "minirexx_runtime.hpp"')
  lines~append('#include <stdexcept>')
  lines~append('#include <string>')
  lines~append('namespace {')
  lines~append('rx::Value readScalar(RexxMethodContext* context, RexxObjectPtr raw) {')
  lines~append('  if (raw == NULLOBJECT || !context->IsOfType(raw, "String"))')
  lines~append('    throw std::runtime_error("native method requires a string value");')
  lines~append('  const auto s = context->ObjectToString(raw);')
  lines~append('  return rx::Value::string(std::string(context->StringData(s), context->StringLength(s)));')
  lines~append('}')
  lines~append('RexxObjectPtr writeScalar(RexxMethodContext* context, const std::string& value) {')
  lines~append('  return context->NewString(value.data(), value.size());')
  lines~append('}')
  lines~append('RexxObjectPtr methodError(RexxMethodContext* context, const std::exception& e) {')
  lines~append('  context->RaiseException1(Rexx_Error_Incorrect_method_user_defined, context->String(e.what()));')
  lines~append('  return NULLOBJECT;')
  lines~append('}')
  lines~append('}')
  count = 0
  definitions = .array~new
  entries = .array~new
  do method over unit~methods
    count = count + 1
    selector = method~selector
    if verify(selector, 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_') \= 0 then
      raise syntax 40.1 array('rx2cpp: unsafe method selector for native package')
    cfunc = 'RX2CPP_METHOD_' || count
    definitions~append('::method ' || selector~lower || " external 'LIBRARY " || libraryName || ' ' || cfunc || "'")
    entries~append('  REXX_METHOD(' || cfunc || ', ' || cfunc || '),')
    lines~append('RexxMethod1(RexxObjectPtr, ' || cfunc || ', ARGLIST, args) {')
    lines~append('  try {')
    lines~append('    rx::Variables fields_;')
    do field over method~exposed
      cfield = .RxQuote~cpp(field)
      lines~append('    { const auto value = context->GetObjectVariable(' || cfield || ');')
      lines~append('      if (value != NULLOBJECT) rx::set(fields_, ' || cfield || ', readScalar(context, value)); }')
    end
    lines~append('    const std::string returnValue = [&]() -> std::string {')
    lines~append('      rx::Variables vars;')
    do field over method~exposed
      cfield = .RxQuote~cpp(field)
      lines~append('      rx::set(vars, ' || cfield || ', rx::get(fields_, ' || cfield || '));')
    end
    do position = 1 to method~parameters~items
      cparam = .RxQuote~cpp(method~parameters[position])
      lines~append('      { RexxObjectPtr item = context->ArrayAt(args, ' || position || ');')
      lines~append('        if (item != NULLOBJECT) rx::set(vars, ' || cparam || ', readScalar(context, item)); }')
      if method~exposed~hasItem(method~parameters[position]) then
        lines~append('      rx::set(fields_, ' || cparam || ', rx::get(vars, ' || cparam || '));')
    end
    do statement over method~instructions
      lines~append('      ' || statement)
    end
    if selector == 'INIT' then lines~append('      return "";')
    lines~append('    }();')
    do field over method~exposed
      cfield = .RxQuote~cpp(field)
      lines~append('    { const auto value = rx::get(fields_, ' || cfield || ');')
      lines~append('      if (value.isObject()) throw std::runtime_error("native field requires interpreter-backed object");')
      lines~append('      context->SetObjectVariable(' || cfield || ', writeScalar(context, value.bytes)); }')
    end
    if selector == 'INIT' then lines~append('    return NULLOBJECT;')
    else lines~append('    return writeScalar(context, returnValue);')
    lines~append('  } catch (const std::exception& e) { return methodError(context, e); }')
    lines~append('}')
  end
  lines~append('static RexxMethodEntry nativeMethods[] = {')
  do entry over entries
    lines~append(entry)
  end
  lines~append('  REXX_LAST_METHOD()')
  lines~append('};')
  lines~append('static void RexxEntry onLoad(RexxThreadContext* context) {')
  lines~append('  static const char source[] =')
  lines~append('    "::class ' || className || ' public\n"')
  do definition over definitions
    lines~append('    "' || definition || '\n"')
  end
  lines~append('    ;')
  lines~append('  auto package = context->LoadPackageFromData("rx2cpp_' || className || '_native.cls", source, sizeof(source) - 1);')
  lines~append('  if (package == NULLOBJECT || context->CheckCondition()) return;')
  lines~append('  auto type = context->FindPackageClass(package, ' || .RxQuote~cpp(className) || ');')
  lines~append('  if (type == NULLOBJECT || context->CheckCondition()) return;')
  lines~append('  auto environment = context->GetGlobalEnvironment();')
  lines~append('  if (context->DirectoryAt(environment, ' || .RxQuote~cpp(className) || ') != NULLOBJECT) {')
  lines~append('    context->RaiseException1(Rexx_Error_Incorrect_method_user_defined, context->String("compiled class name already registered"));')
  lines~append('    return;')
  lines~append('  }')
  lines~append('  context->DirectoryPut(environment, type, ' || .RxQuote~cpp(className) || ');')
  lines~append('}')
  lines~append('RexxPackageEntry RX2CPP_PACKAGE_package_entry = {')
  lines~append('  STANDARD_PACKAGE_HEADER')
  lines~append('  REXX_CURRENT_INTERPRETER_VERSION,')
  lines~append('  ' || .RxQuote~cpp(libraryName) || ', "0.14.0-dev1",')
  lines~append('  onLoad, nullptr, nullptr, nativeMethods')
  lines~append('};')
  lines~append('OOREXX_GET_PACKAGE(RX2CPP_PACKAGE);')
  out = ''
  do line over lines
    out = out || line || '0a'x
  end
  return out
::requires 'core/RxQuote.cls'
