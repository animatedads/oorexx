namespace rx2cpp {
Registry &Registry::instance() { static Registry registry; return registry; }
std::string Registry::add(std::shared_ptr<CompiledObject> obj) {
    if (!obj) throw std::invalid_argument("null compiled object");
    std::lock_guard<std::mutex> lock(gate_);
    auto token = std::string("instance-") + std::to_string(++next_);
    objects_.emplace(token, std::move(obj));
    return token;
}
void Registry::remove(const std::string &token) {
    std::lock_guard<std::mutex> lock(gate_);
    objects_.erase(token);
}
std::shared_ptr<CompiledObject> Registry::find(const std::string &token) {
    std::lock_guard<std::mutex> lock(gate_);
    const auto it = objects_.find(token);
    return it == objects_.end() ? nullptr : it->second;
}
static std::string stringValue(RexxMethodContext *ctx, RexxObjectPtr object) {
    if (object == NULLOBJECT || !(ctx->IsString(object) || ctx->IsOfType(object, "STRING")))
        throw std::runtime_error("only ooRexx String scalar values are supported");
    auto s = ctx->ObjectToString(object);
    std::string out(ctx->StringData(s), ctx->StringLength(s));
    if ((RexxObjectPtr)s != object) ctx->ReleaseLocalReference((RexxObjectPtr)s);
    return out;
}
// A SYNTAX condition raised by compiled code (RAISE SYNTAX n.m ARRAY/ADDITIONAL, or a runtime error with a code)
// becomes the same interpreter condition, so CONDITION('O') and the error message are the interpreter's own.
static void raiseSyntaxIn(RexxThreadContext *t, const rx::SyntaxCondition &e) {
    const std::string &c = e.code;
    const auto dot = c.find('.');
    const bool numeric = !c.empty() && c.find_first_not_of("0123456789.") == std::string::npos && dot != std::string::npos;
    if (!numeric || e.substitutions.empty()) {
        t->RaiseException1(Rexx_Error_Execution_user_defined, t->String(e.what()));
        return;
    }
    const size_t number = std::stoul(c.substr(0, dot)) * 1000 + std::stoul(c.substr(dot + 1));
    RexxArrayObject subs = t->NewArray(e.substitutions.size());
    for (size_t i = 0; i < e.substitutions.size(); ++i) {
        const rx::Value &v = e.substitutions[i];
#ifdef RX2CPP_HOST_API
        if (v.isObject()) {
            if (auto *env = dynamic_cast<rx::EnvObject *>(v.object.get())) { t->ArrayPut(subs, (RexxObjectPtr)env->handle, i + 1); continue; }
        }
#endif
        const std::string text = v.isObject() ? v.object->display() : v.bytes.str();
        t->ArrayPut(subs, t->NewString(text.data(), text.size()), i + 1);
    }
    t->RaiseException(number, subs);
}
static void report(RexxMethodContext *ctx, const char *message) {
    ctx->RaiseException1(Rexx_Error_Execution_user_defined, ctx->String(message));
}
static std::shared_ptr<CompiledObject> create(const std::string &className) {
%FACTORY_DISPATCH%
    throw std::runtime_error("unsupported native class: " + className);
}
/* The interpreter already holds a condition for this activity (for example the
   callee raised an error). Return to ooRexx without raising a second one. */
struct PendingCondition : std::runtime_error {
    PendingCondition() : std::runtime_error("ooRexx condition pending") {}
};
struct MethodInfo { const char *definingClass; bool isPublic; bool noResult; };
/* Selector and class names are case-insensitive in ooRexx; the tables hold the upper-case spelling and are searched without
   making an upper-case copy of the incoming name. */
struct CiHash {
    std::size_t operator()(const std::string &s) const {
        std::size_t h = 1469598103934665603ULL;
        for (unsigned char c : s) { h ^= (unsigned char)std::toupper(c); h *= 1099511628211ULL; }
        return h;
    }
};
struct CiEq {
    bool operator()(const std::string &a, const std::string &b) const {
        if (a.size() != b.size()) return false;
        for (std::size_t i = 0; i < a.size(); i++)
            if (std::toupper((unsigned char)a[i]) != std::toupper((unsigned char)b[i])) return false;
        return true;
    }
};
typedef std::unordered_map<std::string, MethodInfo, CiHash, CiEq> MethodTable;
typedef std::unordered_map<std::string, MethodTable, CiHash, CiEq> ClassMethodTable;
%DIRECT_TABLES%
[[maybe_unused]] static std::string upperOf(std::string s) {
    for (char &c : s) c = static_cast<char>(std::toupper(static_cast<unsigned char>(c)));
    return s;
}
/* Dual representation: one native instance = one InstanceState. The state owns the compiled per-class scopes. It is
   reachable from compiled code directly (NativeInstanceRef) and, once an interpreter object exists for it, through the
   token stored in that object. */
struct InstanceState : std::enable_shared_from_this<InstanceState> {
    std::string dynamicClass;        // the class the instance was created from (upper case)
    bool exact = false;              // the dynamic class is a class of this package, so direct dispatch is faithful
    std::mutex gate;
    void *handle = nullptr;          // interpreter object, valid while alive
    bool alive = false;
    std::string token;
    std::vector<std::pair<std::string, std::shared_ptr<CompiledObject>>> scopes;   // instances have a handful of scopes: a scan beats hashing
    std::shared_ptr<CompiledObject> at(const std::string &cls) {
        std::lock_guard<std::mutex> lock(gate);
        for (const auto &entry : scopes) if (entry.first == cls) return entry.second;
        auto created = create(cls);
        scopes.emplace_back(cls, created);
        return created;
    }
};
class InstanceTable {
    std::mutex gate_;
    std::unordered_map<std::string, std::shared_ptr<InstanceState>> states_;
    unsigned long long next_ = 0;
public:
    static InstanceTable &instance() { static InstanceTable table; return table; }
    std::string add(const std::shared_ptr<InstanceState> &state) {
        std::lock_guard<std::mutex> lock(gate_);
        auto token = std::string("instance-") + std::to_string(++next_);
        states_.emplace(token, state);
        return token;
    }
    std::shared_ptr<InstanceState> find(const std::string &token) {
        std::lock_guard<std::mutex> lock(gate_);
        auto it = states_.find(token);
        return it == states_.end() ? nullptr : it->second;
    }
    void remove(const std::string &token) {
        std::lock_guard<std::mutex> lock(gate_);
        states_.erase(token);
    }
    // Interpreter object -> its native state (exact compiled instances only), so an object the interpreter hands back
    // to compiled code runs its compiled methods directly.
    void bind(void *handle, const std::shared_ptr<InstanceState> &state) {
        if (!handle) return;
        std::lock_guard<std::mutex> lock(gate_);
        byHandle_[handle] = state;
    }
    void unbind(void *handle) {
        if (!handle) return;
        std::lock_guard<std::mutex> lock(gate_);
        byHandle_.erase(handle);
    }
    std::shared_ptr<InstanceState> byHandle(void *handle) {
        std::lock_guard<std::mutex> lock(gate_);
        auto it = byHandle_.find(handle);
        return it == byHandle_.end() ? nullptr : it->second.lock();
    }
private:
    std::unordered_map<void *, std::weak_ptr<InstanceState>> byHandle_;
};
namespace {
struct ReleaseAndReacquire {
    ScopeLock &lock; unsigned depth;
    explicit ReleaseAndReacquire(ScopeLock &l) : lock(l), depth(l.release_all()) {}
    ~ReleaseAndReacquire() { lock.reacquire(depth); }
};
}
#ifdef RX2CPP_HOST_API
namespace {
thread_local InstanceState *currentState = nullptr;           // exact instance whose compiled method is running
thread_local std::shared_ptr<InstanceState> pendingAdopt;      // set while an interpreter object is made for a native state
struct StateScope {
    InstanceState *previous;
    explicit StateScope(InstanceState *s) : previous(currentState) { currentState = s; }
    ~StateScope() { currentState = previous; }
};
std::optional<rx::Value> optionalOf(const rx::Value &v) {
    if (v.isObject()) {
        auto *e = dynamic_cast<rx::EnvObject *>(v.object.get());
        if (e && !e->handle) return std::nullopt;       // an omitted argument slot
    }
    return v;
}
std::vector<std::optional<rx::Value>> optionalsOf(const std::vector<rx::Value> &args) {
    std::vector<std::optional<rx::Value>> out;
    out.reserve(args.size());
    for (const auto &a : args) out.push_back(optionalOf(a));
    return out;
}
/* The table entry for (class, selector): first = the canonical upper-case selector, second = how to dispatch it. */
typedef const MethodTable::value_type Resolved;
Resolved *lookupMethod(const std::string &cls, const std::string &selector) {
    const auto &all = directMethodTable();
    auto it = all.find(cls);
    if (it == all.end()) return nullptr;
    auto jt = it->second.find(selector);
    return jt == it->second.end() ? nullptr : &*jt;
}
/* An interpreter object for a native state: a new instance of the class whose first INIT adopts the state. */
void *materializeState(const std::shared_ptr<InstanceState> &st) {
    if (st->alive && st->handle) return st->handle;
    void *cls = rxobj::findClass(st->dynamicClass);
    if (!cls) throw std::runtime_error("native class is not registered: " + st->dynamicClass);
    pendingAdopt = st;
    std::vector<rxobj::Arg> none; rxobj::Result r; std::string code, text;
    const bool ok = rxobj::send(cls, "NEW", none, r, code, text);
    pendingAdopt.reset();
    rxobj::release(cls);
    if (!ok) throw rx::SyntaxCondition(code, text, false);
    if (r.kind == 2) rxobj::release(r.obj);
    if (!st->alive) throw std::runtime_error("cannot create the interpreter object for a native instance");
    return st->handle;
}
std::optional<rx::Value> interpreterSend(const std::shared_ptr<InstanceState> &st, const std::string &selector,
                                         const std::vector<rx::Value> &args) {
    void *h = materializeState(st);
    std::vector<rxobj::Arg> in; rx::EnvObject::convert(args, in);
    rxobj::Result r; std::string code, text;
    if (!rxobj::send(h, selector, in, r, code, text)) {
        if (code == "97.1") throw rx::NoMethod(text);
        throw rx::SyntaxCondition(code, text, false);
    }
    if (r.kind == 0) return std::nullopt;
    return rx::EnvObject::wrap(r);
}
std::optional<rx::Value> runNative(const std::shared_ptr<InstanceState> &st, Resolved &method,
                                   const std::vector<std::optional<rx::Value>> &args);
/* SELF~selector(args) from compiled code in an exact instance: dispatch inside the library when the method is compiled. */
bool nativeSelfSend(const std::shared_ptr<InstanceState> &st, const std::string &definingClass, const std::string &selector,
                    const std::vector<rx::Value> &args, std::optional<rx::Value> &out) {
    static const CiEq same;
    if (same(selector, "RX2CPP_SUPERA")) return false;
    if (same(selector, "RX2CPP_SUPER")) {
        if (args.empty() || args[0].isObject()) return false;
        const auto &parents = parentTable();
        auto pit = parents.find(definingClass);
        if (pit == parents.end() || pit->second.empty()) return false;
        Resolved *method = lookupMethod(pit->second, args[0].bytes);
        if (!method) return false;
        std::vector<std::optional<rx::Value>> rest;
        for (std::size_t i = 1; i < args.size(); i++) rest.push_back(optionalOf(args[i]));
        out = runNative(st, *method, rest);
        return true;
    }
    Resolved *method = lookupMethod(st->dynamicClass, selector);
    if (!method) return false;
    out = runNative(st, *method, optionalsOf(args));
    return true;
}
/* ooRexx RexxObject::checkPrivate: a private method runs when the sender is the receiver itself, or an instance of the
   class that defined the method (its scope). The sender here is the instance whose compiled method is running on this
   thread; anything else (a class-side or interpreter sender) is left to the interpreter's own check. */
static bool instanceOfScope(const std::string &cls, const char *scope) {
    static const CiEq same;
    const auto &parents = parentTable();
    std::string c = cls;
    for (int guard = 0; guard < 64 && !c.empty(); guard++) {
        if (same(c, scope)) return true;
        auto it = parents.find(c);
        if (it == parents.end()) return false;
        c = it->second;
    }
    return false;
}
static bool privateAllowedFor(const InstanceState *receiver, const MethodInfo &info) {
    if (!currentState) return false;
    if (currentState == receiver) return true;
    return instanceOfScope(currentState->dynamicClass, info.definingClass);
}
class NativeInstanceRef final : public rx::NativeRefBase {
    std::shared_ptr<InstanceState> st_;
    std::shared_ptr<rx::EnvObject> keep_;   // adopted from the interpreter: holds its global reference (no early UNINIT)
public:
    explicit NativeInstanceRef(std::shared_ptr<InstanceState> st, std::shared_ptr<rx::EnvObject> keep = nullptr)
        : st_(std::move(st)), keep_(std::move(keep)) {}
    void *materialize() override { return materializeState(st_); }
    rx::MessageResult sendMessage(const std::string &selector, const std::vector<rx::Value> &args) override {
        if (Resolved *method = lookupMethod(st_->dynamicClass, selector))
            if (method->second.isPublic || privateAllowedFor(st_.get(), method->second)) return runNative(st_, *method, optionalsOf(args));
        return interpreterSend(st_, selector, args);
    }
    rx::Value sendBinary(const std::string &selector, const rx::Value &rhs) override {
        auto r = sendMessage(selector, {rhs});
        if (!r) throw std::runtime_error("operator message returned no value: " + selector);
        return *r;
    }
    rx::Value sendUnary(const std::string &selector) override {
        auto r = sendMessage(selector, {});
        if (!r) throw std::runtime_error("operator message returned no value: " + selector);
        return *r;
    }
    std::string display() const override {
        auto r = const_cast<NativeInstanceRef *>(this)->sendMessage("STRING", {});
        if (!r || r->isObject()) throw std::runtime_error("object has no string value");
        return r->bytes;
    }
};
class NativeFrame final : public SelfSender {
    std::shared_ptr<InstanceState> st_; std::string definingClass_;
    const std::vector<std::optional<rx::Value>> &args_; SelfSender *previous_;
public:
    NativeFrame(std::shared_ptr<InstanceState> st, std::string cls, const std::vector<std::optional<rx::Value>> &args)
        : st_(std::move(st)), definingClass_(std::move(cls)), args_(args), previous_(detail::currentSender) { detail::currentSender = this; }
    ~NativeFrame() override { detail::currentSender = previous_; }
    std::optional<rx::Value> sendValues(const std::string &selector, const std::vector<rx::Value> &args) override {
        std::optional<rx::Value> out;
        if (nativeSelfSend(st_, definingClass_, selector, args, out)) return out;
        return interpreterSend(st_, selector, args);
    }
    std::string send(const std::string &selector, const std::vector<std::string> &args) override {
        std::vector<rx::Value> values;
        for (const auto &a : args) values.push_back(rx::Value::string(a));
        auto r = sendValues(selector, values);
        if (!r) throw std::runtime_error("SELF~" + selector + " returned no value");
        if (r->isObject()) return r->object->display();
        return r->bytes;
    }
    std::optional<rx::Value> forwardValues(const std::string &selector) override {
        std::vector<rx::Value> values;
        for (const auto &a : args_) values.push_back(a ? *a : rx::omittedArgument());
        return sendValues(selector, values);
    }
    std::string forward(const std::string &selector) override {
        std::vector<rx::Value> values;
        for (const auto &a : args_) values.push_back(a ? *a : rx::omittedArgument());
        auto r = sendValues(selector, values);
        if (!r) throw std::runtime_error("FORWARD returned no scalar result");
        if (r->isObject()) return r->object->display();
        return r->bytes;
    }
};
std::optional<rx::Value> runNative(const std::shared_ptr<InstanceState> &st, Resolved &method,
                                   const std::vector<std::optional<rx::Value>> &args) {
    const MethodInfo &info = method.second;
    auto obj = st->at(info.definingClass);
    std::lock_guard<ScopeLock> hold(obj->scope_lock);
    NativeFrame frame(st, info.definingClass, args);
    StateScope current(st.get());
    rx::Value result = obj->invokeValues(method.first, args);
    if (info.noResult) return std::nullopt;
    return result;
}
class NativeClassObj final : public rx::NativeRefBase {
    std::string name_;
    std::shared_ptr<rx::EnvObject> interpreterClass_;
    rx::EnvObject &iclass() {
        if (!interpreterClass_) {
            void *h = rxobj::findClass(name_);
            if (!h) throw std::runtime_error("unknown class ." + name_);
            interpreterClass_ = std::make_shared<rx::EnvObject>(h);
        }
        return *interpreterClass_;
    }
public:
    explicit NativeClassObj(std::string n) : name_(std::move(n)) {}
    // As an argument to an interpreter message (x~isA(.Cls)) the class is the interpreter's class object.
    void *materialize() override { return iclass().handle; }
    rx::MessageResult sendMessage(const std::string &selector, const std::vector<rx::Value> &args) override {
        static const CiEq same;
        if (same(selector, "NEW")) {
            auto st = std::make_shared<InstanceState>();
            st->dynamicClass = name_;
            st->exact = true;
            Resolved *init = lookupMethod(name_, "INIT");
            if (!init) throw std::runtime_error("native class without INIT: " + name_);
            runNative(st, *init, optionalsOf(args));
            return rx::Value::fromObject(std::make_shared<NativeInstanceRef>(st));
        }
        return iclass().sendMessage(selector, args);
    }
    rx::Value sendBinary(const std::string &selector, const rx::Value &rhs) override { return iclass().sendBinary(selector, rhs); }
    rx::Value sendUnary(const std::string &selector) override { return iclass().sendUnary(selector); }
    std::string display() const override { return const_cast<NativeClassObj *>(this)->iclass().display(); }
};
std::optional<rx::Value> packageClassImpl(const std::string &name) {
    const std::string up = upperOf(name);
    if (!directNewTable().count(up)) return std::nullopt;
    return rx::Value::fromObject(std::make_shared<NativeClassObj>(up));
}
std::optional<rx::Value> adoptImpl(void *globalRef) {
    auto st = InstanceTable::instance().byHandle(globalRef);
    if (!st || !st->alive || !st->exact || st->handle != globalRef) return std::nullopt;
    return rx::Value::fromObject(std::make_shared<NativeInstanceRef>(st, std::make_shared<rx::EnvObject>(globalRef)));
}
std::optional<rx::Value> selfObjectImpl() {
    if (!currentState) return std::nullopt;
    return rx::Value::fromObject(std::make_shared<NativeInstanceRef>(currentState->shared_from_this()));
}
std::string dynamicClassOf(RexxMethodContext *ctx, RexxObjectPtr self) {
    RexxObjectPtr cls = ctx->SendMessage0(self, "CLASS");
    RexxObjectPtr id = cls == NULLOBJECT ? NULLOBJECT : ctx->SendMessage0(cls, "ID");
    if (id == NULLOBJECT) return std::string();
    return upperOf(ctx->ObjectToStringValue(id));
}
[[maybe_unused]] const bool hooksInstalled = (rx::packageClassHook = &packageClassImpl, rx::selfObjectHook = &selfObjectImpl,
                                              rx::adoptHook = &adoptImpl, true);
}
#endif
namespace {
class Frame final : public SelfSender {
    RexxMethodContext *ctx_; RexxObjectPtr self_; ScopeLock &lock_; SelfSender *previous_;
    std::shared_ptr<InstanceState> state_; std::string className_;
public:
    Frame(RexxMethodContext *c, RexxObjectPtr s, ScopeLock &l, std::shared_ptr<InstanceState> st, std::string cls)
        : ctx_(c), self_(s), lock_(l), previous_(detail::currentSender), state_(std::move(st)), className_(std::move(cls)) { detail::currentSender = this; }
    ~Frame() override { detail::currentSender = previous_; }
    std::string forward(const std::string &selector) override {
        RexxObjectPtr result;
        { ReleaseAndReacquire released(lock_);
          result = ctx_->ForwardMessage(self_, selector.c_str(), NULLOBJECT, ctx_->GetArguments()); }
        if (ctx_->CheckCondition()) throw PendingCondition();
        if (result == NULLOBJECT)
            throw std::runtime_error("FORWARD returned no scalar result");
        return stringValue(ctx_, result);
    }
#ifdef RX2CPP_HOST_API
    std::optional<rx::Value> forwardValues(const std::string &selector) override {
        RexxObjectPtr result;
        { ReleaseAndReacquire released(lock_);
          result = ctx_->ForwardMessage(self_, selector.c_str(), NULLOBJECT, ctx_->GetArguments()); }
        if (ctx_->CheckCondition()) throw PendingCondition();
        if (result == NULLOBJECT) return std::nullopt;
        if (rxobj::isPlainString(ctx_->threadContext, result)) return rx::Value::string(stringValue(ctx_, result));
        return rx::EnvObject::adopt((void *)ctx_->threadContext->RequestGlobalReference(result));
    }
    std::optional<rx::Value> sendValues(const std::string &selector, const std::vector<rx::Value> &args) override {
        if (state_ && state_->exact) {
            std::optional<rx::Value> out;
            if (nativeSelfSend(state_, className_, selector, args, out)) return out;
        }
        std::vector<rxobj::Arg> in; rx::EnvObject::convert(args, in);
        // A self send can run many times inside one native call: release every local reference it makes.
        rxobj::LocalRefs temps(ctx_->threadContext);
        RexxArrayObject arr = (RexxArrayObject)temps((RexxObjectPtr)ctx_->NewArray(in.size()));
        for (std::size_t i = 0; i < in.size(); i++) {
            if (in[i].omitted) continue;
            ctx_->ArrayPut(arr, in[i].obj ? (RexxObjectPtr)in[i].obj : temps((RexxObjectPtr)ctx_->NewString(in[i].bytes.data(), in[i].bytes.size())), i + 1);
        }
        RexxObjectPtr result;
        { ReleaseAndReacquire released(lock_); result = ctx_->SendMessage(self_, selector.c_str(), arr); }
        if (ctx_->CheckCondition()) throw PendingCondition();
        if (result == NULLOBJECT) return std::nullopt;
        temps(result);
        if (rxobj::isPlainString(ctx_->threadContext, result)) return rx::Value::string(stringValue(ctx_, result));
        return rx::EnvObject::adopt((void *)ctx_->threadContext->RequestGlobalReference(result));
    }
#endif
    std::string send(const std::string &selector, const std::vector<std::string> &args) override {
        RexxArrayObject arr = ctx_->NewArray(args.size());
        for (const auto &a : args) ctx_->ArrayAppendString(arr, a.data(), a.size());
        RexxObjectPtr result;
        { ReleaseAndReacquire released(lock_); result = ctx_->SendMessage(self_, selector.c_str(), arr); }
        if (ctx_->CheckCondition()) throw PendingCondition();
        if (result == NULLOBJECT) throw std::runtime_error("SELF~" + selector + " returned no value");
        return stringValue(ctx_, result);
    }
};
}
static RexxObjectPtr call(RexxMethodContext *ctx, RexxArrayObject args, RexxObjectPtr selfObj,
                          const std::string &className, const std::string &selector,
                          bool initializer, bool attributeSetter, int scopeIndex, bool isRoot, const std::string &rootClass, bool classSide) {
    (void)scopeIndex;
    std::string failedInitToken;   // an INIT that throws must not leave its object registered
    try {
#ifdef RX2CPP_HOST_API
        rxobj::Scope hostScope(ctx->threadContext, selfObj);
#endif
        const size_t count = ctx->ArraySize(args);
        std::shared_ptr<InstanceState> state;
        std::string token;
        auto setRootToken = [&](const std::string &value) {
            if (isRoot) { ctx->SetObjectVariable("RX2CPP_NATIVE_ID", ctx->String(value.c_str())); return; }
            auto definingRoot = ctx->FindClass(rootClass.c_str());
            if (definingRoot == NULLOBJECT) throw std::runtime_error("compiled superclass missing: " + rootClass);
            RexxArrayObject tokenArgs = ctx->NewArray(1);
            ctx->ArrayAppend(tokenArgs, ctx->String(value.c_str()));
            ctx->ForwardMessage(ctx->GetSelf(), "RX2CPP_NATIVE_SETTOKEN", definingRoot, tokenArgs);
            if (ctx->CheckCondition()) throw PendingCondition();
        };
        if (initializer) {
#ifdef RX2CPP_HOST_API
            if (pendingAdopt) {
                // An interpreter object is being made for a native state: adopt it; the INIT body already ran natively.
                state = std::move(pendingAdopt);
                pendingAdopt.reset();
                token = InstanceTable::instance().add(state);
                failedInitToken = token;
                state->token = token;
                state->handle = (void *)selfObj;
                state->alive = true;
                if (!classSide) InstanceTable::instance().bind(state->handle, state);
                setRootToken(token);
                failedInitToken.clear();
                return NULLOBJECT;
            }
#endif
            RexxObjectPtr existing = ctx->GetObjectVariable("RX2CPP_NATIVE_ID");
            if (!isRoot) {
                // A derived INIT starts the object: the state is created (the root scope's own INIT runs only if this INIT
                // sends INIT:SUPER, exactly as in the interpreter), then this class's scope runs the body. Object variables
                // are per class scope, so the token is read and written through the root class's own accessors.
                auto definingRoot = ctx->FindClass(rootClass.c_str());
                if (definingRoot == NULLOBJECT) throw std::runtime_error("compiled superclass missing: " + rootClass);
                RexxObjectPtr rootToken = ctx->ForwardMessage(ctx->GetSelf(), "RX2CPP_NATIVE_TOKEN", definingRoot, ctx->NewArray(0));
                if (ctx->CheckCondition()) throw PendingCondition();
                if (rootToken != NULLOBJECT) throw std::runtime_error("native object already initialized");
            } else if (existing != NULLOBJECT) {
                // INIT:SUPER from a derived INIT: the state was registered by the derived class.
                token = stringValue(ctx, existing);
                state = InstanceTable::instance().find(token);
                if (!state) throw std::runtime_error("expired native object handle");
            }
            if (!state) {
                state = std::make_shared<InstanceState>();
#ifdef RX2CPP_HOST_API
                state->dynamicClass = classSide ? className : dynamicClassOf(ctx, selfObj);
                state->exact = !classSide && directMethodTable().count(state->dynamicClass) > 0;
#endif
                state->handle = (void *)selfObj;
                state->alive = true;
                if (!classSide) InstanceTable::instance().bind(state->handle, state);
                // Register before the body runs: INIT may send messages (SELF~attr = ...) that arrive in this object.
                token = InstanceTable::instance().add(state);
                state->token = token;
                failedInitToken = token;
                setRootToken(token);
            }
        } else {
            // The root class owns the single lifetime token. A derived method asks the root method for it; normal ooRexx
            // dispatch chooses that root implementation, and the derived method uses its own scope.
            RexxObjectPtr old = NULLOBJECT;
            if (isRoot) old = ctx->GetObjectVariable("RX2CPP_NATIVE_ID");
            else {
                auto definingRoot = ctx->FindClass(rootClass.c_str());
                if (definingRoot == NULLOBJECT)
                    throw std::runtime_error("compiled superclass missing: " + rootClass);
                // Explicit scope-directed message dispatch, bypassing a possible subclass override of the internal accessor.
                old = ctx->ForwardMessage(ctx->GetSelf(), "RX2CPP_NATIVE_TOKEN", definingRoot, ctx->NewArray(0));
            }
            if (old == NULLOBJECT && classSide && isRoot) {
                // The class object has no native state until its first CLASS method runs (no INIT CLASS declared).
                state = std::make_shared<InstanceState>();
                state->dynamicClass = className;
                state->handle = (void *)selfObj;
                state->alive = true;
                token = InstanceTable::instance().add(state);
                state->token = token;
                ctx->SetObjectVariable("RX2CPP_NATIVE_ID", ctx->String(token.c_str()));
            } else {
                if (old == NULLOBJECT || ctx->CheckCondition())
                    throw std::runtime_error("native object not initialized or root token inaccessible");
                token = stringValue(ctx, old);
                state = InstanceTable::instance().find(token);
            }
            if (!state) throw std::runtime_error("expired native object handle");
        }
        std::shared_ptr<CompiledObject> object = state->at(className);
        std::lock_guard<ScopeLock> scopeHold(object->scope_lock);
        Frame frame(ctx, selfObj, object->scope_lock, state, className);
#ifdef RX2CPP_HOST_API
        StateScope currentScope(state->exact ? state.get() : nullptr);
#endif
        std::vector<std::optional<rx::Value>> positional;
        positional.reserve(count);
        for (size_t i = 1; i <= count; ++i) {
            RexxObjectPtr item = ctx->ArrayAt(args, i);
            if (item == NULLOBJECT) { positional.emplace_back(std::nullopt); continue; }
#ifdef RX2CPP_HOST_API
            // Strings stay scalar values; every other interpreter object is passed as itself (no marshalling).
            if (!rxobj::isPlainString(ctx->threadContext, item))
                positional.emplace_back(rx::EnvObject::adopt((void *)ctx->threadContext->RequestGlobalReference(item)));
            else
#endif
            positional.emplace_back(rx::Value::string(stringValue(ctx, item)));
        }
        rx::Value outcome = object->invokeValues(selector, positional);
        // Generated ::ATTRIBUTE setters have no result; ordinary methods with
        // selectors ending in = (including []=) may explicitly RETURN a value.
        if (attributeSetter) return NULLOBJECT;
        if (initializer) {
            failedInitToken.clear();
            return NULLOBJECT; // ooRexx INIT must not return an ordinary value
        }
        if (outcome.isObject()) {
#ifdef RX2CPP_HOST_API
            if (auto *env = dynamic_cast<rx::EnvObject *>(outcome.object.get())) return (RexxObjectPtr)env->handle;
            if (dynamic_cast<rx::NilObject *>(outcome.object.get())) return ctx->Nil();
            if (auto *ref = dynamic_cast<rx::NativeRefBase *>(outcome.object.get())) return (RexxObjectPtr)ref->materialize();
#endif
            throw std::runtime_error("native method returned an object that the interpreter cannot receive");
        }
        return ctx->NewString(outcome.bytes.data(), outcome.bytes.size());
    } catch (const PendingCondition &) {
        if (!failedInitToken.empty()) InstanceTable::instance().remove(failedInitToken);
        return NULLOBJECT;
    } catch (const rx::SyntaxCondition &e) {
        if (!failedInitToken.empty()) InstanceTable::instance().remove(failedInitToken);
        raiseSyntaxIn(ctx->threadContext, e);
        return NULLOBJECT;
    } catch (const std::exception &e) {
        if (!failedInitToken.empty()) InstanceTable::instance().remove(failedInitToken);
        report(ctx, e.what());
        return NULLOBJECT;
    }
}
}

[[maybe_unused]] static std::string rx2cpp_routine_string(RexxCallContext *ctx, RexxObjectPtr object) {
    if (object == NULLOBJECT || !(ctx->IsString(object) || ctx->IsOfType(object, "STRING")))
        throw std::runtime_error("native routine accepts only ooRexx String scalar values");
    auto s = ctx->ObjectToString(object);
    return std::string(ctx->StringData(s), ctx->StringLength(s));
}
%ROUTINE_DEFINITIONS%
#ifdef RX2CPP_HAS_ROUTINES
// A package ::ROUTINE called by the interpreter. With the host API, arguments and result are values (objects included:
// interpreter objects, native instances, .nil); otherwise the scalar string ABI.
static RexxObjectPtr rx2cpp_routine_entry(RexxCallContext *context, RexxArrayObject args, const char *name) {
    try {
#ifdef RX2CPP_HOST_API
        rxobj::Scope hostScope(context->threadContext);
        auto obj = rx2cpp::makeGeneratedObject_RX2CPP_ROUTINE_IMPL();
        const size_t count = context->ArraySize(args);
        std::vector<std::optional<rx::Value>> positional;
        positional.reserve(count);
        for (size_t i = 1; i <= count; ++i) {
            RexxObjectPtr item = context->ArrayAt(args, i);
            if (item == NULLOBJECT) positional.emplace_back(std::nullopt);
            else if (rxobj::isPlainString(context->threadContext, item)) positional.emplace_back(rx::Value::string(rx2cpp_routine_string(context, item)));
            else if (item == context->Nil()) positional.emplace_back(rx::nil());
            else positional.emplace_back(rx::EnvObject::adopt((void *)context->threadContext->RequestGlobalReference(item)));
        }
        rx::Value outcome = obj->invokeValues(name, positional);
        if (outcome.isObject()) {
            if (auto *env = dynamic_cast<rx::EnvObject *>(outcome.object.get())) return (RexxObjectPtr)env->handle;
            if (dynamic_cast<rx::NilObject *>(outcome.object.get())) return context->Nil();
            if (auto *ref = dynamic_cast<rx::NativeRefBase *>(outcome.object.get())) return (RexxObjectPtr)ref->materialize();
            throw std::runtime_error("native routine returned an object that the interpreter cannot receive");
        }
        return context->NewString(outcome.bytes.data(), outcome.bytes.size());
#else
        auto obj = rx2cpp::makeGeneratedObject_RX2CPP_ROUTINE_IMPL();
        const size_t count = context->ArraySize(args);
        std::vector<std::optional<std::string>> positional;
        positional.reserve(count);
        for (size_t i = 1; i <= count; ++i) {
            RexxObjectPtr item = context->ArrayAt(args, i);
            if (item == NULLOBJECT) positional.emplace_back(std::nullopt);
            else positional.emplace_back(rx2cpp_routine_string(context, item));
        }
        const std::string value = obj->invokeMany(name, positional);
        return context->NewString(value.data(), value.size());
#endif
    } catch (const rx2cpp::PendingCondition &) {
        return NULLOBJECT;
    } catch (const rx::SyntaxCondition &e) {
        rx2cpp::raiseSyntaxIn(context->threadContext, e);
        return NULLOBJECT;
    } catch (const std::exception &e) {
        context->RaiseException1(Rexx_Error_Execution_user_defined, context->String(e.what()));
        return NULLOBJECT;
    }
}
#endif

%METHOD_DEFINITIONS%

// Called in the defining root's method scope, including for subclass objects.
RexxMethod1(RexxObjectPtr, rx_native_token, OSELF, self)
{
    (void)self;
    return context->GetObjectVariable("RX2CPP_NATIVE_ID");
}

// COPY must be an explicit deep copy of every scope; reusing the root token
// aliases two Rexx objects and breaks identity and lifetime semantics.
RexxMethod0(RexxObjectPtr, rx_native_copy_reject)
{
    context->RaiseException1(Rexx_Error_Execution_user_defined,
        context->String("native COPY requires per-scope independent state; unsupported"));
    return NULLOBJECT;
}

RexxMethod1(RexxObjectPtr, rx_native_uninit, OSELF, self)
{
    (void)self;
    auto value = context->GetObjectVariable("RX2CPP_NATIVE_ID");
    if (value != NULLOBJECT) {
        const auto s = context->ObjectToString(value);
        auto token = std::string(context->StringData(s), context->StringLength(s));
        if (auto st = rx2cpp::InstanceTable::instance().find(token)) {
            rx2cpp::InstanceTable::instance().unbind(st->handle);
            st->alive = false; st->handle = nullptr;
        }
        rx2cpp::InstanceTable::instance().remove(token);
        context->DropObjectVariable("RX2CPP_NATIVE_ID");
    }
    return NULLOBJECT;
}

static RexxMethodEntry nativeMethods[] = {
%METHOD_ENTRIES%
    REXX_METHOD(rx_native_uninit, rx_native_uninit),
    REXX_METHOD(rx_native_token, rx_native_token),
    REXX_METHOD(rx_native_copy_reject, rx_native_copy_reject),
    REXX_LAST_METHOD()
};

%DECLARATION_FORM%
#ifdef RX2CPP_INTERPRETED_FILE
// interpreted_form file: the interpreted parts of this library live in an editable source file next to the library,
// read every time the library loads. A marker line "/* #REXX2CPP METHODS class */" or "/* #REXX2CPP CLASSES */"
// starts a section of that file; the same marker in the declaration says where the section goes.
static std::string rx2cppMarker(const std::string &line) {
    const std::size_t a = line.find_first_not_of(" \t\r");
    if (a == std::string::npos) return std::string();
    const std::size_t b = line.find_last_not_of(" \t\r");
    const std::string t = line.substr(a, b - a + 1);
    if (t.size() < 16 || t.compare(0, 3, "/* ") != 0 || t.compare(t.size() - 2, 2, "*/") != 0) return std::string();
    std::istringstream words(t.substr(2, t.size() - 4));
    std::string w, key;
    while (words >> w) {
        for (char &c : w) c = static_cast<char>(std::toupper(static_cast<unsigned char>(c)));
        key += (key.empty() ? "" : " ") + w;
    }
    return key.compare(0, 10, "#REXX2CPP ") == 0 ? key : std::string();
}
static bool rx2cppInterpretedSource(const char *decl, std::size_t n, std::string &out, std::string &error) {
    Dl_info info{};
    std::string dir = ".";
    if (dladdr(reinterpret_cast<void *>(&rx2cppMarker), &info) && info.dli_fname) {
        const std::string so = info.dli_fname;
        const std::size_t slash = so.rfind('/');
        if (slash != std::string::npos) dir = so.substr(0, slash);
    }
    const std::string path = dir + "/" + RX2CPP_INTERPRETED_FILE;
    std::ifstream file(path, std::ios::binary);
    if (!file) { error = "interpreted source file not found: " + path; return false; }
    std::stringstream buffer;
    buffer << file.rdbuf();
    std::map<std::string, std::string> sections;
    std::string current, line;
    std::istringstream text(buffer.str());
    while (std::getline(text, line)) {
        const std::string key = rx2cppMarker(line);
        if (!key.empty()) {
            if (sections.count(key)) { error = path + ": duplicate marker " + key; return false; }
            current = key;
            sections[key];
        } else if (!current.empty()) sections[current] += line + "\n";
    }
    out.clear();
    std::istringstream declaration(std::string(decl, n));
    while (std::getline(declaration, line)) {
        const std::string key = rx2cppMarker(line);
        if (key.empty()) { out += line + "\n"; continue; }
        auto found = sections.find(key);
        if (found == sections.end()) { error = path + ": missing section " + key; return false; }
        out += line + "\n" + found->second;
        sections.erase(found);
    }
    if (!sections.empty()) { error = path + ": section with no place in the library: " + sections.begin()->first; return false; }
    return true;
}
#endif

static void RexxEntry loadPackage(RexxThreadContext *ctx) {
    // The build tokenizes the declaration with rexxc, which loads this library only to resolve its EXTERNAL methods
    // and routines. Loading the declaration package here would put live objects into the image, and run user code
    // (the prolog) at build time: do nothing.
    if (std::getenv("RX2CPP_TOKENIZING") != nullptr) return;
    // A native package normally only contributes routines/methods. We build
    // its PUBLIC class once and publish it to the ooRexx global environment.
    static const char declaration[] = %CLASS_SOURCE%;
    const char *classNames[] = {
%CLASS_NAMES%    };
    // Validate the entire set before changing the global environment.
    for (const char *className : classNames) {
        if (ctx->DirectoryAt(ctx->GetGlobalEnvironment(), className) != NULLOBJECT) {
            ctx->RaiseException1(Rexx_Error_Execution_user_defined,
                                 ctx->String("native class name already registered"));
            return;
        }
    }
    const char *declarationData = declaration;
    std::size_t declarationSize = sizeof(declaration) - 1;
#ifdef RX2CPP_INTERPRETED_FILE
    static std::string spliced;
    std::string spliceError;
    if (!rx2cppInterpretedSource(declaration, declarationSize, spliced, spliceError)) {
        ctx->RaiseException1(Rexx_Error_Execution_user_defined, ctx->String(("rx2cpp: " + spliceError).c_str()));
        return;
    }
    declarationData = spliced.data();
    declarationSize = spliced.size();
#endif
    auto pkg = ctx->LoadPackageFromData(%INTERNAL_NAME%, declarationData, declarationSize);
    if (pkg == NULLOBJECT || ctx->CheckCondition()) return;
#ifdef RX2CPP_HOST_API
    rxobj::libraryPackage() = ctx->RequestGlobalReference((RexxObjectPtr)pkg);
#endif
    auto classes = ctx->GetPackagePublicClasses(pkg);
    // Verify that all declared classes exist before publishing any.
    for (const char *className : classNames) {
        if (ctx->DirectoryAt(classes, className) == NULLOBJECT) {
            ctx->RaiseException1(Rexx_Error_Execution_user_defined,
                                 ctx->String("generated class not public"));
            return;
        }
    }
    for (const char *className : classNames) {
        auto cls = ctx->DirectoryAt(classes, className);
        ctx->DirectoryPut(ctx->GetGlobalEnvironment(), cls, className);
    }
    // The source package's prolog (code before its first ::CLASS), carried as a routine of the declaration.
    auto routines = ctx->GetPackageRoutines(pkg);
    if (routines != NULLOBJECT) {
        auto prolog = ctx->DirectoryAt(routines, "RX2CPP_PACKAGE_PROLOG");
        if (prolog != NULLOBJECT) ctx->CallRoutine((RexxRoutineObject)prolog, ctx->NewArray(0));
    }
}

static RexxRoutineEntry nativeRoutines[] = {
%ROUTINE_ENTRIES%    REXX_LAST_ROUTINE()
};

static RexxPackageEntry generated_package_entry = {
    STANDARD_PACKAGE_HEADER
    REXX_CURRENT_INTERPRETER_VERSION,
    %PACKAGE_NAME%, "0.17.0-dev1", loadPackage, nullptr, nativeRoutines, nativeMethods
};
OOREXX_GET_PACKAGE(generated)
