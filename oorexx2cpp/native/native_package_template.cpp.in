// A method context call that may let the interpreter run (ForwardMessage, SetGuardOn / SetGuardOff): it moves the
// interpreter epoch (rx_api_epoch.hpp) where the library has one.
template <class F> inline auto viaInterpreter(F &&f) {
#ifdef RX_API_PURE
    return rxobj::viaInterpreter(std::forward<F>(f));
#else
    return f();
#endif
}
Registry &Registry::instance() { static Registry registry; return registry; }
std::string Registry::add(std::shared_ptr<CompiledObject> obj) {
    if (!obj) throw std::invalid_argument("null compiled object");
    std::lock_guard<std::mutex> lock(gate_);
    auto token = std::string("instance-") + std::to_string(++next_);
    objects_.emplace(token, std::move(obj));
    return token;
}
void Registry::remove(const std::string &token) {
    std::lock_guard<std::mutex> lock(gate_);
    objects_.erase(token);
}
std::shared_ptr<CompiledObject> Registry::find(const std::string &token) {
    std::lock_guard<std::mutex> lock(gate_);
    const auto it = objects_.find(token);
    return it == objects_.end() ? nullptr : it->second;
}
static std::string stringValue(RexxMethodContext *ctx, RexxObjectPtr object) {
    if (object == NULLOBJECT || !(ctx->IsString(object) || ctx->IsOfType(object, "STRING")))
        throw std::runtime_error("only ooRexx String scalar values are supported");
    auto s = ctx->ObjectToString(object);
    std::string out(ctx->StringData(s), ctx->StringLength(s));
    if ((RexxObjectPtr)s != object) ctx->ReleaseLocalReference((RexxObjectPtr)s);
    return out;
}
// A SYNTAX condition raised by compiled code (RAISE SYNTAX n.m ARRAY/ADDITIONAL, or a runtime error with a code)
// becomes the same interpreter condition, so CONDITION('O') and the error message are the interpreter's own.
static void raiseSyntaxIn(RexxThreadContext *t, const rx::SyntaxCondition &e) {
    const std::string &c = e.code;
    const auto dot = c.find('.');
    const bool numeric = !c.empty() && c.find_first_not_of("0123456789.") == std::string::npos && dot != std::string::npos;
    if (!numeric) {
        t->RaiseException1(Rexx_Error_Execution_user_defined, t->String(e.what()));
        return;
    }
    const size_t number = std::stoul(c.substr(0, dot)) * 1000 + std::stoul(c.substr(dot + 1));
#ifdef RX2CPP_HOST_API
    // An interpreter error passing through compiled code: raised again with its own ADDITIONAL objects, unconverted.
    if (e.conditionObject) {
        if (auto *env = dynamic_cast<rx::EnvObject *>(e.conditionObject.get())) {
            if (env->handle && t->IsDirectory((RexxObjectPtr)env->handle)) {
                RexxObjectPtr add = t->DirectoryAt((RexxDirectoryObject)env->handle, "ADDITIONAL");
                if (add != NULLOBJECT && t->IsArray(add)) {
                    if (t->ArraySize((RexxArrayObject)add) == 0) { t->RaiseException0(number); return; }
                    t->RaiseException(number, (RexxArrayObject)add);
                    return;
                }
            }
        }
    }
#endif
    if (e.substitutions.empty()) { t->RaiseException0(number); return; }
    RexxArrayObject subs = t->NewArray(e.substitutions.size());
    for (size_t i = 0; i < e.substitutions.size(); ++i) {
        const rx::Value &v = e.substitutions[i];
#ifdef RX2CPP_HOST_API
        if (v.isObject()) {
            if (auto *env = dynamic_cast<rx::EnvObject *>(v.object.get())) { t->ArrayPut(subs, (RexxObjectPtr)env->handle, i + 1); continue; }
        }
#endif
        const std::string text = v.isObject() ? v.object->display() : v.bytes.str();
        t->ArrayPut(subs, t->NewString(text.data(), text.size()), i + 1);
    }
    t->RaiseException(number, subs);
}
// The interpreter's "does not understand" (97.1) passing through compiled code: raised again as itself.
static bool raiseNoMethodIn(RexxThreadContext *t, const rx::NoMethod &e) {
    if (!e.conditionObject) return false;
    rx::SyntaxCondition again("97.1", e.what(), false);
    again.substitutions = e.substitutions;
    again.conditionObject = e.conditionObject;
    raiseSyntaxIn(t, again);
    return true;
}
static void report(RexxMethodContext *ctx, const char *message) {
    ctx->RaiseException1(Rexx_Error_Execution_user_defined, ctx->String(message));
}
static std::shared_ptr<CompiledObject> create(const std::string &className) {
%FACTORY_DISPATCH%
    throw std::runtime_error("unsupported native class: " + className);
}
/* The interpreter already holds a condition for this activity (for example the
   callee raised an error). Return to ooRexx without raising a second one. */
struct PendingCondition : std::runtime_error {
    PendingCondition() : std::runtime_error("ooRexx condition pending") {}
};
// constant: a ::CONSTANT of definingClass (its value is the interpreter's: constantValue)
struct MethodInfo { const char *definingClass; bool isPublic; bool noResult; bool constant = false; };
/* Selector and class names are case-insensitive in ooRexx; the tables hold the upper-case spelling and are searched without
   making an upper-case copy of the incoming name. */
// (ASCII upper case, inline: what std::toupper does to a symbol's characters in the C locale, without a library call
// per character on every message send)
static inline unsigned char ciUpper(unsigned char c) { return (c >= 'a' && c <= 'z') ? static_cast<unsigned char>(c - 32) : c; }
struct CiHash {
    std::size_t operator()(const std::string &s) const {
        std::size_t h = 1469598103934665603ULL;
        for (unsigned char c : s) { h ^= ciUpper(c); h *= 1099511628211ULL; }
        return h;
    }
};
struct CiEq {
    bool operator()(const std::string &a, const std::string &b) const {
        if (a.size() != b.size()) return false;
        for (std::size_t i = 0; i < a.size(); i++)
            if (ciUpper((unsigned char)a[i]) != ciUpper((unsigned char)b[i])) return false;
        return true;
    }
};
typedef std::unordered_map<std::string, MethodInfo, CiHash, CiEq> MethodTable;
typedef std::unordered_map<std::string, MethodTable, CiHash, CiEq> ClassMethodTable;
%DIRECT_TABLES%
[[maybe_unused]] static std::string upperOf(std::string s) {
    for (char &c : s) c = static_cast<char>(ciUpper(static_cast<unsigned char>(c)));
    return s;
}
/* Dual representation: one native instance = one InstanceState. The state owns the compiled per-class scopes. It is
   reachable from compiled code directly (NativeInstanceRef) and, once an interpreter object exists for it, through the
   token stored in that object. */
struct InstanceState;
bool stateDisposable(InstanceState &st);
void trackState(const std::shared_ptr<InstanceState> &st);
void watchProxy(InstanceState &st);
bool proxyLive(InstanceState &st);
std::shared_ptr<InstanceState> stateOfObject(void *handle);
struct InstanceState : std::enable_shared_from_this<InstanceState> {
    std::string dynamicClass;        // the class the instance was created from (upper case)
    // 1: the interpreter object holds nothing the native state does not (stateDisposable): it is not pinned for compiled
    // code's references, the interpreter collects it when it holds it no more, and one is made again when needed.
    signed char disposable = -1;
    // the class's method table (lookupMethod(InstanceState &, ...)): found on the first send; a marker when the class has none
    std::atomic<const void *> methods{nullptr};
    // A WeakReference (pinned) to the state's interpreter object: says whether the interpreter still has it (cleared by
    // the collection that finds it unreachable). The state is released when it is found cleared (watchProxy).
    void *weak = nullptr;
    bool exact = false;              // the dynamic class is a class of this package, so direct dispatch is faithful
    bool classSide = false;          // the state of a class object (its CLASS methods), not of an instance
    std::mutex gate;
    void *handle = nullptr;          // interpreter object, valid while alive
    bool alive = false;
    // Compiled code's references (NativeInstanceRef objects) are invisible to the interpreter's collector: while there
    // are any, the interpreter object is pinned, so it is not collected (and its UNINIT does not run) under them.
    int nativeRefs = 0;
    void *pin = nullptr;
    void notePin() {   // (gate held)
#ifdef RX2CPP_HOST_API
        if (nativeRefs > 0 && alive && handle && !pin && rxobj::current && !stateDisposable(*this))
            pin = (void *)rxobj::pinRef(rxobj::current, (RexxObjectPtr)handle);
#endif
    }
    std::string token;
#ifdef RX2CPP_HOST_API
    // An instance of a compiled .Array subclass made by compiled code (arrayNewTable): its array part, native until the
    // instance needs its interpreter object (materializeState copies the items into it, and this goes).
    std::shared_ptr<rx::NativeArray> builtin;
#endif
    std::vector<std::pair<std::string, std::shared_ptr<CompiledObject>>> scopes;   // instances have a handful of scopes: a scan beats hashing
    std::shared_ptr<CompiledObject> at(const std::string &cls) {
        std::lock_guard<std::mutex> lock(gate);
        for (const auto &entry : scopes) if (entry.first == cls) return entry.second;
        auto created = create(cls);
        scopes.emplace_back(cls, created);
        return created;
    }
};
class InstanceTable {
    std::mutex gate_;
    std::unordered_map<std::string, std::shared_ptr<InstanceState>> states_;
    unsigned long long next_ = 0;
    std::vector<std::weak_ptr<InstanceState>> all_;   // every native state (the cycle collector's view)
    std::size_t sinceCollect_ = 0, collectAt_ = 20000;
    // RX2CPP_GC_EVERY=n: collect every n states (tests: 1 collects at every new state)
    std::size_t every_ = [] { const char *e = std::getenv("RX2CPP_GC_EVERY"); return e ? std::max<std::size_t>(1, std::strtoul(e, nullptr, 10)) : 0; }();
public:
    InstanceTable() { if (every_) collectAt_ = every_; }
    static InstanceTable &instance() { static InstanceTable table; return table; }
    // A new native state, known to the cycle collector. True when enough have been made since it last ran.
    bool track(const std::shared_ptr<InstanceState> &state) {
        std::lock_guard<std::mutex> lock(gate_);
        all_.push_back(state);
        return ++sinceCollect_ >= collectAt_;
    }
    std::vector<std::shared_ptr<InstanceState>> liveStates() {
        std::lock_guard<std::mutex> lock(gate_);
        std::vector<std::shared_ptr<InstanceState>> out;
        out.reserve(all_.size());
        std::size_t kept = 0;
        for (auto &w : all_) if (auto st = w.lock()) { out.push_back(std::move(st)); all_[kept++] = w; }
        all_.resize(kept);
        return out;
    }
    void collected(std::size_t survivors) {
        std::lock_guard<std::mutex> lock(gate_);
        sinceCollect_ = 0;
        collectAt_ = every_ ? every_ : std::max<std::size_t>(20000, survivors);   // (its work is proportional to the states)
    }
    std::string add(const std::shared_ptr<InstanceState> &state) {
        std::lock_guard<std::mutex> lock(gate_);
        auto token = std::string("instance-") + std::to_string(++next_);
        states_.emplace(token, state);
        return token;
    }
    std::shared_ptr<InstanceState> find(const std::string &token) {
        std::lock_guard<std::mutex> lock(gate_);
        auto it = states_.find(token);
        return it == states_.end() ? nullptr : it->second;
    }
    void remove(const std::string &token) {
        std::lock_guard<std::mutex> lock(gate_);
        states_.erase(token);
    }
    // Interpreter object -> its native state (exact compiled instances only), so an object the interpreter hands back
    // to compiled code runs its compiled methods directly.
    void bind(void *handle, const std::shared_ptr<InstanceState> &state) {
        if (!handle) return;
        std::lock_guard<std::mutex> lock(gate_);
        byHandle_[handle] = state;
    }
    void unbind(void *handle) {
        if (!handle) return;
        std::lock_guard<std::mutex> lock(gate_);
        byHandle_.erase(handle);
    }
    std::shared_ptr<InstanceState> byHandle(void *handle) {
        std::lock_guard<std::mutex> lock(gate_);
        auto it = byHandle_.find(handle);
        return it == byHandle_.end() ? nullptr : it->second.lock();
    }
private:
    std::unordered_map<void *, std::weak_ptr<InstanceState>> byHandle_;
};
#ifndef RX2CPP_HOST_API
// (without the host API there is no WeakReference watching: the address's state as bound)
std::shared_ptr<InstanceState> stateOfObject(void *handle) { return InstanceTable::instance().byHandle(handle); }
#endif
namespace {
struct ReleaseAndReacquire {
    ScopeLock &lock; unsigned depth;
    explicit ReleaseAndReacquire(ScopeLock &l) : lock(l), depth(l.release_all()) {}
    ~ReleaseAndReacquire() { lock.reacquire(depth); }
};
}
#ifdef RX2CPP_HOST_API
namespace {
thread_local InstanceState *currentState = nullptr;           // exact instance whose compiled method is running
thread_local std::shared_ptr<InstanceState> pendingAdopt;      // set while an interpreter object is made for a native state
struct StateScope {
    InstanceState *previous;
    explicit StateScope(InstanceState *s) : previous(currentState) { currentState = s; }
    ~StateScope() { currentState = previous; }
};
std::optional<rx::Value> optionalOf(const rx::Value &v) {
    if (v.isObject()) {
        auto *e = dynamic_cast<rx::EnvObject *>(v.object.get());
        if (e && !e->handle) return std::nullopt;       // an omitted argument slot
    }
    return v;
}
std::vector<std::optional<rx::Value>> optionalsOf(const std::vector<rx::Value> &args) {
    std::vector<std::optional<rx::Value>> out;
    out.reserve(args.size());
    for (const auto &a : args) out.push_back(optionalOf(a));
    return out;
}
/* The table entry for (class, selector): first = the canonical upper-case selector, second = how to dispatch it. */
typedef const MethodTable::value_type Resolved;
/* A class's methods by a key of the selector (its length, first and fourth (or last) characters, case folded: three
   loads, no pass over the name), in an open-addressed table: one probe and one comparison on a send. */
struct FastMethods {
    struct Slot { std::uint32_t key = 0; Resolved *entry = nullptr; };
    std::vector<Slot> slots;
    std::size_t mask = 0;
    static std::uint32_t keyOf(const std::string &s) {
        const std::size_t n = s.size();
        if (n == 0) return 0;
        return static_cast<std::uint32_t>(n & 0xFFFF) | static_cast<std::uint32_t>(ciUpper(static_cast<unsigned char>(s[0]))) << 16 |
               static_cast<std::uint32_t>(ciUpper(static_cast<unsigned char>(s[n >= 4 ? 3 : n - 1]))) << 24;
    }
    static std::size_t spread(std::uint32_t k) { return static_cast<std::size_t>((k * 0x9E3779B1u) ^ (k >> 13)); }
    explicit FastMethods(const MethodTable &table) {
        std::size_t size = 8;
        while (size < table.size() * 2) size <<= 1;
        slots.resize(size);
        mask = size - 1;
        for (const auto &entry : table) {
            const std::uint32_t k = keyOf(entry.first);
            std::size_t i = spread(k) & mask;
            while (slots[i].entry) i = (i + 1) & mask;
            slots[i].key = k; slots[i].entry = &entry;
        }
    }
    Resolved *find(const std::string &selector) const {
        static const CiEq same;
        const std::uint32_t k = keyOf(selector);
        for (std::size_t i = spread(k) & mask; slots[i].entry; i = (i + 1) & mask)
            if (slots[i].key == k && same(slots[i].entry->first, selector)) return slots[i].entry;
        return nullptr;
    }
};
const FastMethods *fastMethodsOf(const std::string &cls) {
    static const auto *all = [] {
        auto *m = new std::unordered_map<std::string, FastMethods, CiHash, CiEq>();
        for (const auto &c : directMethodTable()) m->emplace(c.first, FastMethods(c.second));
        return m;
    }();
    auto it = all->find(cls);
    return it == all->end() ? nullptr : &it->second;
}
Resolved *lookupMethod(const std::string &cls, const std::string &selector) {
    const FastMethods *f = fastMethodsOf(cls);
    return f ? f->find(selector) : nullptr;
}
/* (a state's class table, found once) */
Resolved *lookupMethod(InstanceState &st, const std::string &selector) {
    static const char none = 0;   // (marks a class with no table)
    const void *known = st.methods.load(std::memory_order_acquire);
    if (!known) {
        const FastMethods *f = fastMethodsOf(st.dynamicClass);
        known = f ? static_cast<const void *>(f) : static_cast<const void *>(&none);
        st.methods.store(known, std::memory_order_release);
    }
    if (known == &none) return nullptr;
    return static_cast<const FastMethods *>(known)->find(selector);
}
/* The interpreter object of a native state stays alive while compiled code sends it a message: nothing in the
   interpreter may reference it (a native instance's proxy), so a collection during the send (an argument string, the
   method's own work) would run its UNINIT and leave the send on an object without its token. A pin for that time. */
struct ProxyHold {
    void *h = nullptr;
    ProxyHold() = default;
    ProxyHold(const ProxyHold &) = delete;
    ProxyHold &operator=(const ProxyHold &) = delete;
    ~ProxyHold() { if (h && rxobj::current) rxobj::unpinRef(rxobj::current, h); }
};
/* An interpreter object for a native state: a new instance of the class whose first INIT adopts the state. */
void *materializeState(const std::shared_ptr<InstanceState> &st, ProxyHold *hold = nullptr) {
    if (st->alive && st->handle && proxyLive(*st)) {
        if (hold) hold->h = (void *)rxobj::pinRef(rxobj::need(), (RexxObjectPtr)st->handle);
        return st->handle;
    }
    void *cls = rxobj::findClass(st->dynamicClass);
    if (!cls) throw std::runtime_error("native class is not registered: " + st->dynamicClass);
    pendingAdopt = st;
    std::vector<rxobj::Arg> none; rxobj::Result r; std::string code, text;
    const bool ok = rxobj::send(cls, "NEW", none, r, code, text);
    pendingAdopt.reset();
    rxobj::release(cls);
    if (!ok) throw rx::SyntaxCondition(code, text, false);
    // (the new object's own reference: kept for the caller's send, else released: the state's pin keeps it, or for a
    // disposable state the caller's own (an argument's hold, the entry's result: rxobj::returnPin), taken before the
    // interpreter allocates again)
    if (!st->alive) { if (r.kind == 2) rxobj::release(r.obj); throw std::runtime_error("cannot create the interpreter object for a native instance"); }
    if (st->builtin) {
        // the array part goes into the interpreter object, as it is: each item at its index, and the size (an empty
        // slot at the end: .nil put there and removed, which leaves the size); the instance is the interpreter's from now on
        std::shared_ptr<rx::NativeArray> items = std::move(st->builtin);
        st->builtin.reset();
        auto put = [&](const char *selector, std::vector<rx::Value> args) {
            std::vector<rxobj::Arg> in; rx::EnvObject::convert(args, in);
            rxobj::Result done; std::string c, t;
            if (!rxobj::send(st->handle, selector, in, done, c, t)) throw rx::SyntaxCondition(c, t, false);
            if (done.kind == 2) rxobj::release(done.obj);
        };
        const std::size_t size = items->slots.size();
        for (std::size_t i = 0; i < size; ++i)
            if (items->slots[i]) put("PUT", {*items->slots[i], rx::NativeArray::number(i + 1)});
        if (size > 0 && !items->slots[size - 1]) {
            put("PUT", {rx::nil(), rx::NativeArray::number(size)});
            put("REMOVE", {rx::NativeArray::number(size)});
        }
    }
    if (r.kind == 2) { if (hold) hold->h = r.obj; else rxobj::release(r.obj); }
    { std::lock_guard<std::mutex> lock(st->gate); st->notePin(); }   // compiled code holds it: keep it
    return st->handle;
}
std::optional<rx::Value> interpreterSend(const std::shared_ptr<InstanceState> &st, const std::string &selector,
                                         const std::vector<rx::Value> &args) {
    ProxyHold hold;
    // RX2CPP_BIF_STATS: which message makes a native instance's interpreter object
    static const bool sendStats = std::getenv("RX2CPP_BIF_STATS") != nullptr;
    if (sendStats && !(st->alive && st->handle)) rxobj::bifStat("materialize " + st->dynamicClass + " for ~" + selector);
    void *h = materializeState(st, &hold);
    std::vector<rxobj::Arg> in; rx::EnvObject::convert(args, in);
    rxobj::Result r; std::string code, text;
    if (!rxobj::send(h, selector, in, r, code, text)) {
        if (code == "97.1") {
            rx::NoMethod missing(text);
            for (const std::string &a : rxobj::lastAdditional()) missing.substitutions.push_back(rx::Value::string(a));
            missing.conditionObject = rx::takeKeptCondition();
            throw missing;
        }
        rx::SyntaxCondition raised(code, text, false);
        for (const std::string &a : rxobj::lastAdditional()) raised.substitutions.push_back(rx::Value::string(a));
        raised.conditionObject = rx::takeKeptCondition();
        throw raised;
    }
    if (r.kind == 0) return std::nullopt;
    return rx::EnvObject::wrap(r);
}
std::optional<rx::Value> runNative(const std::shared_ptr<InstanceState> &st, Resolved &method,
                                   const std::vector<std::optional<rx::Value>> &args);
/* A message to an instance of a compiled .Array subclass that its class does not define, answered by its native array
   part (InstanceState::builtin) when that answers it as the interpreter's Array would for this object. Not the
   messages whose answer is the array itself or its class (FILL, CLASS, ISA): those are the instance's own. */
bool builtinSend(InstanceState &st, const std::string &selector, const std::vector<rx::Value> &args, std::optional<rx::Value> &out) {
    if (!st.builtin) return false;
    static const CiEq same;
    if (same(selector, "FILL") || same(selector, "CLASS") || same(selector, "ISA")) return false;
    // (the selector as the native array knows it: upper case)
    rx::MessageResult r;
    if (!st.builtin->answer(upperOf(selector), args, r)) return false;
    out = std::move(r);
    return true;
}
/* SELF~selector(args) from compiled code in an exact instance: dispatch inside the library when the method is compiled. */
bool nativeSelfSend(const std::shared_ptr<InstanceState> &st, const std::string &definingClass, const std::string &selector,
                    const std::vector<rx::Value> &args, std::optional<rx::Value> &out) {
    static const CiEq same;
    // The super helpers are named after the defining class: RX2CPP_SUPERA_<class>, RX2CPP_SUPER_<class>.
    auto startsWith = [&](const char *prefix) {
        const std::size_t n = std::strlen(prefix);
        return selector.size() > n && same(selector.substr(0, n), prefix);
    };
    if (startsWith("RX2CPP_SUPERA_")) return false;
    if (startsWith("RX2CPP_SUPER_")) {
        if (args.empty() || args[0].isObject()) return false;
        const auto &parents = parentTable();
        auto pit = parents.find(definingClass);
        if (pit == parents.end() || pit->second.empty()) {
            // self~init:super in a root class whose superclass is .Object (a class of this library whose state is all
            // native): .Object's INIT, which does nothing (without making the interpreter object to run it there)
            if (args.size() == 1 && same(args[0].bytes, "INIT") && directNewTable().count(definingClass) && stateDisposable(*st)) {
                out = std::nullopt;
                return true;
            }
            return false;
        }
        Resolved *method = lookupMethod(pit->second, args[0].bytes);
        if (!method) return false;
        std::vector<std::optional<rx::Value>> rest;
        for (std::size_t i = 1; i < args.size(); i++) rest.push_back(optionalOf(args[i]));
        out = runNative(st, *method, rest);
        return true;
    }
    Resolved *method = lookupMethod(*st, selector);
    if (!method) return false;
    out = runNative(st, *method, optionalsOf(args));
    return true;
}
/* ooRexx RexxObject::checkPrivate: a private method runs when the sender is the receiver itself, or an instance of the
   class that defined the method (its scope). The sender here is the instance whose compiled method is running on this
   thread; anything else (a class-side or interpreter sender) is left to the interpreter's own check. */
static bool instanceOfScope(const std::string &cls, const char *scope) {
    static const CiEq same;
    const auto &parents = parentTable();
    std::string c = cls;
    for (int guard = 0; guard < 64 && !c.empty(); guard++) {
        if (same(c, scope)) return true;
        auto it = parents.find(c);
        if (it == parents.end()) return false;
        c = it->second;
    }
    return false;
}
static bool privateAllowedFor(const InstanceState *receiver, const MethodInfo &info) {
    if (!currentState) return false;
    if (currentState == receiver) return true;
    return instanceOfScope(currentState->dynamicClass, info.definingClass);
}
/* Does an instance of this compiled class answer the comparison `op` with .Object's own method (identity)? Exact for
   the class: the interpreter is asked once per (class, operator) whether an instance's instanceMethod(op) is the one
   a plain .Object instance runs (a compiled method of that name, a mixin such as Orderable, or an interpreter parent
   that defines it all give false). Not seen: a method given to one object later with SETMETHOD. */
bool objectIdentityOp(const std::shared_ptr<InstanceState> &st, const std::string &op) {
    static thread_local std::map<std::pair<std::string, std::string>, bool> known;
    const auto key = std::make_pair(st->dynamicClass, op);
    auto it = known.find(key);
    if (it != known.end()) return it->second;
    bool identity = false;
    if (!lookupMethod(st->dynamicClass, op)) {
        static thread_local void *plainObject = nullptr;   // one .Object instance, kept for the comparison
        if (!plainObject) {
            void *object = rxobj::findClass("OBJECT");
            rxobj::Result r; std::string code, text;
            if (object && rxobj::send(object, "NEW", {}, r, code, text) && r.kind == 2) plainObject = r.obj;
            if (object) rxobj::release(object);
        }
        ProxyHold hold;
        void *mine = materializeState(st, &hold);
        if (plainObject && mine) {
            std::vector<rxobj::Arg> name(1); name[0].bytes = op;
            rxobj::Result a, b; std::string code, text;
            const bool okA = rxobj::send(mine, "INSTANCEMETHOD", name, a, code, text);
            const bool okB = okA && rxobj::send(plainObject, "INSTANCEMETHOD", name, b, code, text);
            identity = okA && okB && a.kind == 2 && b.kind == 2 && a.obj == b.obj;
            if (okA && a.kind == 2) rxobj::release(a.obj);
            if (okB && b.kind == 2) rxobj::release(b.obj);
        }
    }
    known.emplace(key, identity);
    return identity;
}
rx::Value nativeClassValue(const std::string &name);
class NativeInstanceRef;
/* A message to a compiled instance that its class has no compiled method for (from compiled code holding it, or SELF
   in one of its methods): its array part, the messages answered here without its interpreter object, else the
   interpreter object. */
rx::MessageResult inheritedSend(const std::shared_ptr<InstanceState> &st, const std::string &selector, const std::vector<rx::Value> &args);
class NativeInstanceRef final : public rx::NativeRefBase {
    std::shared_ptr<InstanceState> st_;
    std::shared_ptr<rx::EnvObject> keep_;   // adopted from the interpreter: holds its global reference (no early UNINIT)
public:
    explicit NativeInstanceRef(std::shared_ptr<InstanceState> st, std::shared_ptr<rx::EnvObject> keep = nullptr)
        : st_(std::move(st)), keep_(std::move(keep)) {
        std::lock_guard<std::mutex> lock(st_->gate);
        ++st_->nativeRefs;
        st_->notePin();
    }
    ~NativeInstanceRef() override {
        std::lock_guard<std::mutex> lock(st_->gate);
        if (--st_->nativeRefs == 0 && st_->pin) { rxobj::unpinLater(st_->pin); st_->pin = nullptr; }
    }
    NativeInstanceRef(const NativeInstanceRef &) = delete;
    NativeInstanceRef &operator=(const NativeInstanceRef &) = delete;
    void *materialize() override {
        static const bool sendStats = std::getenv("RX2CPP_BIF_STATS") != nullptr;
        const bool made = sendStats && !(st_->alive && st_->handle);
        void *h = materializeState(st_);
        // (named with the send it goes to: the next one, after the NEW that made it)
        if (made) rxobj::pendingArgumentStat = "materialize " + st_->dynamicClass + " as an argument";
        return h;
    }
    rx::MessageResult sendMessage(const std::string &selector, const std::vector<rx::Value> &args) override {
        if (Resolved *method = lookupMethod(*st_, selector)) {
            if (method->second.isPublic || privateAllowedFor(st_.get(), method->second)) return runNative(st_, *method, optionalsOf(args));
            return interpreterSend(st_, selector, args);   // (the interpreter's error, or its own check)
        }
        return inheritedSend(st_, selector, args);
    }
    const InstanceState *state() const { return st_.get(); }
    const std::shared_ptr<InstanceState> &stateRef() const { return st_; }   // (the cycle collector's edge)
    rx::Value sendBinary(const std::string &selector, const rx::Value &rhs) override {
        // .Object's comparisons are identity: answered here when that is the method the object would run.
        const bool positive = selector == "==" || selector == "=";
        if ((positive || selector == "\\==" || selector == "\\=" || selector == "<>" || selector == "><") &&
            objectIdentityOp(st_, selector)) {
            bool same = false;
            if (auto *other = dynamic_cast<NativeInstanceRef *>(rhs.object.get())) same = other->state() == st_.get();
            else if (auto *env = dynamic_cast<rx::EnvObject *>(rhs.object.get())) same = st_->alive && st_->handle && env->handle == st_->handle;
            return rx::Value::string(same == positive ? "1" : "0");
        }
        auto r = sendMessage(selector, {rhs});
        if (!r) throw std::runtime_error("operator message returned no value: " + selector);
        return *r;
    }
    rx::Value sendUnary(const std::string &selector) override {
        auto r = sendMessage(selector, {});
        if (!r) throw std::runtime_error("operator message returned no value: " + selector);
        return *r;
    }
    std::string display() const override {
        auto r = const_cast<NativeInstanceRef *>(this)->sendMessage("STRING", {});
        if (!r || r->isObject()) throw std::runtime_error("object has no string value");
        return r->bytes;
    }
};
rx::MessageResult inheritedSend(const std::shared_ptr<InstanceState> &st, const std::string &selector, const std::vector<rx::Value> &args) {
    static const CiEq same;
    if (st->builtin) {
        std::optional<rx::Value> out;
        if (builtinSend(*st, selector, args, out)) return out;
    }
    // ISA (the class defines none: no compiled method was found): the answer depends on the instance's class and the
    // class asked about, so the interpreter answers once per pair.
    if (args.size() == 1 && args[0].isObject() && !st->classSide && same(selector, "ISA")) {
        void *key = nullptr;
        if (auto *e = dynamic_cast<rx::EnvObject *>(args[0].object.get())) key = e->handle;
        else if (auto *n = dynamic_cast<rx::NativeRefBase *>(args[0].object.get()); n && !dynamic_cast<NativeInstanceRef *>(n)) key = n->materialize();
        if (key) {
            static thread_local std::map<std::pair<std::string, void *>, bool> known;
            const auto k = std::make_pair(st->dynamicClass, key);
            auto it = known.find(k);
            if (it != known.end()) return rx::Value::string(it->second ? "1" : "0");
            auto r = interpreterSend(st, selector, args);
            if (r && !r->isObject()) known.emplace(k, r->bytes == "1");
            return r;
        }
    }
    // .Object's ISNIL and CLASS of an instance of a class of this library whose state is all native: answered here
    // (the class defines neither), without making its interpreter object
    if (args.empty() && !st->classSide && stateDisposable(*st)) {
        if (same(selector, "ISNIL")) return rx::Value::string("0");
        if (same(selector, "CLASS")) return nativeClassValue(st->dynamicClass);
    }
    return interpreterSend(st, selector, args);
}
class NativeFrame final : public SelfSender {
    std::shared_ptr<InstanceState> st_; std::string definingClass_;
    const std::vector<std::optional<rx::Value>> &args_; SelfSender *previous_;
public:
    NativeFrame(std::shared_ptr<InstanceState> st, std::string cls, const std::vector<std::optional<rx::Value>> &args)
        : st_(std::move(st)), definingClass_(std::move(cls)), args_(args), previous_(detail::currentSender) { detail::currentSender = this; }
    ~NativeFrame() override { detail::currentSender = previous_; }
    std::optional<rx::Value> sendValues(const std::string &selector, const std::vector<rx::Value> &args) override {
        std::optional<rx::Value> out;
        if (nativeSelfSend(st_, definingClass_, selector, args, out)) return out;
        // (a super helper nativeSelfSend leaves, or a message the class has no compiled method for)
        if (selector.compare(0, 7, "RX2CPP_") == 0 || lookupMethod(*st_, selector)) return interpreterSend(st_, selector, args);
        return inheritedSend(st_, selector, args);
    }
    std::string send(const std::string &selector, const std::vector<std::string> &args) override {
        std::vector<rx::Value> values;
        for (const auto &a : args) values.push_back(rx::Value::string(a));
        auto r = sendValues(selector, values);
        if (!r) throw std::runtime_error("SELF~" + selector + " returned no value");
        if (r->isObject()) return r->object->display();
        return r->bytes;
    }
    std::optional<rx::Value> forwardValues(const std::string &selector) override {
        std::vector<rx::Value> values;
        for (const auto &a : args_) values.push_back(a ? *a : rx::omittedArgument());
        return sendValues(selector, values);
    }
    std::string forward(const std::string &selector) override {
        std::vector<rx::Value> values;
        for (const auto &a : args_) values.push_back(a ? *a : rx::omittedArgument());
        auto r = sendValues(selector, values);
        if (!r) throw std::runtime_error("FORWARD returned no scalar result");
        if (r->isObject()) return r->object->display();
        return r->bytes;
    }
};
/* The value of a ::CONSTANT of a class of this library: the interpreter evaluated it when the package was installed
   (the declaration package has the directive as written); its class object answers the same value (a constant is a
   method of the class and of its instances). Asked once: the value never changes. */
rx::Value constantValue(const char *definingClass, const std::string &selector) {
    static std::mutex gate;
    static std::map<std::pair<std::string, std::string>, rx::Value> known;
    const auto key = std::make_pair(std::string(definingClass), selector);
    { std::lock_guard<std::mutex> lock(gate); auto it = known.find(key); if (it != known.end()) return it->second; }
    void *cls = rxobj::findClass(definingClass);
    if (!cls) throw std::runtime_error(std::string("native class is not registered: ") + definingClass);
    rxobj::Result r; std::string code, text;
    const bool ok = rxobj::send(cls, selector, {}, r, code, text);
    rxobj::release(cls);
    if (!ok) throw rx::SyntaxCondition(code, text, false);
    if (r.kind == 0) throw std::runtime_error("constant without a value: " + selector);
    rx::Value v = rx::EnvObject::wrap(r);
    std::lock_guard<std::mutex> lock(gate);
    return known.emplace(key, v).first->second;
}
std::optional<rx::Value> runNative(const std::shared_ptr<InstanceState> &st, Resolved &method,
                                   const std::vector<std::optional<rx::Value>> &args) {
    const MethodInfo &info = method.second;
    if (info.constant) {
        if (!args.empty()) {   // (the interpreter's error)
            std::vector<rx::Value> values;
            for (const auto &a : args) values.push_back(a ? *a : rx::omittedArgument());
            return interpreterSend(st, method.first, values);
        }
        return constantValue(info.definingClass, method.first);
    }
    auto obj = st->at(info.definingClass);
    std::lock_guard<ScopeLock> hold(obj->scope_lock);
    NativeFrame frame(st, info.definingClass, args);
    StateScope current(st.get());
    rx::noResultPending() = false;
#ifdef RX2CPP_HOST_API
    rx::Value result = rx::Value::string(std::string());
    try { result = obj->invokeValues(method.first, args); }
    catch (const rx::RaiseToCaller &r) { rx::noResultPending() = false; return rx::raisedInCaller(r); }
#else
    rx::Value result = obj->invokeValues(method.first, args);
#endif
    const bool noValue = std::exchange(rx::noResultPending(), false);
    if (info.noResult || noValue) return std::nullopt;
    return result;
}
/* A class of this library changed at run time (DEFINE, DELETE, INHERIT, UNINHERIT sent by compiled code): instances
   made from then on take their methods from the interpreter (an object's methods are fixed when it is created, so
   existing instances keep direct dispatch). */
std::atomic<bool> &classesChanged() { static std::atomic<bool> changed{false}; return changed; }
// RX2CPP_BIF_STATS: why NEW of a class of this library went to the interpreter
void rx2cpp_class_stat(const std::string &name) {
    rxobj::bifStat("class NEW by the interpreter: " + name + (classesChanged() ? " (classes changed)" : "") +
                   (directNewTable().count(name) ? "" : " (not direct)"));
}
class NativeClassObj final : public rx::NativeRefBase {
    std::string name_;
    std::shared_ptr<rx::EnvObject> interpreterClass_;
    rx::EnvObject &iclass() {
        if (!interpreterClass_) {
            void *h = rxobj::findClass(name_);
            if (!h) throw std::runtime_error("unknown class ." + name_);
            interpreterClass_ = std::make_shared<rx::EnvObject>(h);
        }
        return *interpreterClass_;
    }
public:
    explicit NativeClassObj(std::string n) : name_(std::move(n)) {}
    // As an argument to an interpreter message (x~isA(.Cls)) the class is the interpreter's class object.
    void *materialize() override { return iclass().handle; }
    rx::MessageResult sendMessage(const std::string &selector, const std::vector<rx::Value> &args) override {
        static const CiEq same;
        if (same(selector, "DEFINE") || same(selector, "DELETE") || same(selector, "INHERIT") || same(selector, "UNINHERIT"))
            classesChanged() = true;
        if (same(selector, "NEW") && args.empty() && !classesChanged() && arrayNewTable().count(name_)) {
            // .Array's NEW without arguments, then INIT, which for this class does nothing (arrayNewTable: no INIT of
            // its own): the instance with an empty native array part, made without its interpreter object
            auto st = std::make_shared<InstanceState>();
            st->dynamicClass = name_;
            st->exact = true;
            st->builtin = std::make_shared<rx::NativeArray>(0, false);
            trackState(st);
            return rx::Value::fromObject(std::make_shared<NativeInstanceRef>(st));
        }
        if (same(selector, "NEW") && !classesChanged() && directNewTable().count(name_)) {
            auto st = std::make_shared<InstanceState>();
            st->dynamicClass = name_;
            st->exact = true;
            trackState(st);
            Resolved *init = lookupMethod(name_, "INIT");
            if (!init) throw std::runtime_error("native class without INIT: " + name_);
            runNative(st, *init, optionalsOf(args));
            return rx::Value::fromObject(std::make_shared<NativeInstanceRef>(st));
        }
        // cls~sendWith('NEW', array) and cls~send('NEW', ...): Object's SENDWITH / SEND send that message with those
        // arguments (RexxObject::sendWith): the NEW above, natively, when nothing is omitted (the Rexx Parser makes its
        // expressions so: .Comparison.Expression~sendWith('new', ...)).
        if (!classesChanged() && !args.empty() && !args[0].isObject() && same(args[0].bytes.str(), "NEW") &&
            (same(selector, "SEND") || (same(selector, "SENDWITH") && args.size() == 2))) {
            std::vector<rx::Value> newArgs;
            bool plain = true;
            if (same(selector, "SEND")) newArgs.assign(args.begin() + 1, args.end());
            else if (auto *a = args[1].isObject() ? dynamic_cast<rx::NativeArray *>(args[1].object.get()) : nullptr; a && !a->real) {
                for (const auto &slot : a->slots) { if (!slot) { plain = false; break; } newArgs.push_back(*slot); }
            } else plain = false;
            if (plain) return sendMessage("NEW", newArgs);
        }
        if (same(selector, "NEW")) rx2cpp_class_stat(name_);
        return iclass().sendMessage(selector, args);
    }
    rx::Value sendBinary(const std::string &selector, const rx::Value &rhs) override {
        // a class object compared with a class object: the Class class's comparisons are identity (x~class == .Foo)
        const bool positive = selector == "==" || selector == "=";
        if (positive || selector == "\\==" || selector == "\\=" || selector == "<>" || selector == "><") {
            bool known = false, same = false;
            if (auto *other = dynamic_cast<NativeClassObj *>(rhs.object.get())) { known = true; same = other->name_ == name_; }
            else if (auto *env = dynamic_cast<rx::EnvObject *>(rhs.object.get())) { if (env->handle) { known = true; same = env->handle == iclass().handle; } }
            if (known) return rx::Value::string(same == positive ? "1" : "0");
        }
        return iclass().sendBinary(selector, rhs);
    }
    rx::Value sendUnary(const std::string &selector) override { return iclass().sendUnary(selector); }
    std::string display() const override { return const_cast<NativeClassObj *>(this)->iclass().display(); }
};
rx::Value nativeClassValue(const std::string &name) { return rx::Value::fromObject(std::make_shared<NativeClassObj>(name)); }
std::optional<rx::Value> packageClassImpl(const std::string &name) {
    const std::string up = upperOf(name);
    if (!directNewTable().count(up) && !arrayNewTable().count(up)) return std::nullopt;
    return rx::Value::fromObject(std::make_shared<NativeClassObj>(up));
}
/* This library's class objects that compiled code may instantiate directly (directNewTable), by interpreter handle. */
const std::unordered_map<void *, std::string> &classByHandle() {
    static thread_local std::unordered_map<void *, std::string> table;
    static thread_local bool filled = false;
    if (!filled) {
        filled = true;
        for (const auto &name : directNewTable())
            if (void *h = rxobj::findClass(name)) table.emplace(h, name);   // class objects live as long as the interpreter
        for (const auto &name : arrayNewTable())
            if (void *h = rxobj::findClass(name)) table.emplace(h, name);
    }
    return table;
}
std::optional<rx::Value> adoptClass(void *handle) {
    const auto &classes = classByHandle();
    auto it = classes.find(handle);
    if (it == classes.end()) return std::nullopt;
    return rx::Value::fromObject(std::make_shared<NativeClassObj>(it->second));
}
/* A condition left pending in the interpreter by a compiled self send (PendingCondition): taken for a SIGNAL ON trap. */
std::shared_ptr<rx::ObjectDispatch> pendingConditionImpl(const std::exception &e) {
    if (!dynamic_cast<const PendingCondition *>(&e)) return nullptr;
    RexxThreadContext *t = rxobj::need();
    if (!t->CheckCondition()) return nullptr;
    rxobj::keepCondition(t);
    t->ClearCondition();
    return rx::takeKeptCondition();
}
std::optional<rx::Value> adoptImpl(void *globalRef) {
    auto st = stateOfObject(globalRef);
    if (st && st->alive && st->exact && st->handle == globalRef) {
        // (a disposable state: its interpreter object need not stay, so its reference is dropped: compiled code holds the
        // native state, as for an instance it made itself)
        if (stateDisposable(*st)) { rxobj::release(globalRef); return rx::Value::fromObject(std::make_shared<NativeInstanceRef>(st)); }
        return rx::Value::fromObject(std::make_shared<NativeInstanceRef>(st, std::make_shared<rx::EnvObject>(globalRef)));
    }
    if (auto cls = adoptClass(globalRef)) { rxobj::release(globalRef); return cls; }
    return std::nullopt;
}
std::optional<rx::Value> selfObjectImpl() {
    if (!currentState) return std::nullopt;
    // SELF in a CLASS method is the receiving class object itself (a subclass, for an inherited class method).
    if (currentState->classSide && currentState->handle)
        if (auto cls = adoptClass(currentState->handle)) return cls;
    return rx::Value::fromObject(std::make_shared<NativeInstanceRef>(currentState->shared_from_this()));
}
std::string dynamicClassOf(RexxMethodContext *ctx, RexxObjectPtr self) {
    RexxObjectPtr cls = ctx->SendMessage0(self, "CLASS");
    RexxObjectPtr id = cls == NULLOBJECT ? NULLOBJECT : ctx->SendMessage0(cls, "ID");
    if (id == NULLOBJECT) return std::string();
    return upperOf(ctx->ObjectToStringValue(id));
}
[[maybe_unused]] const bool hooksInstalled = (rx::packageClassHook = &packageClassImpl, rx::selfObjectHook = &selfObjectImpl,
                                              rx::adoptHook = &adoptImpl, rx::pendingConditionHook = &pendingConditionImpl, true);
}
/* A state whose interpreter object holds nothing of its own: an instance of a class of this library whose state is all
   native (directNewTable: compiled methods only, no interpreter parent or mixin, no NEW of its own) and without an
   UNINIT method (which runs when the interpreter collects the object). */
bool stateDisposable(InstanceState &st) {
    if (st.disposable < 0)
        st.disposable = (st.exact && !st.classSide && directNewTable().count(st.dynamicClass) > 0 &&
                         !lookupMethod(st.dynamicClass, "UNINIT") && !lookupMethod(st.dynamicClass, "RX2CPP_USER_UNINIT")) ? 1 : 0;
    return st.disposable == 1 && !classesChanged();
}
/* A state's interpreter object, watched through a WeakReference (InstanceState::weak): the state is released when the
   interpreter has collected the object (proxyLive, and the sweep at each cycle collection). A class with a user UNINIT
   releases it from its UNINIT instead (rx_native_uninit), and a class object lives as long as the interpreter. */
void watchProxy(InstanceState &st) {
    if (st.weak || !st.handle || st.classSide) return;
    RexxThreadContext *t = rxobj::need();
    // (an instance of an interpreter subclass is asked: the user UNINIT may be inherited from a compiled class)
    if (st.exact ? lookupMethod(st.dynamicClass, "RX2CPP_USER_UNINIT") != nullptr
                 : t->HasMethod((RexxObjectPtr)st.handle, "RX2CPP_USER_UNINIT") != 0) return;
    static RexxObjectPtr weakClass = NULLOBJECT;
    if (weakClass == NULLOBJECT) {
        weakClass = (RexxObjectPtr)t->FindClass("WEAKREFERENCE");
        if (weakClass == NULLOBJECT) { t->ClearCondition(); return; }
        rxobj::pinRef(t, weakClass);
    }
    RexxObjectPtr w = t->SendMessage1(weakClass, "NEW", (RexxObjectPtr)st.handle);
    if (t->CheckCondition() || w == NULLOBJECT) { t->ClearCondition(); return; }
    st.weak = (void *)rxobj::pinRef(t, w);
    t->ReleaseLocalReference(w);
}
/* Whether the state's interpreter object is still the interpreter's: for a watched (disposable) state, its
   WeakReference still refers to it. One the interpreter has found unreachable (its UNINIT may not have run yet) is
   given up here: the state is detached from it, and the next use makes a new one. */
bool proxyLive(InstanceState &st) {
    if (!st.alive || !st.handle) return false;
    if (!st.weak || st.pin) return true;   // (a pinned object is not collected)
    RexxThreadContext *t = rxobj::need();
    RexxObjectPtr v = t->SendMessage0((RexxObjectPtr)st.weak, "VALUE");
    if (t->CheckCondition()) { t->ClearCondition(); return true; }
    const bool live = v == (RexxObjectPtr)st.handle;
    if (v != NULLOBJECT) t->ReleaseLocalReference(v);
    if (live) return true;
    InstanceTable::instance().unbind(st.handle);
    if (!st.token.empty()) InstanceTable::instance().remove(st.token);   // (its UNINIT then finds no state)
    st.token.clear();
    st.alive = false; st.handle = nullptr;
    rxobj::unpinLater(st.weak); st.weak = nullptr;
    return false;
}
/* The native state of an interpreter object, by its address: none when the state's own object was collected (its
   WeakReference cleared) and the address now belongs to another object. (Without an UNINIT, nothing unbinds a collected
   object's address at once.) */
std::shared_ptr<InstanceState> stateOfObject(void *handle) {
    auto st = InstanceTable::instance().byHandle(handle);
    if (st && (st->handle != handle || !proxyLive(*st))) return nullptr;
    return st;
}
/* Cycle collection. Compiled code's references are counted (std::shared_ptr), so native instances that refer to each
   other (a doubly linked list, a parent and its children) are never freed by counting alone. The collector finds them
   as CPython's does: for every native state and container reachable from one, the references that come from other
   states or containers are subtracted from its count; what is left over is held from outside (a running method, a
   local variable, the interpreter through the state's object): those are live, with everything reachable from them.
   The rest is unreachable: its references are dropped, which frees it. Runs only while this thread is the one thread
   in compiled code (rxobj::exclusiveNative), when enough states have been made since the last collection. */
namespace {
void collectCycles() {
    std::vector<std::shared_ptr<InstanceState>> states = InstanceTable::instance().liveStates();
    // states whose interpreter object the interpreter no longer has (collected by the interpreter collection just
    // requested, trackState) are given up first: that object no longer holds them
    for (const auto &st : states) if (st->alive && st->handle && st->weak) proxyLive(*st);
    struct Node { long refs = 0; bool live = false; InstanceState *state = nullptr; std::weak_ptr<rx::ObjectDispatch> object; };
    std::unordered_map<const void *, Node> nodes;
    nodes.reserve(states.size() * 2);
    std::vector<const void *> order;
    // the containers a value refers to that the collector follows: native instances' references, arrays, directories,
    // stems (anything else (a string, an interpreter object) refers to nothing native)
    auto followed = [](const rx::ObjectDispatch *o) {
        return dynamic_cast<const NativeInstanceRef *>(o) || dynamic_cast<const rx::NativeArray *>(o) ||
               dynamic_cast<const rx::NativeDirectory *>(o) || dynamic_cast<const rx::StemObject *>(o);
    };
    std::size_t proxied = 0, running = 0, kept = 0;
    for (const auto &st : states) {
        Node &n = nodes[st.get()];
        n.state = st.get();
        n.refs = static_cast<long>(st.use_count()) - 1;   // (less this list's own)
        // a scope in use (a method running) or a state that must keep its interpreter object: live
        bool inUse = false;
        for (const auto &scope : st->scopes) if (scope.second.use_count() > 1) inUse = true;
        if (inUse) { n.refs += 1; ++running; }
        // (an instance of an Array subclass made natively (arrayNewTable) has no interpreter object until one is
        // needed: its contents are all native, so only an interpreter object of its own makes it held from outside)
        const bool nativeOnly = st->builtin && !st->classSide && !(st->alive && st->handle);
        if (!nativeOnly && !stateDisposable(*st)) { n.refs += 1; ++kept; }
        if (st->alive && st->handle) ++proxied;
        order.push_back(st.get());
    }
    // edges: each reference held by a state or container is one count of what it refers to
    std::vector<const void *> pending(order.begin(), order.end());
    auto edgesOf = [&](const void *key, const std::function<void(const void *)> &edge) {
        Node &n = nodes[key];
        auto onValue = [&](const rx::Value &v) {
            if (!v.isObject() || !followed(v.object.get())) return;
            const void *child = v.object.get();
            auto it = nodes.find(child);
            if (it == nodes.end()) {
                Node c; c.refs = static_cast<long>(v.object.use_count()); c.object = v.object;
                nodes.emplace(child, std::move(c));
                pending.push_back(child);
            }
            edge(child);
        };
        if (n.state) {
            for (const auto &scope : n.state->scopes) scope.second->gcFields(onValue);
            if (n.state->builtin) n.state->builtin->gcValues(onValue);
            return;
        }
        auto o = n.object.lock();
        if (!o) return;
        if (auto *ref = dynamic_cast<NativeInstanceRef *>(o.get())) {
            const void *child = ref->stateRef().get();
            if (nodes.count(child)) edge(child);   // (every state is a node; one made during the collection is not)
            return;
        }
        o->gcValues(onValue);
    };
    for (std::size_t i = 0; i < pending.size(); i++) {
        const void *key = pending[i];
        edgesOf(key, [&](const void *child) { nodes[child].refs -= 1; });
    }
    // live: held from outside, and everything reachable from it
    std::vector<const void *> stack;
    for (const void *key : pending) { Node &n = nodes[key]; if (n.refs > 0 && !n.live) { n.live = true; stack.push_back(key); } }
    while (!stack.empty()) {
        const void *key = stack.back(); stack.pop_back();
        edgesOf(key, [&](const void *child) { Node &c = nodes[child]; if (!c.live) { c.live = true; stack.push_back(child); } });
    }
    // the rest: dropped (held here while their references go, so none is freed under the loop)
    std::vector<std::shared_ptr<InstanceState>> deadStates;
    std::vector<std::shared_ptr<rx::ObjectDispatch>> deadObjects;
    for (const auto &st : states) if (!nodes[st.get()].live) deadStates.push_back(st);
    for (const void *key : pending) {
        Node &n = nodes[key];
        if (n.live || n.state) continue;
        if (auto o = n.object.lock()) deadObjects.push_back(std::move(o));
    }
    const std::size_t survivors = states.size() - deadStates.size();
    if (const char *d = std::getenv("RX2CPP_GC_STATS")) if (d[0] == '2')
        for (const auto &st : deadStates)
            std::fprintf(stderr, "rx2cpp collect: freed %s%s (references %ld)\n", st->dynamicClass.c_str(), st->classSide ? " class" : "",
                         static_cast<long>(st.use_count()));
    states.clear();
    for (const auto &st : deadStates) {
        for (const auto &scope : st->scopes) scope.second->gcClear();
        if (st->builtin) st->builtin->gcClear();
    }
    for (const auto &o : deadObjects) o->gcClear();
    if (std::getenv("RX2CPP_GC_STATS")) {
        std::size_t held = 0;   // held from outside compiled objects and containers (after the subtraction)
        for (const void *key : order) if (nodes[key].refs > 0) ++held;
        std::fprintf(stderr, "rx2cpp collect: %zu states live, %zu freed, %zu containers freed (held from outside %zu: "
                     "with an interpreter object %zu, running %zu, kept by class %zu)\n",
                     survivors, deadStates.size(), deadObjects.size(), held, proxied, running, kept);
    }
    deadObjects.clear();
    deadStates.clear();
    InstanceTable::instance().collected(survivors);
}
}
/* A native state was made: known to the collector, which runs when enough have been made. */
void trackState(const std::shared_ptr<InstanceState> &st) {
    if (InstanceTable::instance().track(st)) {
        // the interpreter collects first (its unreachable objects of native states clear their WeakReferences): the
        // interpreter does not see the memory compiled objects hold, so it may not have collected for a long time
        if (rx::collectHook()) rx::collectHook()();
        if (!rxobj::exclusiveNative([] { collectCycles(); })) InstanceTable::instance().collected(0);
    }
}
#endif
namespace {
// The objects whose lock for a compiled class's scope this thread holds through a running guarded compiled method. The
// stub of a method with REPLY asks (RX2CPP_HOLDS): when its caller holds the lock (a nested call) the method must not
// lock again on its own activity before the reply (it would wait for the caller, which waits for the reply).
thread_local std::vector<std::pair<RexxObjectPtr, std::string>> heldLocks;
struct HeldLock {
    bool on = false;
    void hold(RexxObjectPtr object, const std::string &scope) {
        if (on) return;
        heldLocks.emplace_back(object, scope);
        on = true;
    }
    void drop() { if (on && !heldLocks.empty()) heldLocks.pop_back(); on = false; }
    ~HeldLock() { drop(); }
};
class Frame final : public SelfSender {
    RexxMethodContext *ctx_; RexxObjectPtr self_; ScopeLock &lock_; SelfSender *previous_;
    std::shared_ptr<InstanceState> state_; std::string className_;
    HeldLock *held_ = nullptr;
    std::unique_lock<ScopeLock> *pendingScope_ = nullptr;
    bool guardHeld_ = false;   // a method with GUARD: whether it holds the object's lock now (RexxActivation objectScope)
public:
    // GUARD ON / OFF (only when the state changes); the compiled scope lock goes while it waits for the object's lock.
    void guardSet(bool on) {
        if (on == guardHeld_) return;
        if (on) {
            { ReleaseAndReacquire released(lock_); viaInterpreter([&] { ctx_->SetGuardOn(); }); }
            if (held_) held_->hold(self_, className_);
        } else {
            viaInterpreter([&] { ctx_->SetGuardOff(); });
            if (held_) held_->drop();
        }
        guardHeld_ = on;
    }
    // GUARD WHEN, expression false: wait for a change, the object's lock let go meanwhile (RexxActivation::guardWait).
    void guardWait() {
        const bool had = guardHeld_;
        if (had) guardSet(false);
        lock_.waitForChange();
        if (had) guardSet(true);
    }
    void setHeld(HeldLock *held) { held_ = held; }
    void setPendingScope(std::unique_lock<ScopeLock> *scope) { pendingScope_ = scope; }
    Frame(RexxMethodContext *c, RexxObjectPtr s, ScopeLock &l, std::shared_ptr<InstanceState> st, std::string cls)
        : ctx_(c), self_(s), lock_(l), previous_(detail::currentSender), state_(std::move(st)), className_(std::move(cls)) { detail::currentSender = this; }
    ~Frame() override { detail::currentSender = previous_; }
    // After a REPLY: a guarded method takes the object's lock on this activity (the compiled scope lock goes while it
    // waits: the activity that holds the object's lock may be waiting for it); a method that ran under its caller's
    // locks (a nested call) takes the compiled scope lock.
    void afterReply(bool guarded) {
        if (guarded) {
            { ReleaseAndReacquire released(lock_); viaInterpreter([&] { ctx_->SetGuardOn(); }); }
            if (held_) held_->hold(self_, className_);
        }
        if (pendingScope_) { pendingScope_->lock(); pendingScope_ = nullptr; }
    }
    std::string forward(const std::string &selector) override {
        RexxObjectPtr result;
        { ReleaseAndReacquire released(lock_);
          result = viaInterpreter([&] { return ctx_->ForwardMessage(self_, selector.c_str(), NULLOBJECT, ctx_->GetArguments()); }); }
        if (ctx_->CheckCondition()) throw PendingCondition();
        if (result == NULLOBJECT)
            throw std::runtime_error("FORWARD returned no scalar result");
        return stringValue(ctx_, result);
    }
#ifdef RX2CPP_HOST_API
    std::optional<rx::Value> forwardValues(const std::string &selector) override {
        RexxObjectPtr result;
        { ReleaseAndReacquire released(lock_);
          result = viaInterpreter([&] { return ctx_->ForwardMessage(self_, selector.c_str(), NULLOBJECT, ctx_->GetArguments()); }); }
        if (ctx_->CheckCondition()) throw PendingCondition();
        if (result == NULLOBJECT) return std::nullopt;
        if (rxobj::isPlainString(ctx_->threadContext, result)) return rx::Value::string(stringValue(ctx_, result));
        return rx::EnvObject::adopt((void *)rxobj::pinRef(ctx_->threadContext, result));
    }
    std::optional<rx::Value> sendValues(const std::string &selector, const std::vector<rx::Value> &args) override {
        if (state_ && state_->exact) {
            std::optional<rx::Value> out;
            if (nativeSelfSend(state_, className_, selector, args, out)) return out;
        }
        // SELF~NEW in a CLASS method: the receiving class object itself (a subclass for an inherited class method) makes
        // the instance; for a class compiled code may instantiate, that runs natively.
        if (state_ && state_->classSide) {
            static const CiEq same;
            if (same(selector, "NEW"))
                if (auto cls = adoptClass((void *)self_)) return cls->object->sendMessage("NEW", args);
        }
        std::vector<rxobj::Arg> in; rx::EnvObject::convert(args, in);
        // A self send can run many times inside one native call: release every local reference it makes.
        rxobj::LocalRefs temps(ctx_->threadContext);
        RexxArrayObject arr = (RexxArrayObject)temps((RexxObjectPtr)ctx_->NewArray(in.size()));
        for (std::size_t i = 0; i < in.size(); i++) {
            if (in[i].omitted) continue;
            ctx_->ArrayPut(arr, in[i].obj ? (RexxObjectPtr)in[i].obj : temps((RexxObjectPtr)ctx_->NewString(in[i].bytes.data(), in[i].bytes.size())), i + 1);
        }
        RexxObjectPtr result;
        { ReleaseAndReacquire released(lock_); result = ctx_->SendMessage(self_, selector.c_str(), arr); }
        if (ctx_->CheckCondition()) throw PendingCondition();
        if (result == NULLOBJECT) return std::nullopt;
        temps(result);
        if (rxobj::isPlainString(ctx_->threadContext, result)) return rx::Value::string(stringValue(ctx_, result));
        return rx::EnvObject::adopt((void *)rxobj::pinRef(ctx_->threadContext, result));
    }
#endif
    std::string send(const std::string &selector, const std::vector<std::string> &args) override {
        RexxArrayObject arr = ctx_->NewArray(args.size());
        for (const auto &a : args) ctx_->ArrayAppendString(arr, a.data(), a.size());
        RexxObjectPtr result;
        { ReleaseAndReacquire released(lock_); result = ctx_->SendMessage(self_, selector.c_str(), arr); }
        if (ctx_->CheckCondition()) throw PendingCondition();
        if (result == NULLOBJECT) throw std::runtime_error("SELF~" + selector + " returned no value");
        return stringValue(ctx_, result);
    }
};
}
#ifdef RX2CPP_HOST_API
namespace {
void guardImpl(int op) {
    auto *f = dynamic_cast<Frame *>(detail::currentSender);
    if (!f) throw std::runtime_error("GUARD outside a native method entry");
    if (op == 2) f->guardWait();
    else f->guardSet(op == 1);
}
[[maybe_unused]] const bool guardInstalled = (rx::guardHook() = &guardImpl, true);
void replyLocksImpl(bool guarded) { if (auto *f = dynamic_cast<Frame *>(detail::currentSender)) f->afterReply(guarded); }
[[maybe_unused]] const bool replyLocksInstalled = (rx::replyLocksHook() = &replyLocksImpl, true);
}
#endif
static RexxObjectPtr call(RexxMethodContext *ctx, RexxArrayObject args, RexxObjectPtr selfObj,
                          const std::string &className, const std::string &selector,
                          bool initializer, bool attributeSetter, int scopeIndex, bool isRoot, const std::string &rootClass, bool classSide,
                          int guardMode) {
    (void)scopeIndex;
    std::string failedInitToken;   // an INIT that throws must not leave its object registered
    try {
#ifdef RX2CPP_HOST_API
        rxobj::Scope hostScope(ctx->threadContext, selfObj);
#endif
        const size_t count = ctx->ArraySize(args);
        std::shared_ptr<InstanceState> state;
        std::string token;
        auto setRootToken = [&](const std::string &value) {
            if (isRoot) { ctx->SetObjectVariable("RX2CPP_NATIVE_ID", ctx->String(value.c_str())); return; }
            auto definingRoot = ctx->FindClass(rootClass.c_str());
            if (definingRoot == NULLOBJECT) throw std::runtime_error("compiled superclass missing: " + rootClass);
            RexxArrayObject tokenArgs = ctx->NewArray(1);
            ctx->ArrayAppend(tokenArgs, ctx->String(value.c_str()));
            viaInterpreter([&] { return ctx->ForwardMessage(ctx->GetSelf(), "RX2CPP_NATIVE_SETTOKEN", definingRoot, tokenArgs); });
            if (ctx->CheckCondition()) throw PendingCondition();
        };
        if (initializer) {
#ifdef RX2CPP_HOST_API
            if (pendingAdopt) {
                // An interpreter object is being made for a native state: adopt it; the INIT body already ran natively.
                state = std::move(pendingAdopt);
                pendingAdopt.reset();
                token = InstanceTable::instance().add(state);
                failedInitToken = token;
                state->token = token;
                state->handle = (void *)selfObj;
                state->alive = true;
                if (!classSide) InstanceTable::instance().bind(state->handle, state);
                setRootToken(token);
                watchProxy(*state);
                failedInitToken.clear();
                return NULLOBJECT;
            }
#endif
            RexxObjectPtr existing = ctx->GetObjectVariable("RX2CPP_NATIVE_ID");
            if (!isRoot) {
                // A derived INIT starts the object: the state is created (the root scope's own INIT runs only if this INIT
                // sends INIT:SUPER, exactly as in the interpreter), then this class's scope runs the body. Object variables
                // are per class scope, so the token is read and written through the root class's own accessors.
                auto definingRoot = ctx->FindClass(rootClass.c_str());
                if (definingRoot == NULLOBJECT) throw std::runtime_error("compiled superclass missing: " + rootClass);
                RexxObjectPtr rootToken = viaInterpreter([&] { return ctx->ForwardMessage(ctx->GetSelf(), "RX2CPP_NATIVE_TOKEN", definingRoot, ctx->NewArray(0)); });
                if (ctx->CheckCondition()) throw PendingCondition();
                if (rootToken != NULLOBJECT) {
                    // INIT:SUPER (or FORWARD CLASS (SUPER)) from a further-derived INIT, or INIT sent again: the object
                    // already has its state; this scope's INIT body runs on it, as in the interpreter.
                    token = stringValue(ctx, rootToken);
                    state = InstanceTable::instance().find(token);
                    if (!state) throw std::runtime_error("expired native object handle");
                }
            } else if (existing != NULLOBJECT) {
                // INIT:SUPER from a derived INIT: the state was registered by the derived class.
                token = stringValue(ctx, existing);
                state = InstanceTable::instance().find(token);
                if (!state) throw std::runtime_error("expired native object handle");
            } else if (!classSide) {
                // A mixin of an interpreter class (its own native root) whose INIT runs for an object another root's
                // INIT has registered already: one state, this scope added to it.
                state = stateOfObject((void *)selfObj);
                if (state) { token = state->token; setRootToken(token); }
            }
            if (!state) {
                state = std::make_shared<InstanceState>();
#ifdef RX2CPP_HOST_API
                state->dynamicClass = classSide ? className : dynamicClassOf(ctx, selfObj);
                state->classSide = classSide;
                state->exact = !classSide && directMethodTable().count(state->dynamicClass) > 0 && !classesChanged();
#endif
                state->handle = (void *)selfObj;
                state->alive = true;
                if (!classSide) InstanceTable::instance().bind(state->handle, state);
                // Register before the body runs: INIT may send messages (SELF~attr = ...) that arrive in this object.
                token = InstanceTable::instance().add(state);
                state->token = token;
                failedInitToken = token;
                setRootToken(token);
#ifdef RX2CPP_HOST_API
                trackState(state);
                watchProxy(*state);
#endif
            }
        } else {
            // The root class owns the single lifetime token. A derived method asks the root method for it; normal ooRexx
            // dispatch chooses that root implementation, and the derived method uses its own scope.
            RexxObjectPtr old = NULLOBJECT;
            if (isRoot) old = ctx->GetObjectVariable("RX2CPP_NATIVE_ID");
            else {
                auto definingRoot = ctx->FindClass(rootClass.c_str());
                if (definingRoot == NULLOBJECT)
                    throw std::runtime_error("compiled superclass missing: " + rootClass);
                // Explicit scope-directed message dispatch, bypassing a possible subclass override of the internal accessor.
                old = viaInterpreter([&] { return ctx->ForwardMessage(ctx->GetSelf(), "RX2CPP_NATIVE_TOKEN", definingRoot, ctx->NewArray(0)); });
            }
            if (old == NULLOBJECT && classSide && isRoot) {
                // The class object has no native state until its first CLASS method runs (no INIT CLASS declared).
                state = std::make_shared<InstanceState>();
                state->dynamicClass = className;
                state->classSide = true;
                state->handle = (void *)selfObj;
                state->alive = true;
                token = InstanceTable::instance().add(state);
                state->token = token;
                ctx->SetObjectVariable("RX2CPP_NATIVE_ID", ctx->String(token.c_str()));
            } else if (old == NULLOBJECT && isRoot && !classSide && !ctx->CheckCondition()) {
                // A mixin of an interpreter class (its own native root) inherited by a class of another root (or an
                // interpreted class): the object's state, registered by its own root, gets this scope; an object with
                // none gets one here (its INIT was not this root's).
                state = stateOfObject((void *)selfObj);
                if (!state) {
                    state = std::make_shared<InstanceState>();
#ifdef RX2CPP_HOST_API
                    state->dynamicClass = dynamicClassOf(ctx, selfObj);
                    state->classSide = false;
                    state->exact = false;
#endif
                    state->handle = (void *)selfObj;
                    state->alive = true;
                    InstanceTable::instance().bind(state->handle, state);
                    state->token = InstanceTable::instance().add(state);
#ifdef RX2CPP_HOST_API
                    trackState(state);
#endif
                }
                token = state->token;
                setRootToken(token);
            } else {
                if (old == NULLOBJECT || ctx->CheckCondition()) {
                    // (which object and why: a missing token, or a condition raised while reading it)
                    std::string why = old == NULLOBJECT ? "no token" : "condition pending";
                    if (ctx->CheckCondition()) {
                        RexxCondition cd; ctx->DecodeConditionInfo(ctx->GetConditionInfo(), &cd);
                        why += " (condition " + std::to_string(cd.code) + ")";
                    }
                    throw std::runtime_error("native object not initialized or root token inaccessible: " + className + " " +
                                             selector + (isRoot ? " root" : " derived from " + rootClass) + ", " + why);
                }
                token = stringValue(ctx, old);
                state = InstanceTable::instance().find(token);
            }
            if (!state) throw std::runtime_error("expired native object handle");
        }
        std::shared_ptr<CompiledObject> object = state->at(className);
        // guardMode 1: a guarded method (the interpreter locked the object for it); 2 / 3: an unguarded / guarded
        // method with REPLY: its reply box says whether its stub locked the object for it (a guarded method whose
        // caller does not hold the lock) and whether the caller holds the object's locks (a nested call: the method
        // runs under them until the reply, then takes its own, rx::replyInstruction).
        // guardMode: bit 1 guarded, bit 2 REPLY, bit 4 GUARD statements (the method manages its lock: declared
        // UNGUARDED, a guarded one takes the lock here).
        const bool guardedMethod = guardMode & 1, replyMethod = guardMode & 2, managedGuard = (guardMode & 4) && !replyMethod;
        logical_t locked = 0, nested = 0;
        if (replyMethod && count > 0) {
            RexxObjectPtr box = ctx->ArrayAt(args, count);
            if (box != NULLOBJECT) {
                RexxObjectPtr answer = ctx->SendMessage0(box, "LOCKED");
                if (ctx->CheckCondition()) throw PendingCondition();
                if (answer != NULLOBJECT) ctx->threadContext->Logical(answer, &locked);
                answer = ctx->SendMessage0(box, "NESTED");
                if (ctx->CheckCondition()) throw PendingCondition();
                if (answer != NULLOBJECT) ctx->threadContext->Logical(answer, &nested);
            }
        }
        std::unique_lock<ScopeLock> scopeHold(object->scope_lock, std::defer_lock);
        if (!nested) scopeHold.lock();
        Frame frame(ctx, selfObj, object->scope_lock, state, className);
        if (nested) frame.setPendingScope(&scopeHold);
        HeldLock held;
        frame.setHeld(&held);
        if (managedGuard) { if (guardedMethod) frame.guardSet(true); }
        else if ((guardedMethod && !replyMethod) || locked) held.hold(selfObj, className);
#ifdef RX2CPP_HOST_API
        StateScope currentScope(state->exact ? state.get() : nullptr);
#endif
        std::vector<std::optional<rx::Value>> positional;
        positional.reserve(count);
        for (size_t i = 1; i <= count; ++i) {
            RexxObjectPtr item = ctx->ArrayAt(args, i);
            if (item == NULLOBJECT) { positional.emplace_back(std::nullopt); continue; }
#ifdef RX2CPP_HOST_API
            // Strings stay scalar values; every other interpreter object is passed as itself (no marshalling).
            if (!rxobj::isPlainString(ctx->threadContext, item))
                positional.emplace_back(rx::EnvObject::adopt((void *)rxobj::pinRef(ctx->threadContext, item)));
            else
#endif
            positional.emplace_back(rx::Value::string(stringValue(ctx, item)));
        }
        rx::noResultPending() = false;
        rx::Value outcome = object->invokeValues(selector, positional);
        const bool noValue = std::exchange(rx::noResultPending(), false);
        // Generated ::ATTRIBUTE setters have no result; ordinary methods with
        // selectors ending in = (including []=) may explicitly RETURN a value.
        if (attributeSetter) return NULLOBJECT;
        if (initializer) {
            failedInitToken.clear();
            return NULLOBJECT; // ooRexx INIT must not return an ordinary value
        }
        if (noValue) return NULLOBJECT;   // ended without a result (see rx::noResult)
        if (outcome.isObject()) {
#ifdef RX2CPP_HOST_API
            if (auto *env = dynamic_cast<rx::EnvObject *>(outcome.object.get())) return (RexxObjectPtr)env->handle;
            if (dynamic_cast<rx::NilObject *>(outcome.object.get())) return ctx->Nil();
            if (auto *ref = dynamic_cast<rx::NativeRefBase *>(outcome.object.get())) return (RexxObjectPtr)rxobj::returnPin(ref->materialize());
            // a stem (RETURN s. / an exposed stem): the interpreter's stem object shared with it
            if (auto *st = dynamic_cast<rx::StemObject *>(outcome.object.get())) return (RexxObjectPtr)rx::EnvObject::stemHandle(*st);
#endif
            throw std::runtime_error(std::string("native method returned an object that the interpreter cannot receive (") +
                                     typeid(*outcome.object).name() + ")");
        }
        return ctx->NewString(outcome.bytes.data(), outcome.bytes.size());
    } catch (const PendingCondition &) {
        if (!failedInitToken.empty()) InstanceTable::instance().remove(failedInitToken);
        return NULLOBJECT;
    } catch (const rx::SyntaxCondition &e) {
        if (!failedInitToken.empty()) InstanceTable::instance().remove(failedInitToken);
        raiseSyntaxIn(ctx->threadContext, e);
        return NULLOBJECT;
    } catch (const rx::NoMethod &e) {
        if (!failedInitToken.empty()) InstanceTable::instance().remove(failedInitToken);
        if (!raiseNoMethodIn(ctx->threadContext, e)) report(ctx, e.what());
        return NULLOBJECT;
#ifdef RX2CPP_HOST_API
    } catch (const rx::RaiseToCaller &r) {
        rxobj::Scope raiseScope(ctx->threadContext);   // the entry's scope has ended: the raise needs the interpreter
        rx::raiseToCaller(r);
        return NULLOBJECT;
#endif
    } catch (const std::exception &e) {
        if (!failedInitToken.empty()) InstanceTable::instance().remove(failedInitToken);
        report(ctx, e.what());
        return NULLOBJECT;
    }
}
}

[[maybe_unused]] static std::string rx2cpp_routine_string(RexxCallContext *ctx, RexxObjectPtr object) {
    if (object == NULLOBJECT || !(ctx->IsString(object) || ctx->IsOfType(object, "STRING")))
        throw std::runtime_error("native routine accepts only ooRexx String scalar values");
    auto s = ctx->ObjectToString(object);
    return std::string(ctx->StringData(s), ctx->StringLength(s));
}
// A PUBLIC EXTERNAL ::ROUTINE of the package: the library exports an entry that calls the declaration package's routine
// (the one the external library implements) with the same arguments; its result and any condition are the caller's.
[[maybe_unused]] static RexxObjectPtr rx2cpp_external_forward(RexxCallContext *context, RexxArrayObject args, const char *name) {
#ifdef RX2CPP_HOST_API
    RexxObjectPtr pkg = rxobj::libraryPackage();
    RexxObjectPtr routine = pkg == NULLOBJECT ? NULLOBJECT : context->SendMessage1(pkg, "FINDROUTINE", context->String(name));
    if (context->CheckCondition()) return NULLOBJECT;
    if (routine != NULLOBJECT && routine != context->Nil()) {
        // under the caller's NUMERIC settings (an external function reads its caller's: rxmath's precision), through a
        // small Rexx routine that sets them and calls the routine (CallRoutine alone would start at the defaults)
        static RexxRoutineObject helper = NULLOBJECT;
        if (helper == NULLOBJECT) {
            const char *source =
                "use arg rx2cppRoutine, rx2cppDigits, rx2cppFuzz, rx2cppForm, rx2cppArgs\n"
                "numeric digits rx2cppDigits; numeric fuzz rx2cppFuzz; numeric form value rx2cppForm\n"
                "rx2cppRoutine~callWith(rx2cppArgs)\n"
                "if var('RESULT') then return result\n";
            helper = rxobj::helperRoutine(context->threadContext, context->NewRoutine("rx2cpp_external_forward", source, std::strlen(source)));
            if (helper == NULLOBJECT) return NULLOBJECT;
            context->RequestGlobalReference((RexxObjectPtr)helper);
        }
        RexxArrayObject call = context->NewArray(5);
        context->ArrayPut(call, routine, 1);
        context->ArrayPut(call, context->WholeNumber((wholenumber_t)context->GetContextDigits()), 2);
        context->ArrayPut(call, context->WholeNumber((wholenumber_t)context->GetContextFuzz()), 3);
        context->ArrayPut(call, context->String(context->GetContextForm() == 0 ? "SCIENTIFIC" : "ENGINEERING"), 4);
        context->ArrayPut(call, (RexxObjectPtr)args, 5);
        return context->CallRoutine(helper, call);
    }
#else
    (void)args;
#endif
    context->RaiseException1(Rexx_Error_Routine_not_found_name, context->String(name));
    return NULLOBJECT;
}
%ROUTINE_DEFINITIONS%
#ifdef RX2CPP_HAS_ROUTINES
// A package ::ROUTINE called by the interpreter. With the host API, arguments and result are values (objects included:
// interpreter objects, native instances, .nil); otherwise the scalar string ABI.
#ifdef RX2CPP_HOST_API
/* routine~CALL / ~CALLWITH from compiled code whose receiver is a routine of this library (the interpreter's routine
   object, from findRoutine, .routines, ...): run here, as a local routine call is, with the arguments as they are
   (rx::routineCallHook). The routine objects are the declaration package's, found once by name. */
static rx::MessageResult routineCallImpl(void *routine, const std::string &selector, const std::vector<rx::Value> &args, bool &ours) {
    static thread_local std::unordered_map<void *, const char *> mine;
    static thread_local bool filled = false;
    if (!filled && rxobj::libraryPackage() != NULLOBJECT) {
        filled = true;
        RexxThreadContext *t = rxobj::need();
        RexxDirectoryObject all = t->GetPackageRoutines((RexxPackageObject)rxobj::libraryPackage());
        if (t->CheckCondition()) t->ClearCondition();
        else if (all != NULLOBJECT)
            for (const char *const *n = rx2cppRoutineNames; *n; ++n) {
                RexxObjectPtr r = t->DirectoryAt(all, *n);
                if (r != NULLOBJECT) mine.emplace((void *)r, *n);   // (the package keeps its routines)
            }
    }
    auto it = mine.find(routine);
    if (it == mine.end()) return std::nullopt;
    std::vector<std::optional<rx::Value>> positional;
    if (rx::eqLit(selector, "CALL")) {
        for (const rx::Value &a : args) {
            auto *e = a.isObject() ? dynamic_cast<rx::EnvObject *>(a.object.get()) : nullptr;
            if (e && !e->handle) positional.emplace_back(std::nullopt); else positional.emplace_back(a);
        }
    } else {
        if (args.size() != 1 || !args[0].isObject()) return std::nullopt;   // (the interpreter's error)
        if (auto *na = dynamic_cast<rx::NativeArray *>(args[0].object.get())) {
            if (na->real) return std::nullopt;
            for (const auto &slot : na->slots) positional.push_back(slot);
        } else return std::nullopt;   // an interpreter array: as before
    }
    ours = true;
    auto obj = rx2cpp::makeGeneratedObject_RX2CPP_ROUTINE_IMPL();
    rx::noResultPending() = false;
    rx::pendingCallType() = "SUBROUTINE";
    rx::Value v = rx::runRaising([&] { return obj->invokeValues(it->second, positional); });
    if (std::exchange(rx::noResultPending(), false)) return std::nullopt;
    return v;
}
[[maybe_unused]] static const bool routineCallInstalled = (rx::routineCallHook() = &routineCallImpl, true);
#endif
static RexxObjectPtr rx2cpp_routine_entry(RexxCallContext *context, RexxArrayObject args, const char *name) {
    try {
#ifdef RX2CPP_HOST_API
        rxobj::Scope hostScope(context->threadContext);
        rx::ActivationScope callerScope(rx::ActivationScope::Method);   // called by the interpreter: a stream table of its own
        auto obj = rx2cpp::makeGeneratedObject_RX2CPP_ROUTINE_IMPL();
        const size_t count = context->ArraySize(args);
        std::vector<std::optional<rx::Value>> positional;
        positional.reserve(count);
        for (size_t i = 1; i <= count; ++i) {
            RexxObjectPtr item = context->ArrayAt(args, i);
            if (item == NULLOBJECT) positional.emplace_back(std::nullopt);
            else if (rxobj::isPlainString(context->threadContext, item)) positional.emplace_back(rx::Value::string(rx2cpp_routine_string(context, item)));
            else if (item == context->Nil()) positional.emplace_back(rx::nil());
            else positional.emplace_back(rx::EnvObject::adopt((void *)rxobj::pinRef(context->threadContext, item)));
        }
        rx::noResultPending() = false;
        rx::Value outcome = obj->invokeValues(name, positional);
        if (std::exchange(rx::noResultPending(), false)) return NULLOBJECT;
        if (outcome.isObject()) {
            if (auto *env = dynamic_cast<rx::EnvObject *>(outcome.object.get())) return (RexxObjectPtr)env->handle;
            if (dynamic_cast<rx::NilObject *>(outcome.object.get())) return context->Nil();
            if (auto *ref = dynamic_cast<rx::NativeRefBase *>(outcome.object.get())) return (RexxObjectPtr)rxobj::returnPin(ref->materialize());
            if (auto *st = dynamic_cast<rx::StemObject *>(outcome.object.get())) return (RexxObjectPtr)rx::EnvObject::stemHandle(*st);
            throw std::runtime_error(std::string("native routine returned an object that the interpreter cannot receive (") +
                                     typeid(*outcome.object).name() + ")");
        }
        return context->NewString(outcome.bytes.data(), outcome.bytes.size());
#else
        auto obj = rx2cpp::makeGeneratedObject_RX2CPP_ROUTINE_IMPL();
        const size_t count = context->ArraySize(args);
        std::vector<std::optional<std::string>> positional;
        positional.reserve(count);
        for (size_t i = 1; i <= count; ++i) {
            RexxObjectPtr item = context->ArrayAt(args, i);
            if (item == NULLOBJECT) positional.emplace_back(std::nullopt);
            else positional.emplace_back(rx2cpp_routine_string(context, item));
        }
        const std::string value = obj->invokeMany(name, positional);
        return context->NewString(value.data(), value.size());
#endif
    } catch (const rx2cpp::PendingCondition &) {
        return NULLOBJECT;
    } catch (const rx::SyntaxCondition &e) {
        rx2cpp::raiseSyntaxIn(context->threadContext, e);
        return NULLOBJECT;
    } catch (const rx::NoMethod &e) {
        if (!rx2cpp::raiseNoMethodIn(context->threadContext, e))
            context->RaiseException1(Rexx_Error_Execution_user_defined, context->String(e.what()));
        return NULLOBJECT;
#ifdef RX2CPP_HOST_API
    } catch (const rx::RaiseToCaller &r) {
        rxobj::Scope raiseScope(context->threadContext);   // the entry's scope has ended: the raise needs the interpreter
        rx::raiseToCaller(r);
        return NULLOBJECT;
#endif
    } catch (const std::exception &e) {
        context->RaiseException1(Rexx_Error_Execution_user_defined, context->String(e.what()));
        return NULLOBJECT;
    }
}
#endif

%METHOD_DEFINITIONS%

// Called in the defining root's method scope, including for subclass objects.
RexxMethod1(RexxObjectPtr, rx_native_token, OSELF, self)
{
    (void)self;
    return context->GetObjectVariable("RX2CPP_NATIVE_ID");
}

// RX2CPP_HOLDS(scope): does this thread hold the receiver's lock for the scope of a compiled class (see HeldLock)?
RexxMethod2(RexxObjectPtr, rx_native_holds, OSELF, self, CSTRING, scope)
{
    for (const auto &h : rx2cpp::heldLocks)
        if (h.first == self && h.second == scope) return context->True();
    // (or the compiled scope lock: a compiled method of the object running on this thread, guarded or not)
    try {
        if (auto st = rx2cpp::stateOfObject((void *)self))
            if (st->at(scope)->scope_lock.heldByMe()) return context->True();
    } catch (const std::exception &) {}
    return context->False();
}

// COPY must be an explicit deep copy of every scope; reusing the root token
// aliases two Rexx objects and breaks identity and lifetime semantics.
RexxMethod0(RexxObjectPtr, rx_native_copy_reject)
{
    context->RaiseException1(Rexx_Error_Execution_user_defined,
        context->String("native COPY requires per-scope independent state; unsupported"));
    return NULLOBJECT;
}

RexxMethod1(RexxObjectPtr, rx_native_uninit, OSELF, self)
{
    (void)self;
    auto value = context->GetObjectVariable("RX2CPP_NATIVE_ID");
    if (value != NULLOBJECT) {
        const auto s = context->ObjectToString(value);
        auto token = std::string(context->StringData(s), context->StringLength(s));
        if (auto st = rx2cpp::InstanceTable::instance().find(token)) {
            rx2cpp::InstanceTable::instance().unbind(st->handle);
            st->alive = false; st->handle = nullptr;
#ifdef RX2CPP_HOST_API
            if (st->weak) { rxobj::unpinLater(st->weak); st->weak = nullptr; }
#endif
        }
        rx2cpp::InstanceTable::instance().remove(token);
        context->DropObjectVariable("RX2CPP_NATIVE_ID");
    }
    return NULLOBJECT;
}

static RexxMethodEntry nativeMethods[] = {
%METHOD_ENTRIES%
    REXX_METHOD(rx_native_uninit, rx_native_uninit),
    REXX_METHOD(rx_native_token, rx_native_token),
    REXX_METHOD(rx_native_holds, rx_native_holds),
    REXX_METHOD(rx_native_copy_reject, rx_native_copy_reject),
    REXX_LAST_METHOD()
};

%DECLARATION_FORM%
#ifdef RX2CPP_INTERPRETED_FILE
// interpreted_form file: the interpreted parts of this library live in an editable source file next to the library,
// read every time the library loads. A marker line "/* #REXX2CPP METHODS class */" or "/* #REXX2CPP CLASSES */"
// starts a section of that file; the same marker in the declaration says where the section goes.
static std::string rx2cppMarker(const std::string &line) {
    const std::size_t a = line.find_first_not_of(" \t\r");
    if (a == std::string::npos) return std::string();
    const std::size_t b = line.find_last_not_of(" \t\r");
    const std::string t = line.substr(a, b - a + 1);
    if (t.size() < 16 || t.compare(0, 3, "/* ") != 0 || t.compare(t.size() - 2, 2, "*/") != 0) return std::string();
    std::istringstream words(t.substr(2, t.size() - 4));
    std::string w, key;
    while (words >> w) {
        for (char &c : w) c = static_cast<char>(std::toupper(static_cast<unsigned char>(c)));
        key += (key.empty() ? "" : " ") + w;
    }
    return key.compare(0, 10, "#REXX2CPP ") == 0 ? key : std::string();
}
static bool rx2cppInterpretedSource(const char *decl, std::size_t n, std::string &out, std::string &error) {
    Dl_info info{};
    std::string dir = ".";
    if (dladdr(reinterpret_cast<void *>(&rx2cppMarker), &info) && info.dli_fname) {
        const std::string so = info.dli_fname;
        const std::size_t slash = so.rfind('/');
        if (slash != std::string::npos) dir = so.substr(0, slash);
    }
    const std::string path = dir + "/" + RX2CPP_INTERPRETED_FILE;
    std::ifstream file(path, std::ios::binary);
    if (!file) { error = "interpreted source file not found: " + path; return false; }
    std::stringstream buffer;
    buffer << file.rdbuf();
    std::map<std::string, std::string> sections;
    std::string current, line;
    std::istringstream text(buffer.str());
    while (std::getline(text, line)) {
        const std::string key = rx2cppMarker(line);
        if (!key.empty()) {
            if (sections.count(key)) { error = path + ": duplicate marker " + key; return false; }
            current = key;
            sections[key];
        } else if (!current.empty()) sections[current] += line + "\n";
    }
    out.clear();
    std::istringstream declaration(std::string(decl, n));
    while (std::getline(declaration, line)) {
        const std::string key = rx2cppMarker(line);
        if (key.empty()) { out += line + "\n"; continue; }
        auto found = sections.find(key);
        if (found == sections.end()) { error = path + ": missing section " + key; return false; }
        out += line + "\n" + found->second;
        sections.erase(found);
    }
    if (!sections.empty()) { error = path + ": section with no place in the library: " + sections.begin()->first; return false; }
    return true;
}
#endif

static void RexxEntry loadPackage(RexxThreadContext *ctx) {
    // The build tokenizes the declaration with rexxc, which loads this library only to resolve its EXTERNAL methods
    // and routines. Loading the declaration package here would put live objects into the image, and run user code
    // (the prolog) at build time: do nothing.
    if (std::getenv("RX2CPP_TOKENIZING") != nullptr) return;
    // A native package normally only contributes routines/methods. We build
    // its PUBLIC class once and publish it to the ooRexx global environment.
    static const char declaration[] = %CLASS_SOURCE%;
    const char *classNames[] = {
%CLASS_NAMES%    };
    // Validate the entire set before changing the global environment.
    for (const char *className : classNames) {
        if (ctx->DirectoryAt(ctx->GetGlobalEnvironment(), className) != NULLOBJECT) {
            ctx->RaiseException1(Rexx_Error_Execution_user_defined,
                                 ctx->String("native class name already registered"));
            return;
        }
    }
    const char *declarationData = declaration;
    std::size_t declarationSize = sizeof(declaration) - 1;
#ifdef RX2CPP_INTERPRETED_FILE
    static std::string spliced;
    std::string spliceError;
    if (!rx2cppInterpretedSource(declaration, declarationSize, spliced, spliceError)) {
        ctx->RaiseException1(Rexx_Error_Execution_user_defined, ctx->String(("rx2cpp: " + spliceError).c_str()));
        return;
    }
    declarationData = spliced.data();
    declarationSize = spliced.size();
#endif
    auto pkg = ctx->LoadPackageFromData(%INTERNAL_NAME%, declarationData, declarationSize);
    if (pkg == NULLOBJECT || ctx->CheckCondition()) return;
#ifdef RX2CPP_HOST_API
    rxobj::libraryPackage() = rxobj::pinRef(ctx, (RexxObjectPtr)pkg);
    // The interpreter fields compiled code reads (a Directory's SETMETHOD entries and UNKNOWN method, a package's
    // security manager) are found now, before the program can set a security manager: finding them sends SETMETHOD
    // and SETSECURITYMANAGER, protected methods a manager would be asked about.
    (void)rxobj::directoryFields(ctx);
    (void)rxobj::packageFields(ctx);
    (void)rxobj::stringFields(ctx);
#endif
    // Package scope as interpreted: the declaration packages of the rx2cpp libraries this one requires are imported, so
    // their public classes resolve before .LOCAL / .ENVIRONMENT (e.g. a public class ERROR before the .ERROR stream).
    // Each library registers its own declaration package under a key no Rexx environment symbol can name.
    auto packageKey = [](const char *name) {
        std::string key = "RX2CPP.PACKAGE.";
        for (const char *c = name; *c; ++c) key += (char)std::toupper((unsigned char)*c);
        return key;
    };
    static const char *requiredLibraries[] = { %REQUIRED_LIBRARIES%nullptr };
    for (const char **lib = requiredLibraries; *lib; ++lib) {
        RexxObjectPtr other = ctx->DirectoryAt(ctx->GetGlobalEnvironment(), packageKey(*lib).c_str());
        if (other == NULLOBJECT) continue;   // an ordinary native library (rxsock, ...): nothing to import
        ctx->SendMessage1((RexxObjectPtr)pkg, "ADDPACKAGE", other);
        if (ctx->CheckCondition()) return;
    }
#ifdef RX2CPP_HOST_API
    rxobj::takeFixedClassTables(ctx);   // the package's classes as the program will see them (imports included)
#endif
    ctx->DirectoryPut(ctx->GetGlobalEnvironment(), (RexxObjectPtr)pkg, packageKey(%PACKAGE_NAME%).c_str());
    auto classes = ctx->GetPackagePublicClasses(pkg);
    auto allClasses = ctx->GetPackageClasses(pkg);
    // Verify that all declared classes exist before publishing any.
    for (const char *className : classNames) {
        if (ctx->DirectoryAt(allClasses, className) == NULLOBJECT) {
            ctx->RaiseException1(Rexx_Error_Execution_user_defined,
                                 ctx->String("generated class missing"));
            return;
        }
    }
    // Only PUBLIC classes are published; PRIVATE (and default) classes stay visible inside this package only.
    for (const char *className : classNames) {
        auto cls = ctx->DirectoryAt(classes, className);
        if (cls != NULLOBJECT) ctx->DirectoryPut(ctx->GetGlobalEnvironment(), cls, className);
    }
    // The source package's prolog (code before its first ::CLASS), carried as a routine of the declaration.
    auto routines = ctx->GetPackageRoutines(pkg);
    if (routines != NULLOBJECT) {
        auto prolog = ctx->DirectoryAt(routines, "RX2CPP_PACKAGE_PROLOG");
        if (prolog != NULLOBJECT) ctx->CallRoutine((RexxRoutineObject)prolog, ctx->NewArray(0));
    }
}

// RX2CPP_CALLER_CONTEXT (a private routine of the declaration package): the context of the routine that calls it.
RexxRoutine0(RexxObjectPtr, rx2cpp_caller_context) { return (RexxObjectPtr)context->GetCallerContext(); }
// RX2CPP_TAKE(key[, keep]): the .local entry compiled code left for the code of an INTERPRET (taken out unless keep).
RexxRoutine2(RexxObjectPtr, rx2cpp_take, CSTRING, key, OPTIONAL_CSTRING, keep) {
    RexxDirectoryObject local = context->GetLocalEnvironment();
    RexxObjectPtr v = context->DirectoryAt(local, key);
    if (v != NULLOBJECT && keep == nullptr) context->DirectoryRemove(local, key);
    return v != NULLOBJECT ? v : context->Nil();
}
static RexxRoutineEntry nativeRoutines[] = {
%ROUTINE_ENTRIES%    REXX_LAST_ROUTINE()
};

static RexxPackageEntry generated_package_entry = {
    STANDARD_PACKAGE_HEADER
    REXX_CURRENT_INTERPRETER_VERSION,
    %PACKAGE_NAME%, "0.17.0-dev1", loadPackage, nullptr, nativeRoutines, nativeMethods
};
OOREXX_GET_PACKAGE(generated)
