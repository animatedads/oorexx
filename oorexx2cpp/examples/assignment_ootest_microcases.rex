/* Subset derived from i3 assertions in upstream ooTest 4.2 Assignments.testGroup.
   This is NOT the original ooTest testGroup, which uses decimal loops,
   more operators, and an ooTestCase subclass not yet supported natively. */
i3 = 0
i3 += 10
say i3
i3 = 0
i3 -= 10
say i3
i3 = 13
i3 /= 10
say i3
i3 = 13
i3 *= 10
say i3
