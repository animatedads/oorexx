/* Target backend for C++17 source emission.
   Grammar rules only request statements and runtime calls; final translation-
   unit framing/indentation/newline policy is centralized here. Future backends
   can implement the same line()/finish() interface without changing the lexer. */
::class RxCppEmitter public
::method init
  expose lines routineLines classLines
  lines = .array~new
  routineLines = .array~new
  classLines = .array~new
::method line
  expose lines routineLines
  use arg depth, statement
  lines~append(copies(' ', depth * 4) || statement)
::method classLine
  expose classLines
  use arg statement
  classLines~append('        ' || statement)
::method body
  expose routineLines
  output = ''
  do entry over routineLines
    output = output || entry || '0a'x
  end
  return output
::method routineLine
  expose routineLines
  use arg depth, statement
  routineLines~append(copies(' ', depth * 4) || statement)
::method header
  use arg useLibraries = .false
  self~line(0, '// Generated by ooRexx rx2cpp precompiler; BIF linkage is selected by build mode.')
  self~line(0, '#include "minirexx_runtime.hpp"')
  if useLibraries then self~line(0, '#include "rx_extlib_bridge.hpp"')
  if .RxBuiltinRules~externalEnabled then self~line(0, '#include "rx_bif_integration.hpp"')
  self~line(0, '// __RX2CPP_HOST_INCLUDE__')
  self~line(0, '#include <exception>')
  self~line(0, '#include <iostream>')
  library = value('RX2CPP_LIBRARY', , 'ENVIRONMENT') \= ''
  if library then do   /* shared-library mode: program body runs once at load, routines are exported */
    self~line(0, 'static rx::RoutineRegistry rxLibRoutines;')
    self~line(0, 'static rx::Variables rxLibVars;')
    self~line(0, 'static int rxLibMain() {')
    self~line(1, 'int argc = 0; char **argv = nullptr;')
  end
  else self~line(0, 'int main(int argc, char **argv) {')
  self~line(1, 'try {')
  self~line(2, 'rx::Variables vars;')
  self~line(2, 'const std::vector<rx::Value> _rxProgramArgs = rx::mainArguments(argc, argv);')
  if library then self~line(2, 'rx::RoutineRegistry& _rxRoutines = rxLibRoutines;')
  else self~line(2, 'rx::RoutineRegistry _rxRoutines;')
  if .RxBuiltinRules~externalEnabled then self~line(2, 'rx::BifRuntime _rxBifRuntime;')
  self~line(2, '// __RX2CPP_ROUTINE_DEFINITIONS__')
  self~line(2, '// __RX2CPP_CLASS_DECLARATIONS__')
::method footer
  if value('RX2CPP_LIBRARY', , 'ENVIRONMENT') \= '' then do
    self~line(2, 'return 0;')
    self~line(1, '} catch (const rx::ProgramExit &_rxExit) {')
    self~line(2, 'return _rxExit.code;')
    self~line(1, '} catch (const std::exception &e) {')
    self~line(2, 'std::cerr << "rx2cpp runtime error: " << e.what() << ''\n'';')
    self~line(2, 'return 1;')
    self~line(1, '}')
    self~line(0, '}')
    return
  end
  self~line(2, 'return 0;')
  self~line(1, '} catch (const rx::ProgramExit &_rxExit) {')
  self~line(2, 'return _rxExit.code;')
  self~line(1, '} catch (const std::exception &e) {')
  self~line(2, 'std::cerr << "rx2cpp runtime error: " << e.what() << ''\n'';')
  self~line(2, 'return rx::uncaughtStatus(e.what());')
  self~line(1, '}')
  self~line(0, '}')
::method finish
  expose lines routineLines classLines
  use arg hosted = .nil
  output = ''
  do value over lines
    if pos('__RX2CPP_ROUTINE_DEFINITIONS__', value) > 0 then do
      do routineLine over routineLines
        output = output || routineLine || '0a'x
      end
    end
    else if pos('__RX2CPP_HOST_INCLUDE__', value) > 0 then do
      if hosted == .nil then iterate
      if hosted~items > 0 then do
        names = ''
        do h over hosted
          names = names h
        end
        output = output || '// RX2CPP_HOSTED:' || names || ' (interpreter session; links librexx)' || '0a'x
        output = output || '#include "rx_host_tier.hpp"' || '0a'x
      end
    end
    else if pos('__RX2CPP_CLASS_DECLARATIONS__', value) > 0 then do
      do classLine over classLines
        output = output || classLine || '0a'x
      end
    end
    else output = output || value || '0a'x
  end
  return output

::requires 'rules/RxBuiltinRules.cls'
