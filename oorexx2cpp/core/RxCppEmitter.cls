/* Target backend for C++17 source emission.
   Grammar rules only request statements and runtime calls; final translation-
   unit framing/indentation/newline policy is centralized here. Future backends
   can implement the same line()/finish() interface without changing the lexer. */
::class RxCppEmitter public
::method init
  expose lines routineLines
  lines = .array~new
  routineLines = .array~new
::method line
  expose lines routineLines
  use arg depth, statement
  lines~append(copies(' ', depth * 4) || statement)
::method routineLine
  expose routineLines
  use arg depth, statement
  routineLines~append(copies(' ', depth * 4) || statement)
::method header
  use arg useLibraries = .false
  self~line(0, '// Generated by ooRexx rx2cpp precompiler; BIF linkage is selected by build mode.')
  self~line(0, '#include "minirexx_runtime.hpp"')
  if useLibraries then self~line(0, '#include "rx_extlib_bridge.hpp"')
  if .RxBuiltinRules~externalEnabled then self~line(0, '#include "rx_bif_integration.hpp"')
  self~line(0, '#include <exception>')
  self~line(0, '#include <iostream>')
  self~line(0, 'int main(int argc, char **argv) {')
  self~line(1, 'try {')
  self~line(2, 'rx::Variables vars;')
  self~line(2, 'const std::vector<rx::Value> _rxProgramArgs = rx::mainArguments(argc, argv);')
  self~line(2, 'rx::RoutineRegistry _rxRoutines;')
  if .RxBuiltinRules~externalEnabled then self~line(2, 'rx::BifRuntime _rxBifRuntime;')
  self~line(2, '// __RX2CPP_ROUTINE_DEFINITIONS__')
::method footer
  self~line(2, 'return 0;')
  self~line(1, '} catch (const rx::ProgramExit &_rxExit) {')
  self~line(2, 'return _rxExit.code;')
  self~line(1, '} catch (const std::exception &e) {')
  self~line(2, 'std::cerr << "rx2cpp runtime error: " << e.what() << ''\n'';')
  self~line(2, 'return 2;')
  self~line(1, '}')
  self~line(0, '}')
::method finish
  expose lines routineLines
  output = ''
  do value over lines
    if pos('__RX2CPP_ROUTINE_DEFINITIONS__', value) > 0 then do
      do routineLine over routineLines
        output = output || routineLine || '0a'x
      end
    end
    else output = output || value || '0a'x
  end
  return output

::requires 'rules/RxBuiltinRules.cls'
