/* Prove the rules generated by an ooRexx converter are loadable ooRexx classes. */
if .RxBifRule_TIME~bifName \== 'TIME' then exit 1
if .RxBifRule_TIME~argumentRange \== '0 3' then exit 2
if .RxBifRule_TIME~irKind \== 'CLOCK_SUBSET' then exit 3
if .RxBifRule_TIME~emitCppExpression('arguments','context') \== ,
  'rxbif_generated::BIF_TIME(arguments,context)' then exit 4
if .RxBifRule_REVERSE~sourceMethod \== 'reverse' then exit 5
if .RxBifRule_REVERSE~emitCppExpression('argv','ctx') \== ,
  'rxbif_generated::BIF_REVERSE(argv,ctx)' then exit 6
if .RxBifRule_C2X~sourceMethod \== 'c2x' then exit 7
if .RxBifRule_C2X~sourceCall \== 'string->c2x()' then exit 8
if .RxBifRule_COPIES~sourceCall \== 'string->copies(n)' then exit 9
if .RxBifRule_X2C~argumentRange \== '1 1' then exit 10
if .RxBifRule_B2X~sourceCall \== 'string->b2x()' then exit 11
if .RxBifRule_X2B~sourceCall \== 'string->x2b()' then exit 12
if .RxBifRule_BITAND~sourceCall \== 'string1->bitAnd(string2,pad)' then exit 13
if .RxBifRule_BITXOR~argumentRange \== '1 3' then exit 14
say 'PASS generated .cls rules load and retain verified delegate call shapes'
::requires 'Bif_TIME.cls'
::requires 'Bif_REVERSE.cls'
::requires 'Bif_C2X.cls'
::requires 'Bif_COPIES.cls'
::requires 'Bif_X2C.cls'
::requires 'Bif_B2X.cls'
::requires 'Bif_X2B.cls'
::requires 'Bif_BITAND.cls'
::requires 'Bif_BITXOR.cls'
