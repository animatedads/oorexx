/* IR emitter is ooRexx too; no Python code generation in the conversion path. */
::class BifEmitter public
::method emit
  use arg entries, coverage, output
  crlf = '0a'x
  h = '// Generated from upstream BUILTIN C++ by bif2inline.rex; do not edit.' || crlf
  h = h || '// Compile-time inline call sites; backend is native C++ (no ooRexx runtime).' || crlf
  h = h || '#pragma once' || crlf || '#include "rxbif.hpp"' || crlf
  h = h || '#include <algorithm>' || crlf || '#include <stdexcept>' || crlf || '#include <vector>' || crlf
  h = h || 'namespace rxbif_generated {' || crlf
  ir = 'RBI1' || '09'x || 'name' || '09'x || 'min' || '09'x || 'max' || '09'x || 'kind' || '09'x || 'cpp_method' || '09'x || 'source_arguments' || '09'x || 'origin_line' || '09'x || 'delegate_call' || crlf
  inlineRule = .BifInlineBackendRule~new
  do item over entries
    n = item~name
    ir = ir || 'RBI1' || '09'x || n || '09'x || item~minArg || '09'x || item~maxArg || '09'x || item~kind || '09'x || item~method || '09'x || item~argMeta || '09'x || item~line || '09'x || item~callShape || crlf
    h = h || '/* upstream ' || n || ' line ' || item~line || ' [' || item~kind || ']: ' || item~evidence || ' */' || crlf
    h = h || 'inline rx::Value BIF_' || n || '(const std::vector<rx::Value>& a, rxbif::Context& ctx) {' || crlf
    if item~minArg == 0 then condition = 'a.size() > ' || item~maxArg
    else condition = 'a.size() < ' || item~minArg || ' || a.size() > ' || item~maxArg
    h = h || '    if (' || condition || ') throw std::runtime_error("BIF ' || n || ': arity");' || crlf
    expression = inlineRule~body(item)
    if expression == '' then expression = '    return rxbif::invoke("' || n || '", a, ctx);'
    else expression = '    (void)ctx;' || crlf || expression
    h = h || expression || crlf
    h = h || '}' || crlf
    self~emitRule(item, output)
  end
  h = h || '} // namespace rxbif_generated' || crlf
  report = ''
  do line over coverage
    report = report || line || crlf
  end
  self~write(output || '/rxbif_generated.hpp',h)
  self~write(output || '/rxbif.ir.tsv',ir)
  self~write(output || '/coverage.tsv',report)
/* Independently loadable ooRexx rule object generated FROM the C++ BIF. */
::method emitRule
  use arg item, output
  n = item~name
  crlf = '0a'x
  className = 'RxBifRule_' || n
  s = '/* Generated by ooRexx from upstream BUILTIN(' || n || '). */' || crlf
  s = s || '::class ' || className || ' public' || crlf
  s = s || '::method bifName class' || crlf || "  return '" || n || "'" || crlf
  s = s || '::method argumentRange class' || crlf || "  return '" || item~minArg || ' ' || item~maxArg || "'" || crlf
  s = s || '::method irKind class' || crlf || "  return '" || item~kind || "'" || crlf
  s = s || '::method sourceMethod class' || crlf || "  return '" || item~method || "'" || crlf
  s = s || '::method argumentBindings class' || crlf || "  return '" || item~argMeta || "'" || crlf
  s = s || '::method sourceCall class' || crlf || "  return '" || item~callShape || "'" || crlf
  s = s || '::method sourceLine class' || crlf || '  return ' || item~line || crlf
  s = s || '::method emitCppExpression class' || crlf
  s = s || '  use arg argumentsName, contextName' || crlf
  s = s || "  if argumentsName == '' | contextName == '' then raise syntax 40.900 array ('C++ argument and context names required')" || crlf
  s = s || "  return 'rxbif_generated::BIF_" || n || "(' || argumentsName || ',' || contextName || ')'" || crlf
  self~write(output || '/Bif_' || n || '.cls', s)
::method write
  use arg path, content
  status = stream(path,'C','OPEN WRITE REPLACE')
  if left(status,6) \== 'READY:' then raise syntax 40.900 array ('Cannot open output:' path)
  call charout path, content
  call stream path, 'C', 'CLOSE'
::requires 'rules/BifInlineBackendRule.cls'
