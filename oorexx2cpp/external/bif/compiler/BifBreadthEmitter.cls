/* ooRexx C++ emitter for BIF breadth. Every generated wrapper has an
   explicit dispatch kind; no fabricated native implementation is emitted. */
::class BifBreadthEmitter public
::method emit
  use arg accepted, cover, outdir
  lf = '0a'x
  tab = '09'x
  text = '// Generated by ooRexx bif2breadth.rex from upstream BUILTIN source.' || lf
  text = text || '#pragma once' || lf || '#include "rxbif_breadth.hpp"' || lf
  text = text || 'namespace rxbif_breadth_generated {' || lf
  ir = 'name' || tab || 'source_line' || tab || 'min' || tab || 'max' || tab || 'route' || tab || 'source_basis' || lf
  do item over accepted
    n = item~name
    minimum = item~minArg
    maximum = item~maxArg
    route = item~kind
    upper = ''
    if maximum >= 0 then upper = ' || a.size() > ' || maximum
    text = text || 'inline rx::Value BIF_' || n || '(const std::vector<rxbif_breadth::Slot>& a, rxbif_breadth::Context& ctx) {' || lf
    test = ''
    if minimum > 0 then test = 'a.size() < ' || minimum
    if maximum >= 0 then do
      if test \== '' then test = test || ' || '
      test = test || 'a.size() > ' || maximum
    end
    if test \== '' then text = text || '  if (' || test || ') throw std::runtime_error("BIF ' || n || ': arity");' || lf
    text = text || '  return rxbif_breadth::invoke("' || n || '", a, ctx);' || lf
    text = text || '}' || lf
    ir = ir || n || tab || item~line || tab || minimum || tab || maximum || tab || route || tab || 'upstream_BUILTIN' || lf
    self~emitRule(item,outdir)
  end
  text = text || '} // namespace rxbif_breadth_generated' || lf
  report = ''
  do row over cover
    report = report || row || lf
  end
  self~write(outdir || '/rxbif_breadth_generated.hpp',text)
  self~write(outdir || '/rxbif.breadth.ir.tsv',ir)
  self~write(outdir || '/coverage.breadth.tsv',report)
::method emitRule
  use arg item,outdir
  lf = '0a'x
  name = item~name
  t = '/* Source-derived rule; breadth routing does not assert native equivalence. */' || lf
  t = t || '::class RxBifBreadthRule_' || name || ' public' || lf
  t = t || '::method bifName class' || lf || "  return '" || name || "'" || lf
  t = t || '::method argumentRange class' || lf || "  return '" || item~minArg || ' ' || item~maxArg || "'" || lf
  t = t || '::method routeKind class' || lf || "  return '" || item~kind || "'" || lf
  t = t || '::method requiresNumericContext class' || lf || '  return .true' || lf
  t = t || '::method sourceLine class'  || lf || '  return ' || item~line || lf
  t = t || '::method emitCppExpression class' || lf || '  use arg argumentsName, contextName' || lf
  t = t || "  if argumentsName == '' | contextName == '' then raise syntax 40.900 array ('C++ names required')" || lf
  t = t || "  return 'rxbif_breadth_generated::BIF_" || name || "(' || argumentsName || ',' || contextName || ')'" || lf
  self~write(outdir || '/Bif_' || name || '.cls',t)
::method write
  use arg path, contents
  st = stream(path,'C','OPEN WRITE REPLACE')
  if left(st,6) \== 'READY:' then raise syntax 40.900 array ('Failed to write ' path)
  call charout path, contents
  call stream path,'C','CLOSE'
