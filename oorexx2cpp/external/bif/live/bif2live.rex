/* ooRexx source-to-source generator. Input is ooRexx C++ source, not metadata.
   Usage from BIF pack root: rexx live/bif2live.rex source.cpp output-dir
   Full upstream file may be supplied; only three BIFs qualify in this pass. */
parse arg source outdir
if source == '' | outdir == '' then do
  say 'Usage: rexx live/bif2live.rex /src/BuiltinFunctions.cpp /existing/outdir'
  exit 64
end
signal on syntax name failed
signal on error name failed
signal on failure name failed
if stream(source,'C','QUERY EXISTS') == '' then do
  say 'Source not found:' source
  exit 66
end
reader = .BifSourceReader~new
rule = .BifLiveCallRule~new
all = reader~scan(source)
found = .directory~new
eligible = .array~new
names = 'DIGITS FUZZ FORM FORMAT'
do def over all
  n = def~name
  if wordpos(n,names) == 0 then iterate
  if found~hasIndex(n) then do
    say 'Duplicate BIF:' n
    exit 65
  end
  found[n] = .true
  if rule~convert(def) \== .true then do
    say 'Source mismatch, no live adapter emitted:' n
    exit 3
  end
  eligible~append(def)
end
do i = 1 to words(names)
  n = word(names,i)
  if \found~hasIndex(n) then do
    say 'Missing original BIF:' n
    exit 3
  end
end
lf = '0a'x
tab = '09'x
header = '// Generated by ooRexx BifLiveCallRule from upstream BUILTIN source.' || lf
header = header || '#pragma once' || lf || '#include "rxbif_live_call.hpp"' || lf
header = header || 'namespace rxbif_live_generated {' || lf
ir = 'name' || tab || 'source_line' || tab || 'min' || tab || 'max' || tab || 'mode' || tab || 'source_basis' || lf
do d over eligible
  n = d~name
  if n == 'FORMAT' then do
    header = header || 'inline rx::Value BIF_FORMAT(rxbif_live::CallScope& live, const std::vector<rxbif_breadth::Slot>& args) {' || lf
    header = header || '  return live.invoke("FORMAT", args);' || lf || '}' || lf
  end
  else do
    header = header || 'inline rx::Value BIF_' || n || '(rxbif_live::CallScope& live) {' || lf
    header = header || '  return live.invoke("' || n || '");' || lf || '}' || lf
  end
  ir = ir || n || tab || d~line || tab || d~minArg || tab || d~maxArg || tab || 'LIVE_CALL_SCOPED' || tab || 'upstream_cpp_BUILTIN' || lf
  cls = '/* Generated by ooRexx BifLiveCallRule. */' || lf
  cls = cls || '::class RxBifLiveRule_' || n || ' public' || lf
  cls = cls || '::method bifName class' || lf || "  return '" || n || "'" || lf
  cls = cls || '::method routeKind class' || lf || "  return 'LIVE_CALL_SCOPED'" || lf
  cls = cls || '::method argumentRange class' || lf || "  return '" || d~minArg || ' ' || d~maxArg || "'" || lf
  cls = cls || '::method sourceLine class' || lf || '  return ' || d~line || lf
  cls = cls || '::method emitCppExpression class' || lf
  if n == 'FORMAT' then cls = cls || '  use arg scopeName, argVectorExpr' || lf
  else cls = cls || '  use arg scopeName' || lf
  cls = cls || "  if scopeName == '' then raise syntax 40.900 array ('Live BIF scope required')" || lf
  if n == 'FORMAT' then do
    cls = cls || "  if argVectorExpr == '' then raise syntax 40.900 array ('FORMAT requires argument vector')" || lf
  end
  if n == 'FORMAT' then cls = cls || "  return 'rxbif_live_generated::BIF_" || n || "(' || scopeName || ', ' || argVectorExpr || ')'" || lf
  else cls = cls || "  return 'rxbif_live_generated::BIF_" || n || "(' || scopeName || ')'" || lf
  call writeFile outdir || '/Bif_' || n || '.cls',cls
end
header = header || '} // namespace rxbif_live_generated' || lf
call writeFile outdir || '/rxbif_live_generated.hpp',header
call writeFile outdir || '/rxbif_live.ir.tsv',ir
say 'BIF live source rules:' eligible~items '/ 4'
exit 0
failed:
  say 'Live source rule generator failed:' condition('O')~at('MESSAGE')
  exit 70
writeFile:
  use arg path, contents
  st = stream(path,'C','OPEN WRITE REPLACE')
  if left(st,6) \== 'READY:' then raise syntax 40.900 array ('Cannot write:' path)
  call charout path,contents
  call stream path,'C','CLOSE'
  return
::requires 'compiler/BifSourceReader.cls'
::requires 'live/BifLiveCallRule.cls'
