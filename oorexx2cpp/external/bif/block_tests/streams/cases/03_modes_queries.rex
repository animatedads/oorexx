/* Stream OPEN modes, APPEND, SEEK, queries, and cross-mode lifetime. */
f='modes_queries.dat'
say 'missing-status='stream(f,'S')
say 'open-write='stream(f,'C','OPEN WRITE REPLACE')
say 'write1='lineout(f,'AB')
say 'size1='stream(f,'C','QUERY SIZE')
say 'position1='stream(f,'C','QUERY POSITION')
say 'seek-start='stream(f,'C','SEEK =1')
say 'position2='stream(f,'C','QUERY POSITION')
say 'close-write='stream(f,'C','CLOSE')
say 'open-append='stream(f,'C','OPEN WRITE APPEND')
say 'write2='lineout(f,'CD')
say 'size2='stream(f,'C','QUERY SIZE')
say 'close-append='stream(f,'C','CLOSE')
say 'open-read='stream(f,'C','OPEN READ')
say 'full-hex='c2x(charin(f,,6))
say 'at-eof='chars(f)
say 'status='stream(f,'S')
say 'close-read='stream(f,'C','CLOSE')
say 'postclose-status='stream(f,'S')
