/* Exact bytes including NUL, LF and FF; independent line and char I/O. */
f='binary_cursor.dat'
say 'open-write='stream(f,'C','OPEN WRITE REPLACE')
say 'write-hex='charout(f,'4100420A43FF'x)
say 'close-write='stream(f,'C','CLOSE')
say 'open-read='stream(f,'C','OPEN READ')
say 'size='stream(f,'C','QUERY SIZE')
say 'initial-pos='stream(f,'C','QUERY POSITION')
say 'first3='c2x(charin(f,,3))
say 'pos-after3='stream(f,'C','QUERY POSITION')
say 'from2-2='c2x(charin(f,2,2))
say 'pos-after-seek='stream(f,'C','QUERY POSITION')
say 'line-tail='c2x(linein(f))
say 'pos-after-line='stream(f,'C','QUERY POSITION')
say 'char-left='chars(f)
say 'last2='c2x(charin(f,,2))
say 'over-eof='c2x(charin(f,,3))
say 'close-read='stream(f,'C','CLOSE')
say 'reopen='stream(f,'C','OPEN READ')
say 'zero-count='c2x(charin(f,,0))
say 'zero-pos='stream(f,'C','QUERY POSITION')
say 'read-all='c2x(charin(f,,6))
say 'final-close='stream(f,'C','CLOSE')
