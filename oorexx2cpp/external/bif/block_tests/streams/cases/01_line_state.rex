/* Stateful line I/O: OPEN/CLOSE, line counts, EOF and cursor reuse. */
f='line_state.dat'
say 'pre-status='stream(f,'S')
say 'open-write='stream(f,'C','OPEN WRITE REPLACE')
say 'lineout-1='lineout(f,'ALPHA')
say 'lineout-2='lineout(f,'BETA')
say 'write-chars='chars(f)
say 'write-lines='lines(f)
say 'write-size='stream(f,'C','QUERY SIZE')
say 'write-position='stream(f,'C','QUERY POSITION')
say 'close-write='stream(f,'C','CLOSE')
say 'open-read='stream(f,'C','OPEN READ')
say 'initial-lines='lines(f)
say 'initial-chars='chars(f)
say 'linein-1='linein(f)
say 'position-after1='stream(f,'C','QUERY POSITION')
say 'linein-2='linein(f)
say 'after2-lines='lines(f)
say 'after2-chars='chars(f)
say 'linein-eof='c2x(linein(f))
say 'charin-eof='c2x(charin(f))
say 'post-status='stream(f,'S')
say 'close-read='stream(f,'C','CLOSE')
say 'reopen-read='stream(f,'C','OPEN READ')
say 'rewind-line='linein(f)
say 'final-close='stream(f,'C','CLOSE')
