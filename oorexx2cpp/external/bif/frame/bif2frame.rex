/* ooRexx-authored upstream-C++ -> BIF rule/IR -> native inline wrapper.
   Usage: rexx frame/bif2frame.rex source.cpp existing-output-dir */
parse arg source outdir
if source == '' | outdir == '' then do
  say 'Usage: rexx frame/bif2frame.rex /src/BuiltinFunctions.cpp /existing/outdir'
  exit 64
end
signal on syntax name failed
signal on error name failed
signal on failure name failed
if stream(source,'C','QUERY EXISTS') == '' then exit 66
rule = .BifFrameRouteRule~new
reader = .BifSourceReader~new
seen = .directory~new
entries = .array~new
do definition over reader~scan(source)
  n = definition~name
  if wordpos(n,'ARG ADDRESS') == 0 then iterate
  if seen~hasIndex(n) then exit 65
  seen[n] = .true
  if rule~convert(definition) \== .true then do
    say 'Source drift rejected:' n
    exit 3
  end
  entries~append(definition)
end
do i = 1 to 2
  n = word('ARG ADDRESS',i)
  if \seen~hasIndex(n) then do
    say 'Missing upstream BIF:' n
    exit 3
  end
end
lf = '0a'x
tab = '09'x
h = '// GENERATED BY ooRexx BifFrameRouteRule; source-verified. Do not edit.' || lf
h ||= '#pragma once' || lf || '#include "rxbif_frame.hpp"' || lf
h ||= 'namespace rxbif_frame_generated {' || lf
ir = 'name' || tab || 'min' || tab || 'max' || tab || 'source_line' || tab || 'routing' || lf
do d over entries
  name = d~name
  if name == 'ARG' then do
    h ||= 'inline rx::Value BIF_ARG(rxbif_frame::ActivationRouter& frame, const std::vector<rxbif_frame::Slot>& args) {' || lf
    h ||= '  return frame.invoke("ARG", args);' || lf || '}' || lf
  end
  else do
    h ||= 'inline rx::Value BIF_ADDRESS(rxbif_frame::ActivationRouter& frame) {' || lf
    h ||= '  return frame.invoke("ADDRESS");' || lf || '}' || lf
  end
  ir ||= name || tab || d~minArg || tab || d~maxArg || tab || d~line || tab || 'COMPILED_FRAME_SCOPED' || lf
  class = '/* Generated from the upstream C++ BUILTIN by ooRexx. */' || lf
  class ||= '::class RxBifFrameRule_' || name || ' public' || lf
  class ||= '::method bifName class' || lf || "  return '" || name || "'" || lf
  class ||= '::method routeKind class' || lf || "  return 'COMPILED_FRAME_SCOPED'" || lf
  class ||= '::method argumentRange class' || lf || "  return '" || d~minArg || ' ' || d~maxArg || "'" || lf
  class ||= '::method sourceLine class' || lf || '  return ' || d~line || lf
  class ||= '::method emitCppExpression class' || lf
  if name == 'ARG' then class ||= '  use arg scopeName, arguments' || lf
  else class ||= '  use arg scopeName' || lf
  class ||= "  if scopeName == '' then raise syntax 40.900 array ('Original compiled frame required')" || lf
  if name == 'ARG' then do
    class ||= "  if arguments == '' then raise syntax 40.900 array ('BIF ARG requires call arguments')" || lf
    class ||= "  return 'rxbif_frame_generated::BIF_ARG(' || scopeName || ', ' || arguments || ')'" || lf
  end
  else class ||= "  return 'rxbif_frame_generated::BIF_ADDRESS(' || scopeName || ')'" || lf
  call writeFile outdir || '/Bif_' || name || '.cls',class
end
h ||= '} // namespace rxbif_frame_generated' || lf
call writeFile outdir || '/rxbif_frame_generated.hpp',h
call writeFile outdir || '/rxbif_frame.ir.tsv',ir
say 'BIF compiled-frame rules:' entries~items '/ 2'
exit 0
failed:
  say 'BIF frame generator failed:' condition('O')~at('MESSAGE')
  exit 70
writeFile:
  use arg path, data
  s = stream(path,'C','OPEN WRITE REPLACE')
  if left(s,6) \== 'READY:' then raise syntax 40.900 array ('Cannot open:' path)
  call charout path,data
  call stream path,'C','CLOSE'
  return
::requires 'compiler/BifSourceReader.cls'
::requires 'frame/BifFrameRouteRule.cls'
