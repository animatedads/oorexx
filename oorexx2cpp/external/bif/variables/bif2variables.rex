/* ooRexx upstream-C++ reader -> verified variable BIF IR -> .cls / C++.
   Usage: cd PACKAGE; rexx variables/bif2variables.rex source.cpp outdir */
parse arg source outdir
if source == '' | outdir == '' then exit 64
signal on syntax name failed
signal on error name failed
signal on failure name failed
if stream(source,'C','QUERY EXISTS') == '' then exit 66
reader = .BifSourceReader~new
rule = .BifVariableRouteRule~new
seen = .directory~new
entries = .array~new
do d over reader~scan(source)
  n = d~name
  if wordpos(n,'SYMBOL VAR VALUE') == 0 then iterate
  if seen~hasIndex(n) then exit 65
  seen[n] = .true
  if rule~convert(d) \== .true then do
    say 'BIF source drift rejected:' n
    exit 3
  end
  entries~append(d)
end
do i = 1 to 3
  if \seen~hasIndex(word('SYMBOL VAR VALUE',i)) then do
    say 'Missing upstream BIF:' word('SYMBOL VAR VALUE',i)
    exit 3
  end
end
lf = '0a'x
tab = '09'x
h = '// Generated by ooRexx BifVariableRouteRule from upstream BUILTIN definitions.' || lf
h ||= '#pragma once' || lf || '#include "rxbif_variables.hpp"' || lf
h ||= 'namespace rxbif_variables_generated {' || lf
ir = 'name' || tab || 'min' || tab || 'max' || tab || 'source_line' || tab || 'routing' || lf
do d over entries
  n = d~name
  h ||= 'inline rx::Value BIF_' || n || '(rxbif_variables::VariableRouter& frame, const std::vector<rxbif_variables::Slot>& args) {' || lf
  h ||= '  return frame.invoke("' || n || '", args);' || lf || '}' || lf
  ir ||= n || tab || d~minArg || tab || d~maxArg || tab || d~line || tab || 'COMPILED_VARIABLE_SCOPE' || lf
  class = '/* Generated from verified upstream C++ BUILTIN by ooRexx. */' || lf
  class ||= '::class RxBifVariableRule_' || n || ' public' || lf
  class ||= '::method bifName class' || lf || "  return '" || n || "'" || lf
  class ||= '::method routeKind class' || lf || "  return 'COMPILED_VARIABLE_SCOPE'" || lf
  class ||= '::method argumentRange class' || lf || "  return '" || d~minArg || ' ' || d~maxArg || "'" || lf
  class ||= '::method sourceLine class' || lf || '  return ' || d~line || lf
  class ||= '::method emitCppExpression class' || lf
  class ||= '  use arg scopeName, arguments' || lf
  class ||= "  if scopeName == '' | arguments == '' then raise syntax 40.900 array ('Caller scope and argument expression required')" || lf
  class ||= "  return 'rxbif_variables_generated::BIF_" || n || "(' || scopeName || ', ' || arguments || ')'" || lf
  call writeFile outdir || '/Bif_' || n || '.cls',class
end
h ||= '} // namespace rxbif_variables_generated' || lf
call writeFile outdir || '/rxbif_variables_generated.hpp',h
call writeFile outdir || '/rxbif_variables.ir.tsv',ir
say 'BIF caller-variable rules:' entries~items '/ 3'
exit 0
failed:
  say 'BIF variable generator failed:' condition('O')~at('MESSAGE')
  exit 70
writeFile:
  use arg path, data
  s = stream(path,'C','OPEN WRITE REPLACE')
  if left(s,6) \== 'READY:' then raise syntax 40.900 array ('Cannot open:' path)
  call charout path,data
  call stream path,'C','CLOSE'
  return
::requires 'compiler/BifSourceReader.cls'
::requires 'variables/BifVariableRouteRule.cls'
