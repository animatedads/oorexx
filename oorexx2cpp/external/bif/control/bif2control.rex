/* ooRexx-written upstream C++ BUILTIN scanner -> control-state BIF rules.
   Usage (from package root): rexx control/bif2control.rex source.cpp outdir */
parse arg source outdir
if source == '' | outdir == '' then exit 64
signal on syntax name failed
signal on error name failed
signal on failure name failed
if stream(source,'C','QUERY EXISTS') == '' then exit 66
reader = .BifSourceReader~new
rule = .BifControlRouteRule~new
seen = .directory~new
entries = .array~new
do d over reader~scan(source)
  n = d~name
  if wordpos(n,'SOURCELINE TRACE CONDITION') == 0 then iterate
  if seen~hasIndex(n) then exit 65
  seen[n] = .true
  if rule~convert(d) \== .true then do
    say 'BIF control upstream source drift rejected:' n
    exit 3
  end
  entries~append(d)
end
do i = 1 to 3
  n = word('SOURCELINE TRACE CONDITION',i)
  if \seen~hasIndex(n) then do
    say 'Missing upstream BIF:' n
    exit 3
  end
end
lf='0a'x; tab='09'x
h='// Generated by ooRexx BifControlRouteRule, from upstream C++ BIF.' || lf
h ||= '#pragma once' || lf || '#include "rxbif_control.hpp"' || lf
h ||= 'namespace rxbif_control_generated {' || lf
ir='name' || tab || 'min' || tab || 'max' || tab || 'source_line' || tab || 'route' || lf
do d over entries
  n=d~name
  h ||= 'inline rx::Value BIF_' || n || '(rxbif_control::ControlRouter& frame, const std::vector<rxbif_control::Slot>& args) {' || lf
  h ||= '  return frame.invoke("' || n || '", args);' || lf || '}' || lf
  ir ||= n || tab || d~minArg || tab || d~maxArg || tab || d~line || tab || 'ORIGINAL_CONTROL_ACTIVATION' || lf
  class='/* Generated by ooRexx from source-verified upstream BUILTIN. */' || lf
  class ||= '::class RxBifControlRule_' || n || ' public' || lf
  class ||= '::method bifName class' || lf || "  return '" || n || "'" || lf
  class ||= '::method routeKind class' || lf || "  return 'ORIGINAL_CONTROL_ACTIVATION'" || lf
  class ||= '::method argumentRange class' || lf || "  return '" || d~minArg || ' ' || d~maxArg || "'" || lf
  class ||= '::method sourceLine class' || lf || '  return ' || d~line || lf
  class ||= '::method emitCppExpression class' || lf
  class ||= '  use arg scopeName, arguments' || lf
  class ||= "  if scopeName == '' | arguments == '' then raise syntax 40.900 array ('Control scope and arguments required')" || lf
  class ||= "  return 'rxbif_control_generated::BIF_" || n || "(' || scopeName || ', ' || arguments || ')'" || lf
  call writeFile outdir || '/Bif_' || n || '.cls',class
end
h ||= '} // namespace rxbif_control_generated' || lf
call writeFile outdir || '/rxbif_control_generated.hpp',h
call writeFile outdir || '/rxbif_control.ir.tsv',ir
say 'BIF control source-derived rules:' entries~items '/ 3'
exit 0
failed:
  say 'BIF control generator failed:' condition('O')~at('MESSAGE')
  exit 70
writeFile:
  use arg path,data
  s=stream(path,'C','OPEN WRITE REPLACE')
  if left(s,6) \== 'READY:' then raise syntax 40.900 array ('Cannot open:' path)
  call charout path,data
  call stream path,'C','CLOSE'
  return
::requires 'compiler/BifSourceReader.cls'
::requires 'control/BifControlRouteRule.cls'
