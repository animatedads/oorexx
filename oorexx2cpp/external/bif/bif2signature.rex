/* bif2signature.rex -- ooRexx. Reads the real interpreter/expression/BuiltinFunctions.cpp and extracts the argument signature of
   every BUILTIN(name): position, argument name, macro kind (string|integer|big_integer|pad|argument), required|optional.
   usage: rexx bif2signature.rex BuiltinFunctions.cpp tsv                      > catalog/bif_signatures.tsv
          rexx bif2signature.rex BuiltinFunctions.cpp hpp catalog/bif_omitted_defaults.tsv > native/rxbif_signatures_generated.hpp
   tsv columns: name pos arg kind need later   (later = 1 when a higher position exists: omissible in the MIDDLE of a call)
   The hpp carries the signature table plus the reviewed defaults used to resolve an omitted middle argument natively. */
parse arg src mode defaultsFile
mode = mode~translate
if src == '' | (mode \== 'TSV' & mode \== 'HPP') then do; say 'usage: bif2signature.rex BuiltinFunctions.cpp tsv|hpp [defaults.tsv]'; exit 64; end
lines = .stream~new(src)~arrayIn
rows = .array~new
current = ''
pos. = 0; count = 0
do l over lines
  t = l~strip
  if t~left(8) == 'BUILTIN(' then do
    call flush
    parse var t 'BUILTIN(' current ')' .
    count = 0; pos. = 0
    iterate
  end
  if t~left(13) == 'const size_t ' & t~pos('=') > 0 & current \== '' then do
    parse var t 'const size_t ' nm '=' val ';'
    nm = nm~strip; val = val~strip
    if nm~left(length(current)+1) == current'_' & datatype(val, 'W') then do
      a = nm~substr(length(current)+2)
      if a \== 'Min' & a \== 'Max' then pos.a = val
    end
  end
  p = t~pos('required_'); if p == 0 then p = t~pos('optional_')
  if p > 0 & current \== '' & t~pos('('||current||',') > 0 then do
    parse value t~substr(p) with kindfull '(' . ',' argn ')' .
    argn = argn~strip
    parse var kindfull need '_' kind
    count += 1
    if pos.argn == 0 then pos.argn = count   /* constants come from a header: use declaration order */
    row.count = current; rowPos.count = pos.argn; rowArg.count = argn; rowKind.count = kind; rowNeed.count = need
  end
end
call flush
if mode == 'TSV' then do
  say 'name'||'09'x||'pos'||'09'x||'arg'||'09'x||'kind'||'09'x||'need'||'09'x||'later'
  do r over rows; say r~makeString('L', '09'x); end
  exit 0
end
/* HPP */
say '// GENERATED by bif2signature.rex from the real BuiltinFunctions.cpp. Do not edit.'
say '#pragma once'
say 'namespace rxbif_sig {'
say 'struct Arg { const char* bif; int pos; const char* name; const char* kind; bool required; bool later; };'
say 'inline const Arg* signature(unsigned& n) {'
say '  static const Arg table[] = {'
do r over rows
  parse value r with b '09'x p '09'x a '09'x k '09'x nd '09'x lt
  say '    {"'b'",' p',"'a'","'k'",' (nd == 'required')~string~translate('truefalse', '10') ',' (lt == 1)~string~translate('truefalse', '10') '},'
end
say '  };'
say '  n = sizeof(table) / sizeof(table[0]); return table;'
say '}'
say 'struct Default { const char* bif; int pos; const char* rule; int a; int b; const char* lit; };'
say 'inline const Default* defaults(unsigned& n) {'
say '  static const Default table[] = {'
if defaultsFile \== '' then do d over .stream~new(defaultsFile)~arrayIn
  if d~strip == '' | d~strip~left(1) == '#' | d~left(4) == 'name' then iterate
  parse value d with b '09'x p '09'x rule '09'x args '09'x .
  a = 0; bb = 0; lit = ''
  select
    when rule == 'LEN'  then a = args
    when rule == 'REST' then parse var args a bb
    when rule == 'LIT'  then do; lit = args; if lit == '(empty)' then lit = ''; end
    otherwise do; say '#error unknown default rule' rule; exit 65; end
  end
  say '    {"'b'",' p',"'rule'",' a',' bb',"'lit'"},'
end
say '  };'
say '  n = sizeof(table) / sizeof(table[0]); return table;'
say '}'
say '}'
exit 0
flush:
  if current == '' then return
  max = 0
  do i = 1 to count; if rowPos.i > max then max = rowPos.i; end
  do i = 1 to count
    rows~append(row.i||'09'x||rowPos.i||'09'x||rowArg.i||'09'x||rowKind.i||'09'x||rowNeed.i||'09'x||(rowPos.i < max))
  end
  return
