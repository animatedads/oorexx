#!/usr/bin/env rexx
/* Random cases (the comparison) for RX4
   Written by SLAM (SlamTestWriter): Architecture: Tom Dyer.  Code: Claude (Opus 5.5).
   Unit under test: routine RX4 in native/fixtures/routine_many.cls
   Run: rexx RAND_RX4.testGroup (with ooTest.frm and framework/ on REXX_PATH) */
parse source . . sourceFile
group = .TestGroup~new(sourceFile)
group~add(.RAND_RX4.testGroup)
if group~isAutomatedTest then return group
testRun = group~suite~execute
testRun~print
return testRun

::requires 'ooTest.frm'
::class 'RAND_RX4.testGroup' public subclass ooTestCase

::method underTest
  file = value('SLAM_UNDER_TEST', , 'ENVIRONMENT')
  if file == '' then file = 'native/fixtures/routine_many.cls'
  return slamLift(file, 'RX4')

/* The error a call raises, read from its condition: code and message (expectSyntax reads the
   code only). */
::method errorOf
  signal on syntax name failed
  v = self~underTest~callWith(arg(1, 'A'))
  return 'NO ERROR'
failed:
  c = condition('O')
  return c['CODE'] c['MESSAGE']

/* Another condition a call raises (USER, NOTREADY ...): its name, description and additional. */
::method conditionOf
  signal on any name other
  v = self~underTest~callWith(arg(1, 'A'))
  return 'NO CONDITION'
other:
  c = condition('O')
  t = ''
  add = c['ADDITIONAL']
  if add \== .nil then do x over add; t = t || ',' || x~string; end
  return c['CONDITION'] c['DESCRIPTION'] '[' || t~substr(2) || ']'

/* RANDOM: random input
   observed: SLAM could not predict it */
::method test_001_random
  self~assertSame('--a50eb 1-5c64hc1__f0', self~underTest~call('', '', 'a50eb 1', '5c64hc1__f0'))

/* RANDOM: random input
   observed: SLAM could not predict it */
::method test_002_random
  self~assertSame('-6h5-2bf--99bd5c49_', self~underTest~call('-6h5', '2bf', '', '99bd5c49_'))

/* RANDOM: random input
   observed: SLAM could not predict it */
::method test_003_random
  self~assertSame('8 -6bf -a9-068ad ', self~underTest~call('8 ', '6bf ', 'a9', '068ad '))

