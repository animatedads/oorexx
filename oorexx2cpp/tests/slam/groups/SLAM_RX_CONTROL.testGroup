#!/usr/bin/env rexx
/* SLAM-chosen cases for RX_CONTROL
   Written by SLAM (SlamTestWriter): Architecture: Tom Dyer.  Code: Claude (Opus 5.5).
   Unit under test: routine RX_CONTROL in native/fixtures/routine_control.cls
   Run: rexx SLAM_RX_CONTROL.testGroup (with ooTest.frm and framework/ on REXX_PATH) */
parse source . . sourceFile
group = .TestGroup~new(sourceFile)
group~add(.SLAM_RX_CONTROL.testGroup)
if group~isAutomatedTest then return group
testRun = group~suite~execute
testRun~print
return testRun

::requires 'ooTest.frm'
::class 'SLAM_RX_CONTROL.testGroup' public subclass ooTestCase

::method underTest
  file = value('SLAM_UNDER_TEST', , 'ENVIRONMENT')
  if file == '' then file = 'native/fixtures/routine_control.cls'
  return slamLift(file, 'RX_CONTROL')

/* The error a call raises, read from its condition: code and message (expectSyntax reads the
   code only). */
::method errorOf
  signal on syntax name failed
  v = self~underTest~callWith(arg(1, 'A'))
  return 'NO ERROR'
failed:
  c = condition('O')
  return c['CODE'] c['MESSAGE']

/* Another condition a call raises (USER, NOTREADY ...): its name, description and additional. */
::method conditionOf
  signal on any name other
  v = self~underTest~callWith(arg(1, 'A'))
  return 'NO CONDITION'
other:
  c = condition('O')
  t = ''
  add = c['ADDITIONAL']
  if add \== .nil then do x over add; t = t || ',' || x~string; end
  return c['CONDITION'] c['DESCRIPTION'] '[' || t~substr(2) || ']'

/* HAPPY: every rule holds
   observed: SLAM could not predict it */
::method test_001_happy
  self~assertSame('2', self~underTest~call('2', '7'))

/* BOUNDARY: NE V N:1   [A] at 0                   
   observed: SLAM could not predict it */
::method test_002_boundary
  self~assertSame('7', self~underTest~call('0', '7'))

/* BOUNDARY: NE V N:1   [A] at 1                   
   predicted by SLAM before running: VALUE 99 */
::method test_003_boundary
  self~assertSame('99', self~underTest~call('1', '7'))

/* NUMBER: a number the unit uses, as a
   observed: SLAM could not predict it */
::method test_004_number
  self~assertSame('7', self~underTest~call('20', '7'))

/* NUMBER: a number the unit uses, as a
   observed: SLAM could not predict it */
::method test_005_number
  self~assertSame('7', self~underTest~call('99', '7'))

