#!/usr/bin/env rexx
/* SLAM-chosen cases for R2
   Written by SLAM (SlamTestWriter): Architecture: Tom Dyer.  Code: Claude (Opus 5.5).
   Unit under test: routine R2 in native/fixtures/use_arg.cls
   Run: rexx SLAM_R2.testGroup (with ooTest.frm and framework/ on REXX_PATH) */
parse source . . sourceFile
group = .TestGroup~new(sourceFile)
group~add(.SLAM_R2.testGroup)
if group~isAutomatedTest then return group
testRun = group~suite~execute
testRun~print
return testRun

::requires 'ooTest.frm'
::class 'SLAM_R2.testGroup' public subclass ooTestCase

::method underTest
  file = value('SLAM_UNDER_TEST', , 'ENVIRONMENT')
  if file == '' then file = 'native/fixtures/use_arg.cls'
  return slamLift(file, 'R2')

/* The error a call raises, read from its condition: code and message (expectSyntax reads the
   code only). */
::method errorOf
  signal on syntax name failed
  v = self~underTest~callWith(arg(1, 'A'))
  return 'NO ERROR'
failed:
  c = condition('O')
  return c['CODE'] c['MESSAGE']

/* Another condition a call raises (USER, NOTREADY ...): its name, description and additional. */
::method conditionOf
  signal on any name other
  v = self~underTest~callWith(arg(1, 'A'))
  return 'NO CONDITION'
other:
  c = condition('O')
  t = ''
  add = c['ADDITIONAL']
  if add \== .nil then do x over add; t = t || ',' || x~string; end
  return c['CONDITION'] c['DESCRIPTION'] '[' || t~substr(2) || ']'

/* HAPPY: every rule holds
   observed: SLAM could not predict it */
::method test_001_happy
  self~assertSame('abc', self~underTest~call('abc'))

/* OMIT: argument n left out
   observed: SLAM could not predict it */
::method test_002_omit
  self~assertSame('40.3 Not enough arguments in invocation of R2; minimum expected is 1.', self~errorOf())

/* The unit, lifted from its file as SLAM lifts a standalone unit: the lines after its
   ::routine directive (or its class's ::method directive), up to the next directive, then the
   file's ::OPTIONS directives. */
::routine slamLift
  use strict arg file, name, owner = ''
  lines = .array~new
  call stream file, 'C', 'OPEN READ'
  do while lines(file) > 0; lines~append(linein(file)); end
  call stream file, 'C', 'CLOSE'
  body = .array~new
  inside = .false
  done = .false
  cls = ''
  opts = .array~new
  do ln over lines
    s = ln~strip
    if s~left(9)~upper == '::OPTIONS' then opts~append(s)
    if done then iterate
    if s~left(2) == '::' then do
      if inside then do
        done = .true
        iterate
      end
      parse upper value s with d nm rest
      nm = nm~strip('B', ';')~strip('B', "'")~strip('B', '"')
      if d == '::CLASS' then cls = nm
      if owner == '' then do
        if d == '::ROUTINE' then if nm == name~upper then inside = .true
      end
      else if d == '::METHOD' then if nm == name~upper then if cls == owner~upper then inside = .true
      if inside then do
        semi = s~pos(';')
        if semi > 0 then body~append(s~substr(semi + 1))
      end
      iterate
    end
    if inside then body~append(ln)
  end
  do o over opts; body~append(o); end   /* the file's ::OPTIONS (digits, form, fuzz): its settings */
  body~insert("address 'SLAMNOCMD'", .nil)   /* a command goes nowhere, not to the shell */
  return .Routine~new(name, body)
