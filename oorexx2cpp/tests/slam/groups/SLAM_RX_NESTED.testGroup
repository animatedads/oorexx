/* KIND: argument n is used as a number: given a word
   observed: SLAM could not predict it */
::method test_012_kind
  self~assertSame('41.1 Nonnumeric value ("abc") used in arithmetic operation.', self~errorOf('abc'))

/* FRACTION: a number that is not whole, as n
   observed: SLAM could not predict it */
::method test_013_fraction
  self~assertSame('0', self~underTest~call('0.5'))

/* FRACTION: a number that is not whole, as n
   observed: SLAM could not predict it */
::method test_014_fraction
  self~assertSame('17', self~underTest~call('-2.5'))

/* OMIT: argument n left out
   observed: SLAM could not predict it */
::method test_015_omit
  self~assertSame('41.1 Nonnumeric value ("N") used in arithmetic operation.', self~errorOf())

/* The unit, lifted from its file as SLAM lifts a standalone unit: the lines after its
   ::routine directive (or its class's ::method directive), up to the next directive, then the
   file's ::OPTIONS directives. */
::routine slamLift
  use strict arg file, name, owner = ''
  lines = .array~new
  call stream file, 'C', 'OPEN READ'
  do while lines(file) > 0; lines~append(linein(file)); end
  call stream file, 'C', 'CLOSE'
  body = .array~new
  inside = .false
  done = .false
  cls = ''
  opts = .array~new
  do ln over lines
    s = ln~strip
    if s~left(9)~upper == '::OPTIONS' then opts~append(s)
    if done then iterate
    if s~left(2) == '::' then do
      if inside then do
        done = .true
        iterate
      end
      parse upper value s with d nm rest
      nm = nm~strip('B', ';')~strip('B', "'")~strip('B', '"')
      if d == '::CLASS' then cls = nm
      if owner == '' then do
        if d == '::ROUTINE' then if nm == name~upper then inside = .true
      end
      else if d == '::METHOD' then if nm == name~upper then if cls == owner~upper then inside = .true
      if inside then do
        semi = s~pos(';')
        if semi > 0 then body~append(s~substr(semi + 1))
      end
      iterate
    end
    if inside then body~append(ln)
  end
  do o over opts; body~append(o); end   /* the file's ::OPTIONS (digits, form, fuzz): its settings */
  body~insert("address 'SLAMNOCMD'", .nil)   /* a command goes nowhere, not to the shell */
  return .Routine~new(name, body)
