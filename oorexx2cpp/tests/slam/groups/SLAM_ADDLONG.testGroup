/* KIND: argument leftside is used as a number: given a word
   observed: SLAM could not predict it */
::method test_020_kind
  self~assertSame('41.1 Nonnumeric value ("abc") used in arithmetic operation.', self~errorOf('abc', '7'))

/* KIND: argument rightside is used as a number: given a word
   observed: SLAM could not predict it */
::method test_021_kind
