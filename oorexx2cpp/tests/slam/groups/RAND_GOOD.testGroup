#!/usr/bin/env rexx
/* Random cases (the comparison) for GOOD
   Written by SLAM (SlamTestWriter): Architecture: Tom Dyer.  Code: Claude (Opus 5.5).
   Unit under test: routine GOOD in native/fixtures/program_constructs/routine_call.rex
   Run: rexx RAND_GOOD.testGroup (with ooTest.frm and framework/ on REXX_PATH) */
parse source . . sourceFile
group = .TestGroup~new(sourceFile)
group~add(.RAND_GOOD.testGroup)
if group~isAutomatedTest then return group
testRun = group~suite~execute
testRun~print
return testRun

::requires 'ooTest.frm'
::class 'RAND_GOOD.testGroup' public subclass ooTestCase

::method underTest
  file = value('SLAM_UNDER_TEST', , 'ENVIRONMENT')
  if file == '' then file = 'native/fixtures/program_constructs/routine_call.rex'
  return slamLift(file, 'GOOD')

/* The error a call raises, read from its condition: code and message (expectSyntax reads the
   code only). */
::method errorOf
  signal on syntax name failed
  v = self~underTest~callWith(arg(1, 'A'))
  return 'NO ERROR'
failed:
  c = condition('O')
  return c['CODE'] c['MESSAGE']

/* Another condition a call raises (USER, NOTREADY ...): its name, description and additional. */
::method conditionOf
  signal on any name other
  v = self~underTest~callWith(arg(1, 'A'))
  return 'NO CONDITION'
other:
  c = condition('O')
  t = ''
  add = c['ADDITIONAL']
  if add \== .nil then do x over add; t = t || ',' || x~string; end
  return c['CONDITION'] c['DESCRIPTION'] '[' || t~substr(2) || ']'

/* RANDOM: random input
   observed: SLAM could not predict it */
::method test_001_random
  self~assertSame(' 1 a50eb 1 3', self~underTest~call('', '', 'a50eb 1'))

/* RANDOM: random input
   observed: SLAM could not predict it */
::method test_002_random
  self~assertSame('5c64hc1__f0 1 2bf 3', self~underTest~call('5c64hc1__f0', '-6h5', '2bf'))

/* RANDOM: random input
   observed: SLAM could not predict it */
::method test_003_random
  self~assertSame(' 1 8  3', self~underTest~call('', '99bd5c49_', '8 '))

/* RANDOM: random input
   observed: SLAM could not predict it */
::method test_004_random
  self~assertSame('6bf  1 068ad  3', self~underTest~call('6bf ', 'a9', '068ad '))

/* RANDOM: random input
   observed: SLAM could not predict it */
::method test_005_random
  self~assertSame('a  1 6eg1e1j_i 2 3', self~underTest~call('a ', 'g', '6eg1e1j_i 2'))

/* RANDOM: random input
   observed: SLAM could not predict it */
::method test_006_random
  self~assertSame('54-jagh5_ 1 2 3', self~underTest~call('54-jagh5_', '-639hf4ijg6f', '2'))

/* RANDOM: random input
   observed: SLAM could not predict it */
::method test_007_random
  self~assertSame('2feijfi1_ 1 4h8 2-182d 3', self~underTest~call('2feijfi1_', ' _ 86-', '4h8 2-182d'))

/* The unit, lifted from its file as SLAM lifts a standalone unit: the lines after its
   ::routine directive (or its class's ::method directive), up to the next directive, then the
   file's ::OPTIONS directives. */
::routine slamLift
  use strict arg file, name, owner = ''
  lines = .array~new
  call stream file, 'C', 'OPEN READ'
  do while lines(file) > 0; lines~append(linein(file)); end
  call stream file, 'C', 'CLOSE'
  body = .array~new
  inside = .false
  done = .false
  cls = ''
  opts = .array~new
  do ln over lines
    s = ln~strip
    if s~left(9)~upper == '::OPTIONS' then opts~append(s)
    if done then iterate
    if s~left(2) == '::' then do
      if inside then do
        done = .true
        iterate
      end
      parse upper value s with d nm rest
      nm = nm~strip('B', ';')~strip('B', "'")~strip('B', '"')
      if d == '::CLASS' then cls = nm
      if owner == '' then do
        if d == '::ROUTINE' then if nm == name~upper then inside = .true
      end
      else if d == '::METHOD' then if nm == name~upper then if cls == owner~upper then inside = .true
      if inside then do
        semi = s~pos(';')
        if semi > 0 then body~append(s~substr(semi + 1))
      end
      iterate
    end
    if inside then body~append(ln)
  end
  do o over opts; body~append(o); end   /* the file's ::OPTIONS (digits, form, fuzz): its settings */
  body~insert("address 'SLAMNOCMD'", .nil)   /* a command goes nowhere, not to the shell */
  return .Routine~new(name, body)
