#!/usr/bin/env rexx
/* SLAM-chosen cases for PRECISION
   Written by SLAM (SlamTestWriter): Architecture: Tom Dyer.  Code: Claude (Opus 5.5).
   Unit under test: routine PRECISION in native/fixtures/routine_external.cls
   Run: rexx SLAM_PRECISION.testGroup (with ooTest.frm and framework/ on REXX_PATH) */
parse source . . sourceFile
group = .TestGroup~new(sourceFile)
group~add(.SLAM_PRECISION.testGroup)
if group~isAutomatedTest then return group
testRun = group~suite~execute
testRun~print
return testRun

::requires 'ooTest.frm'
::class 'SLAM_PRECISION.testGroup' public subclass ooTestCase

::method underTest
  file = value('SLAM_UNDER_TEST', , 'ENVIRONMENT')
  if file == '' then file = 'native/fixtures/routine_external.cls'
  return slamLift(file, 'PRECISION')

/* The error a call raises, read from its condition: code and message (expectSyntax reads the
   code only). */
::method errorOf
  signal on syntax name failed
  v = self~underTest~callWith(arg(1, 'A'))
  return 'NO ERROR'
failed:
  c = condition('O')
  return c['CODE'] c['MESSAGE']

/* Another condition a call raises (USER, NOTREADY ...): its name, description and additional. */
::method conditionOf
  signal on any name other
  v = self~underTest~callWith(arg(1, 'A'))
  return 'NO CONDITION'
other:
  c = condition('O')
  t = ''
  add = c['ADDITIONAL']
  if add \== .nil then do x over add; t = t || ',' || x~string; end
  return c['CONDITION'] c['DESCRIPTION'] '[' || t~substr(2) || ']'

/* HAPPY: every rule holds
   observed: SLAM could not predict it */
::method test_001_happy
  self~assertSame('1', self~underTest~call('7', '7'))

/* NUMBER: a number the unit uses, as a
   observed: SLAM could not predict it */
::method test_002_number
  self~assertSame('4.5714285714285714285714285714286', self~underTest~call('32', '7'))

/* EDGE: a machine-width edge, as a
   observed: SLAM could not predict it */
::method test_003_edge
