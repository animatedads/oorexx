::method beginExecution unguarded

    dlgData. = self~dlgData

    if \ self~isManaged then do
        if \ self~startIt then do
            self~finished = .true
            self~stopIt
            return 0
        end
    end

    if self~useStem then self~setDataStem(dlgData.)
