/* oodgen.rex -- generate the ooDialog/WASM class file from upstream ooDialog.
 *
 * Architecture: Tom Dyer.  Code: Claude (Fable 5.2).
 *
 * Reads the upstream ooDialog *.cls sources (unchanged) and writes one
 * ooDialog.cls in which every method, attribute and routine that upstream
 * implements in the Windows DLL ('external "LIBRARY oodialog fn"') is
 * redirected to the message "fn" of .oodn, the native layer replacement in
 * oodWeb.cls.  Nothing else of upstream's Rexx is changed, except:
 *   - 'private' is removed from directives (the native layer is another
 *     object and must be able to send these messages);
 *   - every class gets an 'oodPeer' attribute (the native layer's state for
 *     the object, what CSELF is to the DLL);
 *   - the replacements and drops listed in the patch file.
 *
 * usage: rexx oodgen.rex upstreamDir patchFile outDir
 * Progress is written line by line on standard output.
 */
parse arg upstreamDir patchFile outDir .
if outDir == "" then do
  say "usage: rexx oodgen.rex upstreamDir patchFile outDir"
  return 2
end

gen = .OodGenerator~new(upstreamDir, patchFile, outDir)
return gen~run

::class OodGenerator
::method module_version class
  return "0.1.0"
::method module_lastChanged class
  return "2026-11-14"
::method module_version
  return self~class~module_version
::method module_lastChanged
  return self~class~module_lastChanged

::method init
  expose upstreamDir patchFile outDir natives patches drops counts usedPatches
  use arg upstreamDir, patchFile, outDir
  natives = .set~new
  patches = .directory~new
  drops = .set~new
  usedPatches = .set~new
  counts = .directory~new
  counts~natives = 0
  counts~privates = 0
  counts~classes = 0
  counts~replaced = 0
  counts~dropped = 0
  counts~files = 0

::method log
  use arg text
  say "oodgen:" text

/* The order upstream's own build uses; UtilityClasses.cls first. */
::method sourceFiles
  return .array~of("UtilityClasses.cls", "AnimatedButton.cls", "BaseDialog.cls", "ControlDialog.cls", -
                   "DialogControls.cls", "ListView.cls", "ReBar.cls", "StatusBar.cls", -
                   "TreeView.cls", "ToolBar.cls", "ToolTip.cls", "DialogExtensions.cls", -
                   "DynamicDialog.cls", "EventNotification.cls", "PlainBaseDialog.cls", "RcDialog.cls", -
                   "Menu.cls", "ResDialog.cls", "UserDialog.cls", "DeprecatedClasses.cls", -
                   "ShellObjects.cls")

::method run
  expose upstreamDir outDir natives counts patches usedPatches
  self~loadPatches
  out = .stream~new(outDir"/ooDialog.cls")
  if out~open("WRITE REPLACE") \== "READY:" then do
    self~log("cannot write" outDir"/ooDialog.cls")
    return 9
  end
  out~lineout("/* ooDialog.cls for ooRexx/WASM -- GENERATED by oodgen.rex, do not edit.")
  out~lineout(" * Source: upstream ooDialog trunk (SourceForge oorexx code-0 r13513), CPL 1.0,")
  out~lineout(" * Copyright (c) 1995, 2004 IBM Corporation; (c) 2005-2026 Rexx Language Association.")
  out~lineout(" * Native layer redirected to .oodn (oodWeb.cls).  Generator" self~module_version".")
  out~lineout(" * Architecture: Tom Dyer.  Generator and native layer: Claude (Fable 5.2). */")
  out~lineout("")
  out~lineout("::requires 'ooShapes.cls'")
  out~lineout("::requires 'oodWeb.cls'")
  out~lineout("")
  do name over self~sourceFiles
    self~log("reading" name)
    self~processFile(upstreamDir"/"name, out)
  end
  out~close

  list = .stream~new(outDir"/natives.txt")
  list~open("WRITE REPLACE")
  sorted = natives~makeArray~sort
  do fn over sorted
    list~lineout(fn)
  end
  list~close

  do key over patches~allIndexes
    if \usedPatches~hasIndex(key) then self~log("WARNING patch not applied:" key)
  end
  summary = "classes" counts~classes", native redirections" counts~natives "("natives~items "entry points)"
  summary = summary", file access lines" counts~files", private removed" counts~privates", replaced" counts~replaced", dropped" counts~dropped
  self~log(summary)
  return 0

/* Patch file: blocks introduced by  --@replace Class member  or
 * --@drop Class member ; a replace block's text runs to the next --@ line. */
::method loadPatches
  expose patchFile patches drops
  in = .stream~new(patchFile)
  if in~open("READ") \== "READY:" then do
    self~log("no patch file" patchFile)
    return
  end
  key = ""
  body = .nil
  do while in~lines > 0
    line = in~linein
    if line~left(3) == "--@" then do
      parse var line "--@" verb cls member .
      key = cls~upper"."member~upper
      if verb~upper == "DROP" then do
        drops~put(key)
        body = .nil
      end
      else do
        body = .array~new
        patches[key] = body
      end
      iterate
    end
    if body \== .nil then body~append(line)
  end
  in~close
  self~log("patches:" patches~items "replace," drops~items "drop")

::method processFile
  expose natives counts patches drops usedPatches
  use arg path, out
  in = .stream~new(path)
  if in~open("READ") \== "READY:" then do
    self~log("cannot read" path)
    raise syntax 98.900 array("oodgen: cannot read" path)
  end
  do 35                              -- the licence header, as upstream's build skips it
    if in~lines > 0 then in~linein
  end
  out~lineout("")
  out~lineout("-- ======== upstream" filespec("NAME", path) "========")
  currentClass = ""
  skipping = .false                  -- inside a member that a patch replaced or dropped
  depth = 0                          -- block comment nesting at the start of the line
  do while in~lines > 0
    line = in~linein
    startDepth = depth
    depth = depth + line~countStr("/*") - line~countStr("*/")
    if depth < 0 then depth = 0
    if startDepth > 0 | line~strip~left(2) == "/*" then do
      out~lineout(line)              -- comment text: as it is
      iterate
    end
    code = self~codePart(line)
    first = code~word(1)~lower
    isDirective = (first~left(2) == "::")
    if isDirective then skipping = .false
    if skipping then iterate

    if first == "::class" then do
      currentClass = self~unquote(code~word(2))~upper
      counts~classes = counts~classes + 1
      out~lineout(line)
      out~lineout("::attribute oodPeer unguarded")
      iterate
    end

    if first == "::method" | first == "::attribute" then do
      member = self~unquote(code~word(2))~upper
      key = currentClass"."member
      if drops~hasIndex(key) then do
        skipping = .true
        counts~dropped = counts~dropped + 1
        usedPatches~put(key)
        iterate
      end
      if patches~hasIndex(key) then do
        skipping = .true
        if \usedPatches~hasIndex(key) then do
          do pl over patches[key]
            out~lineout(pl)
          end
          counts~replaced = counts~replaced + 1
          usedPatches~put(key)
        end
        iterate
      end
    end

    code = code~space
    p = code~caselessPos('external "LIBRARY oodialog ')
    if isDirective, p > 0 then do
      parse var code . 'oodialog ' fn '"' .
      fn = fn~strip
      natives~put(fn)
      counts~natives = counts~natives + 1
      head = code~left(p - 1)~strip
      self~emitNative(out, first, head, fn)
      iterate
    end

    if \isDirective then do            -- file names: Windows paths become paths of this file system
      before = line
      line = line~changeStr('.stream~new(', '.oodn~stream(')
      line = line~caselessChangeStr('SysIsFile(', '.oodn~isFile(')
      line = line~caselessChangeStr('SysSearchPath(', '.oodn~searchPath(')
      if line \== before then counts~files = counts~files + 1
    end
    if first == "::method" | first == "::attribute" then do
      w = code~caselessWordPos("private")
      if w > 2 then do
        counts~privates = counts~privates + 1
        line = code~delWord(w, 1)
      end
    end
    out~lineout(line)
  end
  in~close

/* The text of a line before a line comment. */
::method codePart
  use arg line
  p = line~pos("--")
  if p == 0 then return line
  return line~left(p - 1)

::method unquote
  use arg name
  return name~strip("B", '"')~strip("B", "'")

::method emitNative
  expose counts
  use arg out, kind, head, fn
  name = head~word(2)
  flags = head~subWord(3)
  w = flags~caselessWordPos("private")
  if w > 0 then do
    flags = flags~delWord(w, 1)
    counts~privates = counts~privates + 1
  end
  bare = self~unquote(name)
  msg = bare~upper
  select
    when kind == "::routine" & fn == "locate_rtn" then do
      -- the directory of the program that calls locate(): the caller's frame
      out~lineout("::routine" name flags)
      out~lineout('  frames = .context~stackFrames')
      out~lineout('  program = ""')
      out~lineout('  if frames~items >= 2 then program = frames[2]~executable~package~name')
      out~lineout('  return .oodn~locate(program)')
    end
    when kind == "::routine" then do
      out~lineout("::routine" name flags)
      out~lineout('  .oodn~'fn'(.nil, "'msg'", arg(1, "A"))')
      out~lineout('  if var("RESULT") then return result')
      out~lineout('  return')
    end
    when kind == "::attribute" then do
      w = flags~caselessWordPos("set")
      g = flags~caselessWordPos("get")
      if w > 0 then do
        flags = flags~delWord(w, 1)
        msg = msg"="
        out~lineout('::method "'bare'="' flags)
      end
      else do
        if g > 0 then flags = flags~delWord(g, 1)
        out~lineout('::method' name flags)
      end
      out~lineout('  forward to (.oodn) message "'fn'" arguments (.array~of(self, "'msg'", arg(1, "A")))')
    end
    otherwise do
      out~lineout('::method' name flags)
      out~lineout('  forward to (.oodn) message "'fn'" arguments (.array~of(self, "'msg'", arg(1, "A")))')
    end
  end
