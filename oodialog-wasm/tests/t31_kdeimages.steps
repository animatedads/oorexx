wait .ood-dlg >> text=set
expect (() => { const all = [...document.querySelectorAll('.ood-dlg *')].filter(e => getComputedStyle(e).backgroundImage.includes('image/svg') || (e.tagName === 'IMG' && e.src.includes('image/svg'))); return all.length; })() ==> 2
expect (() => { const e = [...document.querySelectorAll('.ood-dlg *')].find(e => getComputedStyle(e).backgroundImage.includes('image/svg') || (e.tagName === 'IMG' && e.src.includes('image/svg'))); const u = e.tagName === 'IMG' ? e.src : getComputedStyle(e).backgroundImage; return atob(u.split('base64,')[1].replace(/"\)$/, '')).includes('<svg'); })() ==> True
