wait .ood-rb >> text=Tools
expect (() => { const b = document.querySelector('.ood-rb').getBoundingClientRect(), c = document.querySelector('.ood-dlg .ood-client').getBoundingClientRect(); return Math.abs(b.top - c.top) <= 1 && Math.abs(b.left - c.left) <= 1 && Math.abs(b.right - c.right) <= 1; })() ==> True
expect [...document.querySelectorAll('.ood-rbband')].map(b => (b.querySelector('.ood-rbtext') || {}).textContent + ':' + (b.querySelector('.ood-tb') ? 'toolbar' : b.querySelector('select') ? 'combo' : b.querySelector('input') ? 'edit' : '?') + ':' + (b.querySelector('.ood-rbgrip') ? 'grip' : 'nogrip')).join(' ') ==> Tools:toolbar:grip Pick:combo:nogrip Address:edit:grip
expect (() => { const b = [...document.querySelectorAll('.ood-rbband')].map(x => x.getBoundingClientRect()); return Math.round(b[1].width) === 140 && b[2].top >= b[0].bottom - 1 && Math.abs(b[2].width - document.querySelector('.ood-rb').getBoundingClientRect().width) <= 2; })() ==> True
expect getComputedStyle(document.querySelector('.ood-rb')).backgroundColor + ' ' + getComputedStyle(document.querySelector('.ood-rb')).color ==> rgb(220, 230, 250) rgb(0, 0, 128)
click .ood-rb >> text=New
sleep 300
expect document.querySelector('.ood-dlg .ood-static').textContent ==> New pressed in the re-bar
select .ood-rb select => two
expect document.querySelector(".ood-rb select").value !== "" ==> True
shot rebar
click .ood-dlg >> text=Change
sleep 500
expect [...document.querySelectorAll('.ood-rbband')].map(b => (b.querySelector('.ood-rbtext') || {}).textContent + ':' + Math.round(b.getBoundingClientRect().width)).slice(0, 1).join(' ') ==> Choose:180
expect document.querySelectorAll('.ood-rbband').length + ' ' + (document.querySelector('.ood-rb input') === null) ==> 2 true
click .ood-dlg >> text=Close
