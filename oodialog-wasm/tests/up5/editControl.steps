expect (() => { const e = document.querySelector('.ood-dlg .ood-edit'); const r = e.getBoundingClientRect(), td = document.querySelectorAll('.ood-lv tbody tr')[1].children[1].getBoundingClientRect(); return !e.hidden && Math.abs(r.left - td.left) < 3 && Math.abs(r.top - td.top) < 3 && Math.abs(r.width - td.width) < 4 && (document.activeElement === e || e.contains(document.activeElement)); })() ==> True
