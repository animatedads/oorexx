wait .ood-dlg >> text=Rectangles
sleep 500
eval (() => { const b = [...document.querySelectorAll('.ood-dlg button.ood-c')].find(x => x.textContent.trim() === 'Rectangles'); if (b.disabled) return 'disabled'; b.click(); return 'clicked Rectangles'; })()
sleep 3200
expect (() => { const cv = [...document.querySelectorAll('canvas.ood-gdi')].sort((a,b)=>b.width*b.height-a.width*a.height)[0]; if (!cv) return 'no canvas'; const d = cv.getContext('2d').getImageData(0, 0, cv.width, cv.height).data; let n = 0; for (let i = 3; i < d.length; i += 4) if (d[i]) n++; return n > 500; })() ==> True
expect (window.oodOut.join('').match(/(native function \w+|Error \d+\.\d+[^\n]*)/g)||[]).length ==> 0
eval (() => { const b = [...document.querySelectorAll('.ood-dlg button.ood-c')].find(x => x.textContent.trim() === 'Interrupt'); b.click(); return 'interrupt ' + b.disabled; })()
sleep 1500
