/* make.rex -- the designer programs for a renderer other than the page (Qt6 on Linux)
   Architecture: Tom Dyer.  Code: Claude (Opus 5.5).
   usage (from the designer's folder): rexx tests/qt/make.rex
   Writes NewKinds.rex and Resizer.rex next to this file, generated by this
   designer's OodDesign, so a renderer's contract test runs what the designer
   writes today (tests/gen is from designer 0.3.0).  Their .steps (the Qt
   player's dialect) and .expect are written by hand, from what the events
   must say, not from a run. */
parse source . . me
here = .File~new(me)~parent || .File~separator

-- 1. NewKinds: up-down with its buddy, month calendar, track bar DRAG and ENDTRACK, a tool tip
d = .OodDesign~new("NewKinds")
d~setProp("form", "w", 240); d~setProp("form", "h", 170)
e = d~addControl("EDIT", 10, 10);  d~setProp(e, "name", "txtCount")
d~setProp("txtCount", "tip", "How many, 1 to 9")
u = d~addControl("UPDOWN", 92, 10)
d~setProp(u, "min", 1); d~setProp(u, "max", 9); d~setProp(u, "pos", 3)
d~setEventCode(u, "DELTAPOS", "use arg pos, delta" || "0a"x || 'say "deltapos" pos delta')
t = d~addControl("TRACKBAR", 120, 10); d~setProp(t, "name", "trkLevel")
d~setEventCode("trkLevel", "DRAG", "use arg info" || "0a"x || 'say "drag" .DlgUtil~hiWord(info)')
d~setEventCode("trkLevel", "ENDTRACK", 'say "endtrack" self~trkLevel~pos')
c = d~addControl("MONTHCALENDAR", 10, 34); d~setProp(c, "name", "calDay")
d~setEventCode("calDay", "SELECT", "use arg startDate" || "0a"x || 'say "select" startDate~day')
b = d~addControl("PUSHBUTTON", 180, 145); d~setProp(b, "text", "OK"); d~setProp(b, "role", "OK")
call writeFile here || "NewKinds.rex", d~generate

-- 2. Resizer: a resizable form; the program measures its own controls
r = .OodDesign~new("Resizer")
r~setProp("form", "w", 200); r~setProp("form", "h", 120); r~setProp("form", "resizable", 1)
l = r~addControl("LISTBOX", 6, 6); r~setProp(l, "name", "lstItems"); r~setProp("lstItems", "w", 120); r~setProp("lstItems", "h", 80)
r~setProp("lstItems", "anchor", "LEFT TOP RIGHT BOTTOM")
m = r~addControl("PUSHBUTTON", 140, 6); r~setProp(m, "name", "btnMeasure"); r~setProp("btnMeasure", "text", "Measure")
r~setProp("btnMeasure", "anchor", "RIGHT TOP")
o = r~addControl("PUSHBUTTON", 140, 100); r~setProp(o, "name", "btnOK"); r~setProp("btnOK", "text", "OK"); r~setProp("btnOK", "role", "OK")
r~setProp("btnOK", "anchor", "RIGHT BOTTOM")
r~setVar("first", ".nil")
code = "s = self~lstItems~getRealSize; p = self~btnOK~windowRect" || "0a"x ||,
       "now = s~width s~height p~left p~top" || "0a"x ||,
       "if self~first == .nil then do" || "0a"x ||,
       "  self~first = now" || "0a"x ||,
       '  say "measured"' || "0a"x ||,
       "  return" || "0a"x ||,
       "end" || "0a"x ||,
       'f = self~first' || "0a"x ||,
       'say "list grew" (now~word(1) - f~word(1)) (now~word(2) - f~word(2))' || "0a"x ||,
       'say "OK moved" (now~word(3) - f~word(3)) (now~word(4) - f~word(4))'
r~setEventCode("btnMeasure", "CLICKED", code)
call writeFile here || "Resizer.rex", r~generate
-- 3. Catcher: CATCH and FINALLY in event code, behind the program's guard
-- (it asks its ooRexx by compiling a lone clause; it runs only where they are known)
k = .OodDesign~new("Catcher")
g = k~addControl("PUSHBUTTON", 10, 10); k~setProp(g, "name", "btnGo"); k~setProp("btnGo", "text", "Go")
k~setEventCode("btnGo", "CLICKED", "do" || "0a"x || '  x = 1 + "a"' || "0a"x || '  say "not here"' || "0a"x ||,
  "catch co = syntax" || "0a"x || '  say "caught" co~code' || "0a"x || "finally" || "0a"x || '  say "finally"' || "0a"x || "end")
q = k~addControl("PUSHBUTTON", 60, 10); k~setProp(q, "text", "OK"); k~setProp(q, "role", "OK")
call writeFile here || "Catcher.rex", k~generate

say "make: NewKinds.rex, Resizer.rex and Catcher.rex written by the ooDialog Designer" .OodDesign~module_version
return 0

writeFile: procedure
  use strict arg path, text
  call SysFileDelete path
  s = .Stream~new(path); s~open("WRITE REPLACE"); s~charOut(text); s~close
  return

::requires "OodDesigner.cls"
